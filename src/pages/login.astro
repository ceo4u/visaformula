---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
import { LoginPortal } from '../components/interactive/LoginPortal';
---

<Layout 
  title="Sign In to VisaFormula" 
  description="Sign in to your VisaFormula visa consultation account. Complete your application filing, check upcoming session schedules, and upload passport document scans."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Mount client-only React login portal island -->
  <LoginPortal client:only="react" />
</Layout>
