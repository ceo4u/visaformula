---
// src/pages/readiness.astro
import Layout from '../layouts/Layout.astro';
import VisaReadinessEngine from '../components/readiness/VisaReadinessEngine';
---

<Layout 
  title="AI Travel Readiness Score Calculator | TravlTik" 
  description="Check your travel readiness score (0-100%) and embassy refusal risk gaps using AI evaluation before submitting official applications for Canada, USA, UK, Germany, and Australia."
>
  <script is:inline>
    (function() {
      try {
        var user = localStorage.getItem('travltik_user');
        var seeker = localStorage.getItem('seeker_email') || localStorage.getItem('seeker_firstName');
        var expert = localStorage.getItem('expert_isLoggedIn') === 'true';
        if (!user && !seeker && !expert) {
          var targetUrl = window.location.pathname + window.location.search;
          window.location.replace('/login?redirect=' + encodeURIComponent(targetUrl));
        }
      } catch(e) {}
    })();
  </script>
  <main className="min-h-screen bg-slate-50/50 py-8 sm:py-12 px-4">
    <VisaReadinessEngine client:only="react" />
  </main>
</Layout>
