---
// src/pages/signup/index.astro
import Layout from '../../layouts/Layout.astro';
import { ArrowRight, Shield, Star, CheckCircle, Sparkles } from 'lucide-react';
import airplanePaths from '../../data/clean_airplane.json';
---

<Layout 
  title="Choose Account Type - VisaFormula" 
  description="Register a free VisaFormula account. Select whether to join as a Seeker to find top visa experts, or as an Expert to consult clients and grow your global practice."
  hideHeader={true}
  hideFooter={true}
>
  <div class="min-h-screen bg-white flex flex-col items-center justify-center px-4 py-16 font-sans relative">
      
      <!-- Back Button - Top Left -->
      <a href="javascript:history.back()" class="absolute top-6 left-6 flex items-center justify-center w-8 h-8 rounded-full border border-slate-200 text-slate-500 hover:text-black hover:border-black hover:bg-slate-50 transition-all">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </a>
      
      <!-- CSS animations for high luxury floating circles -->
      <style is:inline>
          @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-8px); }
          }
          @keyframes pulse-ring {
            0% { transform: scale(1); opacity: 0.4; }
            50% { transform: scale(1.08); opacity: 0.15; }
            100% { transform: scale(1); opacity: 0.4; }
          }
          .circle-float-1 { animation: float 4s ease-in-out infinite; }
          .circle-float-2 { animation: float 4s ease-in-out infinite 0.5s; }
          .pulse-ring { animation: pulse-ring 3s ease-in-out infinite; }
      </style>

      <!-- Logo (Centered, identical to Login Page) -->
      <a href="/" class="inline-flex items-center justify-center gap-2 group mb-4">
          <svg class="w-80 h-auto" viewBox="0 0 700 340" xmlns="http://www.w3.org/2000/svg" shape-rendering="geometricPrecision" text-rendering="geometricPrecision">
              <!-- Centered airplane swoop above the wordmark -->
              <g transform="translate(45, -145) scale(0.68)">
                  {airplanePaths.map((p) => (
                      <path d={p.d} fill={p.fill} transform={p.transform} />
                  ))}
              </g>
              
              <!-- Wordmark -->
              <text x="350" y="235" text-anchor="middle" font-family="'Plus Jakarta Sans', 'Montserrat', sans-serif" font-weight="900" font-size="82" letter-spacing="0.02em">
                  <tspan fill="#111111" stroke="#111111" stroke-width="3">VISA</tspan>
                  <tspan fill="#0F2B6C" stroke="#0F2B6C" stroke-width="3">FORMULA</tspan>
              </text>
              
              <!-- Tagline -->
              <text x="350" y="300" text-anchor="middle" font-family="'Plus Jakarta Sans', 'Montserrat', sans-serif" font-weight="800" font-size="24" letter-spacing="0.25em" fill="#0F2B6C">
                  GLOBAL VISA MARKETPLACE
              </text>
          </svg>
      </a>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-full px-4 py-1.5 mb-6">
          <Sparkles class="w-3.5 h-3.5 text-black" />
          <span class="text-xs font-bold text-slate-800">Join 50,000+ users</span>
      </div>

      <!-- Heading -->
      <h1 class="font-sora text-3xl sm:text-4xl font-extrabold text-[#0F2B6C] mb-2 text-center">
          I want to join as
      </h1>
      <p class="text-gray-400 text-sm mb-12 text-center">Select your role to get started with VisaFormula</p>

      <!-- Two Circles -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-12 sm:gap-20 mb-12">
          
          <!-- Seeker Option -->
          <a href="/signup/seeker" class="group flex flex-col items-center text-center">
              <div class="relative circle-float-1">
                  <!-- Outer pulse ring -->
                  <div class="absolute inset-[-6px] rounded-full border-2 border-slate-100 pulse-ring"></div>
                  <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-gradient-to-br from-slate-50 to-white border-2 border-navy/15 flex items-center justify-center shadow-lg group-hover:scale-105 group-hover:shadow-xl group-hover:border-black transition-all duration-300 relative z-10">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" class="sm:w-14 sm:h-14">
                          <circle cx="12" cy="8" r="3.5" fill="#000" opacity="0.2"></circle>
                          <circle cx="12" cy="8" r="3.5" stroke="#000" stroke-width="1.8" fill="none"></circle>
                          <path d="M5 20c0-3 3.1-5.5 7-5.5s7 2.5 7 5.5" stroke="#000" stroke-width="1.8" stroke-linecap="round" fill="none"></path>
                          <path d="M16 4l1.5 1.5L16 7" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                          <path d="M17.5 5.5H15" stroke="#000" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg>
                  </div>
              </div>
              <span class="mt-5 font-sora font-extrabold text-black text-base sm:text-lg group-hover:text-slate-600 transition-colors">Visa Seeker</span>
              <span class="text-xs text-gray-450 mt-1 mb-4 font-semibold">Find, consult & book immigration experts</span>
              <span class="bg-black hover:bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all active:scale-[0.97]">
                  Register as Seeker <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </span>
          </a>

          <!-- Divider -->
          <div class="flex flex-row sm:flex-col items-center gap-2 text-gray-300 font-bold text-xs uppercase tracking-widest py-4">
              <div class="w-12 sm:w-px h-px sm:h-10 bg-gray-200"></div>
              <span class="text-gray-400">OR</span>
              <div class="w-12 sm:w-px h-px sm:h-10 bg-gray-200"></div>
          </div>

          <!-- Expert Option -->
          <a href="/signup/expert" class="group flex flex-col items-center text-center">
              <div class="relative circle-float-2">
                  <!-- Outer pulse ring -->
                  <div class="absolute inset-[-6px] rounded-full border-2 border-slate-100 pulse-ring"></div>
                  <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-full bg-gradient-to-br from-slate-50 to-white border-2 border-navy/15 flex items-center justify-center shadow-lg group-hover:scale-105 group-hover:shadow-xl group-hover:border-black transition-all duration-300 relative z-10">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" class="sm:w-14 sm:h-14">
                          <rect x="5" y="2" width="14" height="20" rx="3" fill="#000" opacity="0.12"></rect>
                          <rect x="5" y="2" width="14" height="20" rx="3" stroke="#000" stroke-width="1.8" fill="none"></rect>
                          <circle cx="12" cy="10" r="2.5" stroke="#000" stroke-width="1.5" fill="none"></circle>
                          <path d="M8.5 16c0-1.5 1.6-2.8 3.5-2.8s3.5 1.3 3.5 2.8" stroke="#000" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
                          <circle cx="16" cy="5" r="0.7" fill="#000"></circle>
                          <circle cx="16" cy="7.5" r="0.7" fill="#000"></circle>
                      </svg>
                  </div>
              </div>
              <span class="mt-5 font-sora font-extrabold text-black text-base sm:text-lg group-hover:text-slate-600 transition-colors">Visa Expert</span>
              <span class="text-xs text-gray-455 mt-1 mb-4 font-semibold">Grow your global client consulting practice</span>
              <span class="bg-black hover:bg-slate-900 text-white px-5 py-2.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all active:scale-[0.97]">
                  Register as Expert <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </span>
          </a>

      </div>

      <!-- Trust Badges -->
      <div class="flex items-center gap-6 text-[10px] font-black uppercase tracking-wider text-gray-400 mt-4">
          <span class="flex items-center gap-1.5"><Shield class="w-4 h-4 text-black" /> Escrow protected</span>
          <span class="flex items-center gap-1.5"><Star class="w-4 h-4 text-black fill-black" /> 4.9★ rated</span>
          <span class="flex items-center gap-1.5"><CheckCircle class="w-4 h-4 text-black" /> KYC verified</span>
      </div>

  </div>
</Layout>
