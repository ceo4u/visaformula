---
// src/pages/success-stories.astro
import Layout from '../layouts/Layout.astro';

const stories = [
    {
        name: "Rahul Verma",
        city: "Hyderabad",
        visa: "H-1B Transfer – USA",
        category: "Work Permit",
        categoryClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
        quote: "H-1B transfer from a small firm to a Fortune 500 done in 45 days. The premium processing option and VisaFormula's legal team made it absolutely seamless. Highly recommend!",
        image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop&crop=face",
        helpful: 189,
        timeAgo: "3 months ago",
        detail: "Premium Processing • H-1B Cap Exempt Transfer"
    },
    {
        name: "Ananya Patel",
        city: "Secunderabad",
        visa: "UK Student Visa – UCL",
        category: "Study Visa",
        categoryClass: "bg-blue-50 text-blue-700 border-blue-200",
        quote: "UCL admission + UK student visa approved in 3 weeks. My VisaFormula consultant handled everything — from SOP review to CAS verification. Incredible turnaround!",
        image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200&h=200&fit=crop&crop=face",
        helpful: 201,
        timeAgo: "1 month ago",
        detail: "UCL MSc Computer Science • Tier 4 Student Visa"
    },
    {
        name: "Mohammed Irfan",
        city: "Jubilee Hills, Hyd",
        visa: "Australia PR – Skilled Migration",
        category: "PR / Residency",
        categoryClass: "bg-violet-50 text-violet-700 border-violet-200",
        quote: "Got my 189 subclass visa approved after a smooth skills assessment. VisaFormula's consultant knew exactly which NOC to use and how to maximise my points. Forever grateful!",
        image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=200&h=200&fit=crop&crop=face",
        helpful: 156,
        timeAgo: "5 months ago",
        detail: "Subclass 189 • Skilled Independent Visa • 85 Points"
    },
    {
        name: "Sneha Reddy",
        city: "Madhapur, Hyd",
        visa: "Germany Job Seeker Visa",
        category: "Work Permit",
        categoryClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
        quote: "Never thought Germany was possible without knowing German. VisaFormula connected me with an IT recruiter in Berlin. Got my job seeker visa in 6 weeks, and now I have a full-time offer!",
        image: "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?w=200&h=200&fit=crop&crop=face",
        helpful: 123,
        timeAgo: "4 months ago",
        detail: "Job Seeker Visa → Blue Card Pathway • Berlin"
    },
    {
        name: "Aditya Kumar",
        city: "Hyderabad",
        visa: "Canada Student Visa – UofT",
        category: "Study Visa",
        categoryClass: "bg-blue-50 text-blue-700 border-blue-200",
        quote: "University of Toronto acceptance + study permit in under 5 weeks. My VisaFormula consultant's checklist was incredibly detailed. Zero rejections, zero stress!",
        image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=face",
        helpful: 98,
        timeAgo: "2 months ago",
        detail: "UofT Engineering • IRCC Study Permit Approved"
    },
    {
        name: "Fatima Begum",
        city: "Banjara Hills, Hyd",
        visa: "Family Reunification – UK",
        category: "Family Visa",
        categoryClass: "bg-rose-50 text-rose-700 border-rose-200",
        quote: "Getting a UK spouse visa felt impossible. VisaFormula's team prepared a bulletproof financial evidence package. Approved first attempt in 8 weeks!",
        image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&h=200&fit=crop&crop=face",
        helpful: 167,
        timeAgo: "6 months ago",
        detail: "UK Spouse Visa • Appendix FM • First Attempt"
    },
    {
        name: "Kiran Rao",
        city: "Kondapur, Hyd",
        visa: "New Zealand Skilled Migrant",
        category: "PR / Residency",
        categoryClass: "bg-violet-50 text-violet-700 border-violet-200",
        quote: "New Zealand was a dream destination. Got 160 points under SMC with VisaFormula's help on job offer documentation. Now living in Auckland!",
        image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=200&h=200&fit=crop&crop=face",
        helpful: 144,
        timeAgo: "7 months ago",
        detail: "Skilled Migrant Category • 160 Points • Auckland"
    },
    {
        name: "Divya Lakshmi",
        city: "Gachibowli, Hyd",
        visa: "Australia Student Visa – ANU",
        category: "Study Visa",
        categoryClass: "bg-blue-50 text-blue-700 border-blue-200",
        quote: "ANU scholarship + student visa in one shot. My consultant helped me draft an exceptional SOP. Subclass 500 approved!",
        image: "https://images.unsplash.com/photo-1580489944761-15a19d654956?w=200&h=200&fit=crop&crop=face",
        helpful: 112,
        timeAgo: "3 months ago",
        detail: "ANU MBA • Subclass 500 • Merit Scholarship"
    },
    {
        name: "Suresh Babu",
        city: "LB Nagar, Hyd",
        visa: "Dubai Work Permit",
        category: "Work Permit",
        categoryClass: "bg-emerald-50 text-emerald-700 border-emerald-200",
        quote: "Found a verified construction management job in Dubai through VisaFormula's job board. Work permit processed in 3 weeks. The escrow protection saved me from a fraudulent agent!",
        image: "https://images.unsplash.com/photo-1560250097-0b93528c311a?w=200&h=200&fit=crop&crop=face",
        helpful: 89,
        timeAgo: "1 month ago",
        detail: "UAE Employment Visa • Verified Employer • 3 Year Contract"
    },
];
---

<Layout
    title="Success Stories"
    description="Real success stories from VisaFormula users across Hyderabad and India. Visa approvals, PR grants, study permits and more."
>
    <div class="bg-[#fff5f5] min-h-screen pb-24">

        <!-- HERO -->
        <section class="relative text-white overflow-hidden" style="padding-top:8rem;padding-bottom:8rem;">
            <div class="absolute inset-0 z-0">
                <img
                    src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=1800&h=800&fit=crop&q=90"
                    alt="Success celebration"
                    style="width:100%;height:100%;object-fit:cover;"
                />
                <div class="absolute inset-0" style="background:linear-gradient(to bottom,rgba(12,26,46,0.88),rgba(12,26,46,0.72),rgba(12,26,46,0.96));"></div>
            </div>
            <div class="relative z-10 text-center px-4" style="max-width:48rem;margin:0 auto;">
                <span style="font-size:10px;font-weight:900;color:#ff8a80;letter-spacing:0.15em;text-transform:uppercase;display:block;margin-bottom:12px;">Real People. Real Visas.</span>
                <h1 class="font-sora" style="font-size:clamp(2.2rem,6vw,3.8rem);font-weight:800;color:#fff;line-height:1.1;margin-bottom:16px;">Success Stories</h1>
                <p style="color:rgba(255,255,255,0.72);font-size:1.05rem;max-width:36rem;margin:0 auto;line-height:1.7;font-weight:500;">
                    From Hyderabad to the world — thousands of students, professionals, and families who turned their global dreams into reality with VisaFormula.
                </p>
            </div>
        </section>

        <!-- STATS BAR -->
        <section style="background:#fff;border-bottom:1px solid #e8f0fe;padding:2.5rem 1rem;">
            <div style="max-width:56rem;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;text-align:center;">
                <div>
                    <div style="width:48px;height:48px;background:#ecfdf5;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                        <svg width="22" height="22" fill="none" stroke="#10b981" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div style="font-size:1.35rem;font-weight:800;color:#0c1a2e;">50,000+</div>
                    <div style="font-size:11px;color:#9ca3af;font-weight:600;margin-top:2px;">Visas Approved</div>
                </div>
                <div>
                    <div style="width:48px;height:48px;background:#f0f9ff;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                        <svg width="22" height="22" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                    </div>
                    <div style="font-size:1.35rem;font-weight:800;color:#0c1a2e;">98.7%</div>
                    <div style="font-size:11px;color:#9ca3af;font-weight:600;margin-top:2px;">Success Rate</div>
                </div>
                <div>
                    <div style="width:48px;height:48px;background:#f5f3ff;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                        <svg width="22" height="22" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </div>
                    <div style="font-size:1.35rem;font-weight:800;color:#0c1a2e;">12,000+</div>
                    <div style="font-size:11px;color:#9ca3af;font-weight:600;margin-top:2px;">Happy Families</div>
                </div>
                <div>
                    <div style="width:48px;height:48px;background:#fffbeb;border-radius:14px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
                        <svg width="22" height="22" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                    </div>
                    <div style="font-size:1.35rem;font-weight:800;color:#0c1a2e;">850+</div>
                    <div style="font-size:11px;color:#9ca3af;font-weight:600;margin-top:2px;">Expert Consultants</div>
                </div>
            </div>
        </section>

        <!-- FEATURED STORY -->
        <section style="max-width:64rem;margin:4rem auto 3rem;padding:0 1rem;">
            <div style="text-align:center;margin-bottom:2rem;">
                <span style="font-size:10px;font-weight:900;color:#f59e0b;letter-spacing:0.15em;text-transform:uppercase;display:block;margin-bottom:4px;">Featured</span>
                <h2 class="font-sora" style="font-size:1.5rem;font-weight:800;color:#0c1a2e;">Story of the Month</h2>
            </div>

            <div style="background:linear-gradient(135deg,#0c1a2e 0%,#071324 100%);border-radius:28px;padding:2.5rem;box-shadow:0 25px 60px rgba(12,26,46,0.35);position:relative;overflow:hidden;">
                <!-- glow blobs -->
                <div style="position:absolute;top:0;right:0;width:280px;height:280px;background:rgba(14,165,233,0.07);border-radius:50%;filter:blur(60px);pointer-events:none;"></div>
                <div style="position:absolute;bottom:0;left:0;width:180px;height:180px;background:rgba(124,58,237,0.05);border-radius:50%;filter:blur(40px);pointer-events:none;"></div>

                <div style="position:relative;z-index:1;display:flex;gap:2rem;align-items:flex-start;flex-wrap:wrap;">
                    <!-- Left: Avatar + info -->
                    <div style="flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:12px;min-width:130px;">
                        <img
                            src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=300&h=300&fit=crop&crop=face"
                            alt="Priya Sharma"
                            style="width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid rgba(14,165,233,0.4);box-shadow:0 8px 32px rgba(14,165,233,0.2);"
                        />
                        <div style="text-align:center;">
                            <div style="font-weight:800;color:#fff;font-size:15px;">Priya Sharma</div>
                            <div style="font-size:11px;color:#94a3b8;font-weight:600;margin-top:2px;">Hyderabad</div>
                            <span style="display:inline-block;margin-top:8px;font-size:9px;font-weight:900;letter-spacing:0.1em;text-transform:uppercase;background:#1e3a5f;color:#fef08a;border:1px solid rgba(56,189,248,0.25);padding:3px 10px;border-radius:99px;">PR / Residency</span>
                        </div>
                    </div>

                    <!-- Right: Quote + detail -->
                    <div style="flex:1;min-width:240px;">
                        <!-- Stars -->
                        <div style="display:flex;gap:3px;margin-bottom:14px;">
                            <svg width="16" height="16" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="16" height="16" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="16" height="16" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="16" height="16" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="16" height="16" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </div>

                        <blockquote style="font-size:1.05rem;font-weight:600;color:rgba(255,255,255,0.9);line-height:1.7;font-style:italic;margin:0 0 20px 0;">
                            "I had been trying to crack the Express Entry pool for 2 years on my own. VisaFormula connected me with the right consultant who boosted my CRS score strategy. Got my ITA with CRS 472 in just 6 months. The escrow payment system gave me complete peace of mind throughout!"
                        </blockquote>

                        <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:16px;">
                            <span style="background:rgba(14,165,233,0.15);border:1px solid rgba(14,165,233,0.25);color:#ff8a80;font-size:10px;font-weight:900;padding:5px 14px;border-radius:99px;letter-spacing:0.08em;text-transform:uppercase;">
                                ✓ Canada PR – Express Entry
                            </span>
                            <span style="font-size:11px;color:#64748b;font-weight:600;">Received ITA in Round 156 • CRS Score: 472 • Processing: 6 months</span>
                        </div>

                        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#64748b;font-weight:600;">
                            <svg width="14" height="14" fill="#f87171" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            342 people found this helpful
                            <span style="margin-left:8px;color:#475569;">• 2 months ago</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- MORE STORIES GRID -->
        <section style="max-width:72rem;margin:0 auto;padding:0 1rem;">
            <div style="text-align:center;margin-bottom:2.5rem;">
                <span style="font-size:10px;font-weight:900;color:#f59e0b;letter-spacing:0.15em;text-transform:uppercase;display:block;margin-bottom:4px;">Community</span>
                <h2 class="font-sora" style="font-size:1.5rem;font-weight:800;color:#0c1a2e;">More Success Stories</h2>
                <p style="font-size:12px;color:#9ca3af;margin-top:6px;">Real approvals from real people across Hyderabad and India.</p>
            </div>

            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;">
                {stories.map((s) => (
                    <div style="background:#fff;border-radius:20px;border:1px solid #e0f0ff;padding:1.5rem;box-shadow:0 2px 12px rgba(14,165,233,0.06);display:flex;flex-direction:column;transition:transform 0.2s,box-shadow 0.2s;" onmouseenter="this.style.transform='translateY(-4px)';this.style.boxShadow='0 16px 40px rgba(14,165,233,0.12)'" onmouseleave="this.style.transform='none';this.style.boxShadow='0 2px 12px rgba(14,165,233,0.06)'">
                        <!-- Top row: Avatar + Name + Badge -->
                        <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
                            <img
                                src={s.image}
                                alt={s.name}
                                style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid #e0f0ff;flex-shrink:0;"
                            />
                            <div style="flex:1;min-width:0;">
                                <div style="font-weight:700;color:#0c1a2e;font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{s.name}</div>
                                <div style="font-size:11px;color:#94a3b8;font-weight:600;margin-top:1px;">{s.city}</div>
                            </div>
                            <span class={s.categoryClass} style="font-size:9px;font-weight:900;letter-spacing:0.08em;text-transform:uppercase;border:1px solid;padding:3px 9px;border-radius:99px;white-space:nowrap;flex-shrink:0;">{s.category}</span>
                        </div>

                        <!-- Stars -->
                        <div style="display:flex;gap:2px;margin-bottom:10px;">
                            <svg width="13" height="13" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="13" height="13" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="13" height="13" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="13" height="13" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            <svg width="13" height="13" fill="#fbbf24" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        </div>

                        <!-- Quote -->
                        <p style="font-size:13px;color:#4b5563;font-style:italic;line-height:1.65;flex:1;margin-bottom:14px;">
                            &ldquo;{s.quote}&rdquo;
                        </p>

                        <!-- Bottom info -->
                        <div style="border-top:1px solid #f0f9ff;padding-top:12px;">
                            <div style="font-size:10px;font-weight:900;color:#f59e0b;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;">✓ {s.visa}</div>
                            <div style="font-size:10px;color:#94a3b8;font-weight:600;margin-bottom:10px;">{s.detail}</div>
                            <div style="display:flex;justify-content:space-between;align-items:center;font-size:11px;color:#9ca3af;font-weight:600;">
                                <span style="display:flex;align-items:center;gap:4px;">
                                    <svg width="12" height="12" fill="#f87171" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                    {s.helpful} helpful
                                </span>
                                <span>{s.timeAgo}</span>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <!-- CTA BANNER -->
        <section style="max-width:64rem;margin:5rem auto 0;padding:0 1rem;">
            <div style="background:#000000;border:1px solid #27272a;border-radius:28px;padding:3rem 2rem;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.6);position:relative;overflow:hidden;">
                <div style="position:absolute;top:-40px;right:-40px;width:160px;height:160px;background:rgba(255,255,255,0.06);border-radius:50%;"></div>
                <div style="position:absolute;bottom:-40px;left:-40px;width:160px;height:160px;background:rgba(255,255,255,0.06);border-radius:50%;"></div>
                <div style="position:relative;z-index:1;">
                    <span style="font-size:10px;font-weight:900;color:rgba(255,255,255,0.55);letter-spacing:0.15em;text-transform:uppercase;display:block;margin-bottom:10px;">Your Story Starts Here</span>
                    <h2 class="font-sora" style="font-size:clamp(1.5rem,4vw,2.2rem);font-weight:800;color:#fff;margin-bottom:12px;">Ready to write your success story?</h2>
                    <p style="color:rgba(255,255,255,0.7);font-size:14px;max-width:36rem;margin:0 auto 2rem;line-height:1.65;font-weight:500;">
                        Join 50,000+ satisfied applicants who trusted VisaFormula to make their global dreams come true. Connect with a verified expert today.
                    </p>
                    <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;">
                        <a href="/find-experts" class="hover:bg-slate-100 transition-all duration-200" style="background:#fff;color:#000000;padding:14px 32px;border-radius:14px;font-weight:800;font-size:13px;text-decoration:none;display:inline-flex;align-items:center;gap:8px;box-shadow:0 4px 20px rgba(0,0,0,0.12);">
                            Find an Expert
                            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                        <a href="/support" class="hover:bg-white/20 transition-all duration-200" style="background:rgba(255,255,255,0.12);border:1.5px solid rgba(255,255,255,0.25);color:#fff;padding:14px 32px;border-radius:14px;font-weight:800;font-size:13px;text-decoration:none;">
                            Talk to Us
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </div>
</Layout>

