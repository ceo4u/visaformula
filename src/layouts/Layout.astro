---
// src/layouts/Layout.astro
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileNav from '../components/layout/MobileNav.astro';

import { TalkToUs } from '../components/shared/talk-to-us';
import { VisaMatchWidget } from '../components/shared/VisaMatchWidget';
import '../styles/globals.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, any>;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { 
  title, 
  description = "Apply visa smarter, faster, safer. Connect with verified experts, top universities, and track your visa journey — all in one place.", 
  keywords = "visa, immigration, experts, lawyer, consultant, migration, work visa, student visa, express entry, work permit, IELTS",
  ogImage = "/og-image.jpg", 
  canonical,
  schema,
  hideHeader = false,
  hideFooter = false,
  hideWidgets = false
} = Astro.props;

const currentUrl = canonical || Astro.url.href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isJobs = Astro.url.pathname === '/jobs' || Astro.url.pathname === '/jobs/';
const isTours = Astro.url.pathname === '/tours' || Astro.url.pathname === '/tours/';
const isEvents = Astro.url.pathname === '/events' || Astro.url.pathname === '/events/' || Astro.url.pathname.startsWith('/events');
const isChannelPartner = Astro.url.pathname.startsWith('/channel-partner');
const isCommunity = Astro.url.pathname.startsWith('/community');
const isVisaCountryPage = Astro.url.pathname.startsWith('/visa/') || Astro.url.pathname.startsWith('/visa');
const shouldHideWidgets = hideWidgets || isChannelPartner || isCommunity || isVisaCountryPage;
const isTransparentHeaderPage = isJobs || isTours || isEvents;

const pageTitle = isHome 
  ? "TravlTik — The Global Immigration & Mobility Platform | Marketplace" 
  : title.includes("TravlTik")
  ? `${title} | Global Immigration Marketplace`
  : `${title} | TravlTik — Global Immigration Marketplace`;

const ogTitle = isHome 
  ? "TravlTik — Global Immigration Marketplace" 
  : title.includes("TravlTik")
  ? `${title} | Global Immigration Marketplace`
  : `${title} | TravlTik — Global Immigration Marketplace`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  
  <!-- Primary Meta Tags -->
  <title>{pageTitle}</title>
  <meta name="title" content={pageTitle} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={currentUrl} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="TravlTik" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Google Fonts Preconnect & Fetch (High-Sharpness Typography: Plus Jakarta Sans, Google Sans, Inter, Roboto, Montserrat) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.cdnfonts.com/css/google-sans" rel="stylesheet" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png?v=2" />
  <link rel="shortcut icon" href="/favicon.ico?v=2" />
  <link rel="apple-touch-icon" href="/favicon.png?v=2" />
  
  <!-- Injected SEO Structured Data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="font-sans antialiased subpixel-antialiased text-slate-900 bg-[#fbfbfd] selection:bg-[#00a878]/20 selection:text-[#00a878] min-h-screen flex flex-col overflow-x-hidden">
  {!hideHeader && <Header />}
  <main class={`flex-grow ${hideHeader ? "" : "pt-16 lg:pt-20"}`}>
    <slot />
  </main>
  {!hideFooter && <Footer />}

  {!shouldHideWidgets && <VisaMatchWidget client:idle />}
  {!shouldHideWidgets && <TalkToUs client:idle />}
</body>
</html>
