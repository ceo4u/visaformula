---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/landing/LandingPage';
import { LoginPortal } from '../components/interactive/LoginPortal';
---

<Layout 
  title="Sign In to TravlTik" 
  description="Sign in to your TravlTik visa consultation account. Complete your application filing, check upcoming session schedules, and upload passport document scans."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Main Home Page rendered in the background -->
  <LandingPage client:only="react" />

  <!-- Fixed Modal Card Overlay -->
  <LoginPortal client:only="react" />
</Layout>
