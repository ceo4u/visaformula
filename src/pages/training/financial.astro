---
// src/pages/training/financial.astro
import Layout from '../../layouts/Layout.astro';
import { Wallet, Star, MapPin, Building2, ArrowRight, ShieldCheck, HelpCircle } from 'lucide-react';

const advisors = [
    { 
        name: "FinVisa Advisors", 
        city: "Mumbai", 
        rating: 4.9, 
        specialty: "GIC + Education Loans", 
        fee: "Free consultation", 
        image: "https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=400&h=300&fit=crop",
        desc: "Specialized in GIC account setup and securing quick education loans from top Indian private and public sector banks."
    },
    { 
        name: "StudyLoan Pro", 
        city: "Delhi", 
        rating: 4.8, 
        specialty: "HDFC Credila Partner", 
        fee: "₹500 one-time", 
        image: "https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=400&h=300&fit=crop",
        desc: "Official processing partner for HDFC Credila, offering fast tracking, low interest rates, and pre-admission loan approval."
    },
    { 
        name: "Global Finance Hub", 
        city: "Bangalore", 
        rating: 4.7, 
        specialty: "SBI Global Ed-Vantage", 
        fee: "Free consultation", 
        image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=400&h=300&fit=crop",
        desc: "Securing nationalized bank loans up to ₹1.5 Crore. Experts in collateral valuation and subsidy documentation."
    },
    { 
        name: "Loan Sarathi", 
        city: "Pune", 
        rating: 4.6, 
        specialty: "Prodigy Finance Partner", 
        fee: "Free consultation", 
        image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop",
        desc: "Specialized in collateral-free international loans through Prodigy Finance, MPOWER, and international lenders."
    },
];

const lendingInstitutes = [
    { name: "HDFC Credila", type: "Private NBFC", maxLoan: "Up to 100% Cost", rate: "9.5% - 11.5%", collateral: "Required / Non-Collateral" },
    { name: "State Bank of India", type: "Public Sector Bank", maxLoan: "Up to ₹1.5 Cr", rate: "8.55% - 9.85%", collateral: "Collateral Required" },
    { name: "Prodigy Finance", type: "International Lender", maxLoan: "Up to $100K USD", rate: "11.2% - 13.5%", collateral: "No Collateral/Cosigner" },
    { name: "ICICI Bank", type: "Private Sector Bank", maxLoan: "Up to ₹1 Cr", rate: "9.75% - 11.25%", collateral: "Required / Non-Collateral" }
];
---

<Layout 
    title="Education Loans & Student Finance Advisors" 
    description="Secure education loans, set up Guaranteed Investment Certificates (GIC) or Blocked Accounts, and consult verified student loan advisors."
>
    <div class="bg-[#fff5f5] min-h-screen pb-24">
        
        <!-- HERO SECTION -->
        <section class="relative text-white py-32 px-4 overflow-hidden border-b border-purple-950">
            <!-- Full-bleed background -->
            <div class="absolute inset-0 z-0">
                <img
                    src="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?w=1800&h=900&fit=crop&q=90"
                    alt="Financial consultation and planning documents"
                    class="w-full h-full object-cover"
                />
                <!-- Twilight deep purple-indigo gradient overlay matching training hub -->
                <div class="absolute inset-0 bg-gradient-to-b from-[#4c1d95]/90 via-[#5b21b6]/85 to-[#0c1a2e]/95"></div>
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_30%,rgba(167,139,250,0.2),transparent_60%)]"></div>
            </div>

            <!-- Content -->
            <div class="max-w-4xl mx-auto text-center relative z-10">
                <span class="bg-white/10 text-purple-300 text-[10px] font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full border border-white/20 mb-4 inline-block backdrop-blur-md">
                    💼 Financial Resources
                </span>
                <h1 class="font-sora text-4xl sm:text-5xl md:text-6xl font-extrabold mb-4 leading-tight tracking-tight text-white">
                    Study Abroad Loans &<br /><span class="bg-gradient-to-r from-[#c084fc] to-[#a78bfa] bg-clip-text text-transparent">Financial Planning</span>
                </h1>
                <p class="text-white/80 text-base sm:text-lg md:text-xl max-w-2xl mx-auto leading-relaxed font-medium">
                    Secure education loans, set up mandatory GIC or blocked accounts, and consult vetted advisors who understand visa financial requirements.
                </p>
            </div>
        </section>

        <!-- MAIN LAYOUT GRID -->
        <main class="max-w-6xl mx-auto px-4 mt-12 grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- LEFT Columns: GIC/Blocked Accounts & Institution Comparison -->
            <div class="lg:col-span-2 space-y-8">
                
                <!-- GIC & Blocked Accounts Info Panel -->
                <div class="bg-gradient-to-r from-amber-50 to-orange-50/55 border border-amber-200 rounded-3xl p-8 shadow-sm">
                    <div class="flex gap-4 items-start">
                        <div class="w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center shrink-0">
                            <ShieldCheck class="w-6 h-6 text-amber-700" />
                        </div>
                        <div>
                            <h2 class="font-sora font-extrabold text-navy text-lg mb-2">Mandatory Country Deposits (GIC & Blocked Accounts)</h2>
                            <p class="text-sm text-gray-600 leading-relaxed mb-6">
                                Many destination countries require proof of living expenses deposited in an approved bank before applying for a student visa.
                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Canada GIC -->
                        <div class="bg-white rounded-2xl p-5 border border-amber-200/60">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-2xl">🇨🇦</span>
                                <h3 class="font-sora font-bold text-navy text-sm">Canada GIC</h3>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed mb-4">
                                Under the Student Direct Stream (SDS) and general study permits, applicants require a Guaranteed Investment Certificate.
                            </p>
                            <ul class="text-[11px] text-gray-600 space-y-1.5 font-semibold">
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Required Deposit: CAD 20,635</li>
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Disbursed monthly during study</li>
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Banks: ICICI, SBI, Scotiabank, CIBC</li>
                            </ul>
                        </div>

                        <!-- Germany Blocked Account -->
                        <div class="bg-white rounded-2xl p-5 border border-amber-200/60">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-2xl">🇩🇪</span>
                                <h3 class="font-sora font-bold text-navy text-sm">Germany Blocked Account</h3>
                            </div>
                            <p class="text-xs text-gray-500 leading-relaxed mb-4">
                                A Sperrkonto (blocked account) is required to secure a German student visa, demonstrating sufficient self-maintenance funds.
                            </p>
                            <ul class="text-[11px] text-gray-600 space-y-1.5 font-semibold">
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Required Deposit: €11,904</li>
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Disbursed monthly: €992/month</li>
                                <li class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Providers: Fintiba, Coracle, Expatrio</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Lending Institutions Comparison -->
                <div class="bg-white border border-yellow-100 rounded-3xl p-8 shadow-sm">
                    <h2 class="font-sora font-extrabold text-navy text-lg mb-2 flex items-center gap-2">
                        <Building2 class="w-5 h-5 text-purple-600" /> Vetted Lending Partners
                    </h2>
                    <p class="text-xs text-gray-400 mb-6">Compare education loan structures from major banks and financial companies.</p>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs font-semibold">
                            <thead>
                                <tr class="border-b border-yellow-100 text-[10px] text-gray-400 uppercase tracking-wider">
                                    <th class="pb-3 pr-2">Institution</th>
                                    <th class="pb-3 pr-2">Type</th>
                                    <th class="pb-3 pr-2">Max Coverage</th>
                                    <th class="pb-3 pr-2">Interest Rate</th>
                                    <th class="pb-3">Collateral</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-yellow-50 text-navy">
                                {lendingInstitutes.map(inst => (
                                    <tr class="hover:bg-yellow-50/30 transition-colors">
                                        <td class="py-4 font-bold">{inst.name}</td>
                                        <td class="py-4 text-gray-500 font-normal">{inst.type}</td>
                                        <td class="py-4 text-purple-600">{inst.maxLoan}</td>
                                        <td class="py-4">{inst.rate}</td>
                                        <td class="py-4 text-gray-500 font-normal">{inst.collateral}</td>
                                    </tr>
                                ))}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Financial Advisors Section -->
                <div>
                    <h2 class="font-sora font-extrabold text-navy text-lg mb-6">Verified Financial Advisors</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {advisors.map(a => (
                            <div key={a.name} class="bg-white rounded-3xl border border-yellow-100 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-0.5 transition-all group flex flex-col sm:flex-row">
                                <div class="w-full sm:w-36 h-40 sm:h-auto shrink-0 overflow-hidden relative">
                                    <img src={a.image} alt={a.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                                </div>
                                <div class="p-5 flex flex-col justify-between flex-grow">
                                    <div>
                                        <h3 class="font-sora font-bold text-navy text-sm group-hover:text-purple-600 transition-colors leading-snug">{a.name}</h3>
                                        <div class="flex items-center gap-2 text-[10px] text-gray-400 mt-1">
                                            <span class="flex items-center gap-0.5"><MapPin class="w-3 h-3 text-purple-500" /> {a.city}</span>
                                            <span>·</span>
                                            <span class="flex items-center gap-0.5"><Star class="w-3 h-3 text-amber-500 fill-amber-500" /> {a.rating}</span>
                                        </div>
                                        <p class="text-[11px] text-gray-500 leading-relaxed mt-2.5">{a.desc}</p>
                                    </div>
                                    <div class="flex items-center justify-between mt-4 pt-3 border-t border-yellow-50">
                                        <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100">{a.fee}</span>
                                        <button class="bg-[#f59e0b] text-white px-3.5 py-1.5 rounded-xl text-xs font-bold hover:bg-[#d97706] transition-all shadow-sm active:scale-95">Consult Advisor</button>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>

            <!-- RIGHT Column: Sidebar with Visa Financial Requirements Tips -->
            <div class="space-y-8">
                <div class="bg-white border border-yellow-100 rounded-3xl p-6 shadow-sm">
                    <h3 class="font-sora font-bold text-navy text-sm mb-4 flex items-center gap-1.5"><HelpCircle class="w-4.5 h-4.5 text-purple-500" /> Country Requirements</h3>
                    <div class="space-y-4">
                        
                        <!-- USA -->
                        <div class="border-b border-yellow-50 pb-4 last:border-0 last:pb-0">
                            <div class="flex items-center gap-1.5 mb-1.5">
                                <span class="text-sm">🇺🇸</span>
                                <h4 class="font-bold text-xs text-navy">United States (F-1 Visa)</h4>
                            </div>
                            <p class="text-[11px] text-gray-500 leading-relaxed">
                                Requires Form I-20 issued by the university. You must show liquid funds covering the first full year of tuition and living expenses (e.g. ₹35L - ₹50L).
                            </p>
                        </div>

                        <!-- UK -->
                        <div class="border-b border-yellow-50 pb-4 last:border-0 last:pb-0">
                            <div class="flex items-center gap-1.5 mb-1.5">
                                <span class="text-sm">🇬🇧</span>
                                <h4 class="font-bold text-xs text-navy">United Kingdom (Student Visa)</h4>
                            </div>
                            <p class="text-[11px] text-gray-500 leading-relaxed">
                                Must show proof of unpaid tuition fees plus monthly maintenance funds (£1,334/mo in London, £1,023/mo elsewhere) held in a bank account for a continuous 28-day period.
                            </p>
                        </div>

                        <!-- Australia -->
                        <div class="border-b border-yellow-50 pb-4 last:border-0 last:pb-0">
                            <div class="flex items-center gap-1.5 mb-1.5">
                                <span class="text-sm">🇦🇺</span>
                                <h4 class="font-bold text-xs text-navy">Australia (Subclass 500)</h4>
                            </div>
                            <p class="text-[11px] text-gray-500 leading-relaxed">
                                Requires evidence of financial capacity to cover travel cost, tuition, and living costs of AUD 29,710 for the primary student (or parental annual income of AUD 84,543+).
                            </p>
                        </div>

                        <!-- Canada -->
                        <div>
                            <div class="flex items-center gap-1.5 mb-1.5">
                                <span class="text-sm">🇨🇦</span>
                                <h4 class="font-bold text-xs text-navy">Canada (Study Permit)</h4>
                            </div>
                            <p class="text-[11px] text-gray-500 leading-relaxed">
                                Tuition payment receipt for the 1st year is required, alongside a CAD 20,635 GIC deposit to cover living expenses for SDS visa fast-tracking.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Call to action card -->
                <div class="bg-gradient-to-tr from-purple-900 to-indigo-950 text-white rounded-3xl p-6 relative overflow-hidden shadow-md">
                    <div class="absolute -right-4 -bottom-4 w-32 h-32 bg-white/5 rounded-full blur-2xl"></div>
                    <h3 class="font-sora font-extrabold text-sm mb-2">Need a Visa Pre-Assessment?</h3>
                    <p class="text-[11px] text-white/75 leading-relaxed mb-6">
                        Visa financial documentation checks are crucial. Speak with a certified immigration consultant to audit your savings, properties, and sponsor declarations.
                    </p>
                    <a href="/find-experts">
                        <button class="w-full bg-[#f59e0b] hover:bg-[#d97706] text-white font-bold text-xs py-2.5 rounded-xl transition-all shadow-md active:scale-95 flex items-center justify-center gap-1.5">
                            Connect with Experts <ArrowRight class="w-3.5 h-3.5" />
                        </button>
                    </a>
                </div>
            </div>

        </main>
    </div>
</Layout>

