# TravlTik — Global Immigration Marketplace
# Apache .htaccess — Canonical Domain & Security Rules

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. www -> non-www canonical redirect (preserve static asset paths)
RewriteCond %{HTTP_HOST} ^www\.travltik\.com [NC]
RewriteCond %{REQUEST_URI} !^/_astro/
RewriteRule ^ https://travltik.com%{REQUEST_URI} [L,R=301]

# 3. Static Asset Fallback: If any requested CSS in /_astro/ is missing due to cache skew, serve current stylesheet with text/css
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} ^/_astro/.*\.css$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^_astro/(.*)\.css$ /_astro/_id_.DLPkAtK1.css [L,T=text/css]
</IfModule>

# Ensure correct MIME type for CSS and JS
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js .mjs
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.css$">
    Header set Content-Type "text/css; charset=UTF-8"
  </FilesMatch>
</IfModule>

# 5. Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>
