---
// src/pages/visa/[country].astro
import Layout from '../../layouts/Layout.astro';
import { VisaCountryResultPortal } from '../../components/visa/VisaCountryResultPortal';

export const prerender = false;

const { country } = Astro.params;
const passport = Astro.url.searchParams.get('passport') || Astro.url.searchParams.get('from') || 'India';

const rawPurpose = Astro.url.searchParams.get('purpose') || 
                   Astro.url.searchParams.get('category') || 
                   Astro.url.searchParams.get('type') || 
                   Astro.url.searchParams.get('intent') || 
                   Astro.url.searchParams.get('visa') || 
                   Astro.url.searchParams.get('q') || 
                   'tourism';

const purposeLower = rawPurpose.toLowerCase();
const purpose = (purposeLower.includes('pr') || purposeLower.includes('permanent') || purposeLower.includes('immigrat') || purposeLower.includes('green') || purposeLower.includes('settle'))
  ? 'pr'
  : (purposeLower.includes('student') || purposeLower.includes('study') || purposeLower.includes('education') || purposeLower.includes('university') || purposeLower.includes('course'))
  ? 'study'
  : (purposeLower.includes('work') || purposeLower.includes('job') || purposeLower.includes('employment') || purposeLower.includes('career'))
  ? 'work'
  : (purposeLower.includes('business') || purposeLower.includes('corporate') || purposeLower.includes('conference'))
  ? 'business'
  : (purposeLower.includes('family') || purposeLower.includes('friend') || purposeLower.includes('relative'))
  ? 'family'
  : 'tourism';

const countryClean = (country || 'destination')
  .split('-')
  .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
  .join(' ');

const pageTitle = `${countryClean} Visa for ${passport} Citizens | 100% Online Fast-Track Filing`;
const pageDesc = `Get your ${countryClean} visa online from your smartphone with guaranteed fast-track clearance, AI document verification, and 99.4% approval record.`;
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  keywords={`${countryClean} visa, ${countryClean} tourist visa, apply ${countryClean} visa online, ${countryClean} visa fees, ${countryClean} visa for ${passport}`}
  hideWidgets={true}
>
  <div class="min-h-screen bg-white">
    <VisaCountryResultPortal 
      client:load 
      countrySlug={country || 'uae'} 
      initialPassport={passport} 
      initialPurpose={purpose} 
    />
  </div>
</Layout>
