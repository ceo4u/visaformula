---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import { Shield, Globe, Users, Award, Clock, Lock, Briefcase, Star, HelpCircle, ArrowRight } from 'lucide-react';

const stats = [
    { value: "500+", label: "Verified Legal Experts", icon: Users },
    { value: "10,000+", label: "Successful Applications", icon: Briefcase },
    { value: "98%", label: "Satisfaction Rate", icon: Star },
    { value: "24/7", label: "Emergency Support", icon: Clock },
];

const values = [
    {
        title: "Transparency First",
        description: "No hidden fees, no surprises. Every cost is disclosed upfront with complete clarity.",
        icon: Shield,
    },
    {
        title: "Global Accessibility",
        description: "Bridging borders with technology. We make expert immigration help available worldwide.",
        icon: Globe,
    },
    {
        title: "Data Sovereignty",
        description: "Your documents belong to you. Bank-grade encryption and GDPR compliance always.",
        icon: Lock,
    },
];
---

<Layout 
    title="About Us — Our Mission & Core Values" 
    description="Learn more about VisaFormula, our mission to simplify immigration, our statistics, and our team of verified legal experts."
>
    <div class="bg-[#fff5f5] min-h-screen pb-24">
        
        <!-- HERO SECTION -->
        <section class="relative text-white py-16 px-4 overflow-hidden border-b border-purple-950" style="">
            <div class="absolute inset-0 z-0">
                <img src="/images/boardroom_team.png" alt="Team collaborating" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-b from-[#0c1a2e]/90 via-[#0c1a2e]/85 to-[#070b12]/95"></div>
            </div>

            <!-- Content -->
            <div class="max-w-4xl mx-auto text-center relative z-10">
                <span class="bg-white/10 text-purple-300 text-[10px] font-bold tracking-widest px-3.5 py-1.5 rounded-full border border-white/20 mb-4 inline-block backdrop-blur-md">
                    🌍 About VisaFormula
                </span>
                <h1 class="font-sora text-4xl sm:text-5xl md:text-6xl font-extrabold mb-4 leading-tight tracking-tight text-white">
                    Making Immigration<br /><span class="bg-gradient-to-r from-amber-400 to-[#f59e0b] bg-clip-text text-transparent">Simple for Everyone</span>
                </h1>
                <p class="text-white/80 text-base sm:text-lg md:text-xl max-w-2xl mx-auto leading-relaxed font-medium">
                    VisaFormula was founded to solve the #1 problem in global migration: the overwhelming complexity of legal paperwork and the difficulty of finding trusted experts.
                </p>
            </div>
        </section>

        <!-- STATS SECTION -->
        <section class="max-w-5xl mx-auto px-4 -mt-10 relative z-20 mb-20">
            <div class="bg-white border border-yellow-100 rounded-3xl p-8 shadow-lg grid grid-cols-2 md:grid-cols-4 gap-8">
                {stats.map(stat => {
                    const IconComponent = stat.icon;
                    return (
                        <div class="text-center space-y-2">
                            <div class="flex justify-center">
                                <div class="w-10 h-10 rounded-xl bg-yellow-50 flex items-center justify-center border border-yellow-100/50">
                                    <IconComponent class="w-5 h-5 text-[#f59e0b]" />
                                </div>
                            </div>
                            <div class="font-sora font-extrabold text-navy text-2xl md:text-3xl">{stat.value}</div>
                            <div class="text-[10px] font-bold text-gray-400 tracking-wider">{stat.label}</div>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- MISSION SECTION -->
        <section class="max-w-5xl mx-auto px-4 py-8 mb-16">
            <div class="grid lg:grid-cols-2 gap-12 items-center">
                <div class="space-y-6">
                    <span class="text-[10px] font-black text-[#f59e0b] tracking-widest block">Our Mission</span>
                    <h2 class="font-sora font-extrabold text-navy text-3xl leading-tight">
                        We believe borders shouldn't be barriers to human potential
                    </h2>
                    <p class="text-xs text-gray-500 leading-relaxed font-medium">
                        Every year, millions of dreams are delayed or denied due to confusing paperwork, lack of expert access, and outdated systems. We're changing that.
                    </p>
                    <p class="text-xs text-gray-500 leading-relaxed font-medium">
                        VisaFormula connects you with a curated network of top-tier immigration consultants and lawyers. Our platform handles everything from document verification to application tracking—so you can focus on your future.
                    </p>
                </div>
                <div class="relative">
                    <div class="rounded-3xl overflow-hidden shadow-xl border border-yellow-100">
                        <img 
                            src="/images/boardroom_team.png" 
                            alt="Legal team collaborating" 
                            class="object-cover w-full h-[350px]" 
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- VALUES SECTION -->
        <section class="max-w-5xl mx-auto px-4 py-8 mb-16">
            <div class="text-center max-w-2xl mx-auto mb-12">
                <span class="text-[10px] font-black text-purple-600 tracking-widest block mb-1">Our Core Values</span>
                <h2 class="font-sora font-extrabold text-navy text-2xl">The Principles Guiding VisaFormula</h2>
                <p class="text-xs text-gray-400 mt-1">We operate under a strict code of ethics, technology, and clarity.</p>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8">
                {values.map(val => {
                    const IconComponent = val.icon;
                    return (
                        <div class="bg-white rounded-3xl border border-yellow-100 p-8 shadow-sm hover:shadow-md transition-all text-center space-y-4">
                            <div class="w-14 h-14 rounded-full bg-purple-50 flex items-center justify-center mx-auto border border-purple-100/50">
                                <IconComponent class="w-6 h-6 text-purple-600" />
                            </div>
                            <h3 class="font-sora font-bold text-navy text-base">{val.title}</h3>
                            <p class="text-xs text-gray-500 leading-relaxed font-medium">{val.description}</p>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- CTA SECTION -->
        <section class="max-w-5xl mx-auto px-4">
            <div class="bg-gradient-to-tr from-purple-900 to-indigo-950 text-white rounded-3xl p-12 text-center relative overflow-hidden shadow-lg border border-purple-950/40">
                <div class="absolute -right-16 -bottom-16 w-48 h-48 bg-white/5 rounded-full blur-3xl"></div>
                <div class="relative z-10 max-w-xl mx-auto space-y-6">
                    <h2 class="font-sora font-extrabold text-2xl md:text-3xl leading-tight">Ready to Start Your Journey?</h2>
                    <p class="text-xs text-white/75 leading-relaxed max-w-md mx-auto font-medium">
                        Join thousands of successful migrants, students, and professionals who found their path with VisaFormula.
                    </p>
                    <div class="flex justify-center pt-2">
                        <a href="/find-experts">
                            <button class="bg-[#f59e0b] hover:bg-[#d97706] text-white font-bold text-xs px-6 py-3 rounded-xl transition-all shadow-md active:scale-95 flex items-center gap-1.5">
                                Connect with Experts <ArrowRight class="w-4 h-4" />
                            </button>
                        </a>
                    </div>
                </div>
            </div>
        </section>
        
    </div>
</Layout>


