export async function getStaticPaths() {
  return allClassifieds.map(c => ({
    params: { id: c.id },
    props: { classified: c }
  }));
}

const { id } = Astro.params;
const classified = Astro.props.classified || allClassifieds.find(c => c.id === id) || allClassifieds[0];
---

<Layout title={`${classified.title} | TravlTik Classifieds`}>
  {/* Modal Overlay Box with Dark Blurred Background (matching Registration/Readiness modal style) */}
  <div 
    id="classified-modal-backdrop"
    class="fixed inset-0 z-[9999] bg-slate-900/60 backdrop-blur-md flex flex-col items-center justify-center p-3 sm:p-6 font-sans overflow-y-auto selection:bg-[#00a896] selection:text-white"
  >
    <div class="relative z-10 w-full max-w-4xl flex flex-col items-center justify-center my-auto py-4 font-sans">
      
      {/* Top Header Row with Logo & Back Button */}
      <div class="w-full flex items-center justify-between mb-3 px-1 shrink-0 gap-2 font-sans">
        <a href="/" class="flex items-center gap-1.5 text-xs font-semibold text-white bg-white/20 hover:bg-white/30 transition-all px-4 py-2 rounded-full border border-white/30 backdrop-blur-md shadow-md shrink-0">
          <ArrowLeft class="w-4 h-4" /> <span class="hidden sm:inline">Back to </span>Home
        </a>
        <a href="/" class="shrink-0">
          <img src="/logo-white.png" alt="TravlTik" class="h-7 sm:h-9 w-auto object-contain max-w-[120px] sm:max-w-none" />
        </a>
      </div>

      {/* Main Floating Modal Card (Only the single card content shown, bottom grid removed) */}
      <div class="bg-white border border-slate-200/90 rounded-[32px] shadow-2xl relative w-full p-5 sm:p-7 font-sans overflow-hidden text-slate-900">
        
        {/* Close Button */}
        <a 
          href="/"
          title="Close and return to homepage"
          class="absolute top-4 right-4 sm:top-5 sm:right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 flex items-center justify-center transition-all cursor-pointer shadow-2xs border border-slate-200 z-30"
        >
          <X class="w-4.5 h-4.5" />
        </a>

        {/* Main Grid: Left Image + Right Info */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center pt-2 sm:pt-4">
          
          {/* Left: Image Container */}
          <div class="lg:col-span-6 relative min-h-[260px] sm:min-h-[320px] rounded-2xl bg-slate-900 overflow-hidden group shadow-md">
            <img 
              src={classified.img} 
              alt={classified.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-95"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/30"></div>
            
            <div class="absolute top-4 left-4 z-10">
              <span class="bg-[#00a896] text-white text-[11px] font-extrabold px-3 py-1 rounded-full shadow-lg flex items-center gap-1.5">
                <ShieldCheck class="w-3.5 h-3.5" /> Verified Offer
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-white z-10 flex items-center justify-between">
              <span class="text-[11px] font-bold text-slate-200 bg-slate-900/80 backdrop-blur-md px-3 py-1 rounded-xl border border-white/20">
                📍 {classified.location}
              </span>
              <span class="text-[11px] font-semibold text-slate-300">
                {classified.time}
              </span>
            </div>
          </div>

          {/* Right: Info & Contact Action Buttons */}
          <div class="lg:col-span-6 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              {/* Single Consolidated Badges & Price Row */}
              <div class="flex flex-wrap items-center justify-between gap-2 pr-6">
                <div class="flex items-center gap-1.5">
                  <span class="inline-flex items-center gap-1.5 bg-teal-50 border border-teal-200 text-[#00a896] text-xs font-extrabold px-3 py-1 rounded-full">
                    <Tag class="w-3.5 h-3.5" /> {classified.category}
                  </span>
                  <span class="inline-flex items-center gap-1.5 bg-slate-900 text-white text-xs font-extrabold px-3 py-1 rounded-full">
                    {classified.flag} {classified.country}
                  </span>
                </div>
                <span class="text-xs sm:text-sm font-black text-emerald-700 bg-emerald-50 px-3.5 py-1 rounded-xl border border-emerald-200 shadow-2xs">
                  {classified.price}
                </span>
              </div>

              <h1 class="text-xl sm:text-2xl font-bold text-slate-900 leading-tight">
                {classified.title}
              </h1>

              {/* Poster Info Badge */}
              <div class="p-3 bg-slate-50 border border-slate-200/90 rounded-2xl flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-xl bg-[#00a896] text-white flex items-center justify-center font-bold text-base shadow-sm shrink-0">
                    {classified.postedBy.charAt(0)}
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <h3 class="text-xs font-bold text-slate-900">{classified.postedBy}</h3>
                      <ShieldCheck class="w-3.5 h-3.5 text-[#00a896] shrink-0" />
                    </div>
                    <p class="text-[10px] font-semibold text-slate-500">Verified Platform Consultant</p>
                  </div>
                </div>
                <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100/80 px-2 py-0.5 rounded-lg">
                  Active Member
                </span>
              </div>

              <p class="text-xs text-slate-600 font-medium leading-relaxed">
                {classified.description}
              </p>
            </div>

            {/* Quick Action Buttons */}
            <div class="space-y-2.5 pt-3 border-t border-slate-100">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <a 
                  href={`https://wa.me/${classified.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hi! I am interested in your classified listing: ${classified.title}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="py-3 px-4 bg-[#00a896] hover:bg-[#008f80] text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95"
                >
                  <MessageSquare class="w-4 h-4" />
                  <span>Chat on WhatsApp</span>
                </a>

                <a 
                  href={`tel:${classified.contactPhone}`}
                  class="py-3 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95"
                >
                  <Phone class="w-4 h-4 text-[#00a896]" />
                  <span>Call Expert Now</span>
                </a>
              </div>

              <p class="text-[10px] font-semibold text-slate-400 text-center flex items-center justify-center gap-1.5 pt-1">
                <ShieldCheck class="w-3.5 h-3.5 text-[#00a896]" />
                <span>Verified Listing — Powered by TravlTik Security Guard</span>
              </p>
            </div>
          </div>

        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  // Close modal when clicking dark backdrop outside card
  const backdrop = document.getElementById('classified-modal-backdrop');
  if (backdrop) {
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        window.location.href = '/';
      }
    });
  }
</script>
