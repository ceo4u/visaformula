  <script is:inline>
    const slides = [
      {
        title: "Direct Portal Access to Dubai & Global Visa Experts",
        btnText: "Search Experts",
        href: "/find-experts"
      },
      {
        title: "Fast-Track Student Admissions Open",
        btnText: "Search Universities",
        href: "/universities"
      },
      {
        title: "Explore International Holiday Packages",
        btnText: "Explore Packages",
        href: "/tours"
      }
    ];

    let currentSlide = 0;
    let isPaused = false;
    let progress = 0;
    const duration = 5000; // 5 seconds per slide
    const stepTime = 30; // update progress every 30ms
    const progressStep = (stepTime / duration) * 100;
    let intervalId;

    const bgContainers = document.querySelectorAll('.slide-bg');
    const titleEl = document.getElementById('hero-title');
    const actionBtnEl = document.getElementById('hero-action-btn');
    const btnTextEl = document.getElementById('hero-btn-text');
    const fills = document.querySelectorAll('.hero-progress-fill');
    const pauseBtn = document.getElementById('hero-carousel-pause-btn');
    const pauseIcon = document.getElementById('pause-icon');
    const playIcon = document.getElementById('play-icon');
    const indicatorBars = document.querySelectorAll('.hero-indicator-bar');

    function changeSlide(nextSlideIndex) {
      fills[currentSlide].style.height = '0%';
      
      bgContainers[currentSlide].classList.replace('opacity-100', 'opacity-0');
      bgContainers[nextSlideIndex].classList.replace('opacity-0', 'opacity-100');
      
      titleEl.classList.add('opacity-0', 'translate-y-2');
      actionBtnEl.classList.add('opacity-0', 'translate-y-2');
      
      setTimeout(() => {
        titleEl.textContent = slides[nextSlideIndex].title;
        btnTextEl.textContent = slides[nextSlideIndex].btnText;
        actionBtnEl.setAttribute('href', slides[nextSlideIndex].href);
        
        titleEl.classList.remove('opacity-0', 'translate-y-2');
        actionBtnEl.classList.remove('opacity-0', 'translate-y-2');
      }, 250);
      
      for (let i = 0; i < nextSlideIndex; i++) {
        fills[i].style.height = '100%';
      }
      for (let i = nextSlideIndex + 1; i < slides.length; i++) {
        fills[i].style.height = '0%';
      }
      
      currentSlide = nextSlideIndex;
      progress = 0;
    }

    function startCarousel() {
      intervalId = setInterval(() => {
        if (!isPaused) {
          progress += progressStep;
          if (progress >= 100) {
            progress = 0;
            fills[currentSlide].style.height = '100%';
            const next = (currentSlide + 1) % slides.length;
            changeSlide(next);
          } else {
            fills[currentSlide].style.height = `${progress}%`;
          }
        }
      }, stepTime);
    }

    startCarousel();

    if (pauseBtn && pauseIcon && playIcon) {
      pauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        if (isPaused) {
          pauseIcon.classList.add('hidden');
          playIcon.classList.remove('hidden');
        } else {
          pauseIcon.classList.remove('hidden');
          playIcon.classList.add('hidden');
        }
      });
    }

    indicatorBars.forEach((bar) => {
      bar.addEventListener('click', () => {
        const targetIndex = parseInt(bar.getAttribute('data-index') || '0', 10);
        if (targetIndex !== currentSlide) {
          changeSlide(targetIndex);
        }
      });
    });

    const cricketCard = document.getElementById('cricket-tours-card');
    const cricketModal = document.getElementById('cricket-tour-modal');
    const cricketOverlay = document.getElementById('cricket-modal-overlay');
    const closeCricketBtn = document.getElementById('close-cricket-modal');

    if (cricketCard && cricketModal && cricketOverlay && closeCricketBtn) {
      cricketCard.addEventListener('click', () => {
        cricketModal.classList.remove('hidden');
        cricketModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });

      const closeModal = () => {
        cricketModal.classList.add('hidden');
        cricketModal.classList.remove('flex');
        document.body.style.overflow = '';
      };

      cricketOverlay.addEventListener('click', closeModal);
      closeCricketBtn.addEventListener('click', closeModal);
    }

    const constCard = document.getElementById('construction-workers-card');
    const constModal = document.getElementById('construction-job-modal');
    const constOverlay = document.getElementById('construction-modal-overlay');
    const closeConstBtn = document.getElementById('close-construction-modal');

    if (constCard && constModal && constOverlay && closeConstBtn) {
      constCard.addEventListener('click', () => {
        constModal.classList.remove('hidden');
        constModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });

      const closeModal = () => {
        constModal.classList.add('hidden');
        constModal.classList.remove('flex');
        document.body.style.overflow = '';
      };

      constOverlay.addEventListener('click', closeModal);
      closeConstBtn.addEventListener('click', closeModal);
    }
  </script>
