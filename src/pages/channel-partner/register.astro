---
// src/pages/channel-partner/register.astro
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PartnerAuthPortal from '../../components/channel-partner/PartnerAuthPortal';

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('cp_sid')?.value;
if (token) {
  return Astro.redirect('/channel-partner/dashboard');
}
---

<Layout 
  title="Partner Registration | TravlTik Channel Partner Network" 
  description="Register as a Country Partner, State Partner, or Referral Consultant on the TravlTik Channel Partner Platform."
  hideHeader={true}
  hideFooter={true}
>
  <PartnerAuthPortal client:only="react" initialMode="register" />
</Layout>
