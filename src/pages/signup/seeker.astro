---
// src/pages/signup/seeker.astro
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/landing/LandingPage';
import { SignupFlowPortal } from '../../components/interactive/SignupFlowPortal';
---

<Layout 
  title="Sign Up as Seeker - TravlTik" 
  description="Create your traveler account on TravlTik to track applications, consult experts, and manage document filings."
  hideHeader={true}
  hideFooter={true}
  hideWidgets={true}
>
  <!-- Live Background Homepage (Blurred & Semi-Transparent) -->
  <div class="pointer-events-none filter blur-[3px] opacity-75 fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <LandingPage client:only="react" />
  </div>

  <!-- Fixed Seeker Registration Modal Overlay -->
  <SignupFlowPortal client:only="react" initialMode="seeker" />
</Layout>
