---
// src/pages/visa-guide/[country]/[type].astro
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Globe, FileText, Clock, DollarSign, CheckCircle, ArrowRight, Users, Sparkles } from 'lucide-react';

export async function getStaticPaths() {
  // 1. Static fallback data
  const staticVisas = [
    {
      country: "canada",
      type: "express-entry",
      title: "Canada Express Entry",
      flag: "🇨🇦",
      visaType: "Permanent Residence",
      processing: "6-8 months",
      cost: "CAD 1,365",
      requirements: ["Valid passport", "Language test (IELTS/CELPIP)", "Educational Credential Assessment (ECA)", "Police clearance certificate", "Medical examination", "Proof of funds (CAD 13,757+ for single)"],
      documents: ["Passport copies", "IELTS/CELPIP score report", "ECA certificate", "Employment reference letters", "Bank statements (6 months)", "Police clearance"],
      timeline: [{ step: "Create Express Entry profile", time: "1-2 weeks" }, { step: "Receive ITA (Invitation to Apply)", time: "Varies (CRS-dependent)" }, { step: "Submit full application", time: "60 days after ITA" }, { step: "Biometrics", time: "30 days after request" }, { step: "Decision", time: "6-8 months from submission" }]
    },
    {
      country: "usa",
      type: "f1",
      title: "USA F-1 Student Visa",
      flag: "🇺🇸",
      visaType: "Student Visa",
      processing: "3-5 weeks",
      cost: "USD 185 + SEVIS $350",
      requirements: ["I-20 from SEVP-certified school", "Valid passport", "Proof of financial support", "Ties to home country", "English proficiency", "Academic records"],
      documents: ["I-20 form", "DS-160 confirmation", "Passport", "Financial documents", "Academic transcripts", "TOEFL/IELTS scores"],
      timeline: [{ step: "Get I-20 from university", time: "2-4 weeks" }, { step: "Pay SEVIS fee", time: "1 day" }, { step: "Complete DS-160", time: "1 day" }, { step: "Schedule visa interview", time: "1-3 weeks" }, { step: "Attend interview", time: "1 day" }]
    }
  ];

  const paths = staticVisas.map(visa => ({
    params: { country: visa.country, type: visa.type },
    props: { visa, entry: null }
  }));

  // 2. Load Content Collections
  try {
    const guides = await getCollection('visa-guides');
    guides.forEach(entry => {
      const countryParam = entry.data.country.toLowerCase();
      const typeParam = entry.data.visaType.toLowerCase();
      
      // Map frontmatter schema to visual guide structures
      const mappedVisa = {
        country: countryParam,
        type: typeParam,
        title: entry.data.title,
        flag: countryParam === "canada" ? "🇨🇦" : countryParam === "usa" ? "🇺🇸" : "🌎",
        visaType: entry.data.visaType,
        processing: entry.data.processingTime,
        cost: entry.data.fee,
        requirements: entry.data.requirements,
        documents: [
          "Passport bio-data scan",
          "Digital passport size photo",
          "Completed visa application forms",
          ...entry.data.requirements.slice(0, 3)
        ],
        timeline: [
          { step: "Submit Online Application Form", time: "1-2 days" },
          { step: "Document Verification & Filing", time: "3-5 days" },
          { step: "Embassy Processing Window", time: entry.data.processingTime }
        ]
      };

      // Add to paths (avoiding duplicates)
      const exists = paths.some(p => p.params.country === countryParam && p.params.type === typeParam);
      if (!exists) {
        paths.push({
          params: { country: countryParam, type: typeParam },
          props: { visa: mappedVisa, entry }
        });
      }
    });
  } catch (e) {
    console.error("Error reading visa-guides collection:", e);
  }

  return paths;
}

const { country, type } = Astro.params;
const { visa, entry } = Astro.props;

// Compile Content Collection entry if present
const Content = entry ? (await entry.render()).Content : null;

// JSON-LD structured schema for search engines
const schema = {
  "@context": "https://schema.org",
  "@type": "Guide",
  "name": visa.title,
  "description": visa.title + " requirements, documents checklist, processing time and fee guide.",
  "publisher": {
    "@type": "Organization",
    "name": "TravlTik"
  },
  "about": {
    "@type": "Thing",
    "name": visa.visaType + " for " + visa.country.toUpperCase()
  }
};
---

<Layout 
  title={`${visa.title} Official Guide`} 
  description={`${visa.title} complete requirements, required documents scan list, application processing fee (${visa.cost}) and step-by-step timeline details.`}
>
  <!-- SEO Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="bg-white min-h-screen pb-24">
      {/* ── DYNAMIC LUXURY HERO BANNER (MATCHES THE 1ST PHOTO STRUCTURE) ── */}
      <div class="max-w-6xl mx-auto px-4 pt-8 pb-6">
          <div 
              className="relative w-full rounded-[40px] overflow-hidden flex flex-col items-center justify-center text-center px-6 py-20 min-h-[440px] shadow-2xl border border-white/10"
              style={{ background: '#0C1A2E' }}
          >
              {/* Background Image with Dark Purple/Violet Gradient Overlay */}
              <div className="absolute inset-0 z-0">
                  <img 
                      src="https://images.unsplash.com/photo-1506461883276-594a12b11cf3?w=1600&auto=format&fit=crop&q=80" 
                      alt="Twilight Petronas Towers" 
                      className="w-full h-full object-cover brightness-[0.7] contrast-[1.05]"
                  />
                  <div 
                      className="absolute inset-0 bg-gradient-to-b from-[#2E1A33]/70 via-[#0C1A2E]/80 to-[#0C1A2E]/90" 
                  />
              </div>

              {/* Banner Content */}
              <div className="relative z-10 max-w-2xl mx-auto flex flex-col items-center">
                  
                  {/* Flag Circular Badge */}
                  <div className="w-12 h-12 bg-white/10 backdrop-blur-md rounded-full border border-white/25 flex items-center justify-center text-2xl shadow-xl mb-4">
                      {visa.flag}
                  </div>

                  {/* Main Serif Header */}
                  <h1 className="font-serif text-3xl md:text-4xl lg:text-5xl font-normal text-white leading-tight tracking-wide mb-2 drop-shadow-md">
                      {visa.title} Guide
                  </h1>

                  {/* Bright Green Accent Highlight */}
                  <p className="text-[#00FF66] font-serif text-2xl md:text-3xl font-bold mb-8 tracking-wide drop-shadow-md">
                      in exactly 10 minutes
                  </p>

                  {/* 3-Column Metadata Row */}
                  <div className="grid grid-cols-3 gap-8 md:gap-16 text-center mb-10 w-full max-w-lg">
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">VALID</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.processing}</span>
                      </div>
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">PURPOSE</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.visaType}</span>
                      </div>
                      <div>
                          <span className="text-[9px] text-gray-400 font-bold uppercase tracking-wider block mb-1">MAX STAY</span>
                          <span className="text-[11px] text-white font-extrabold tracking-wide uppercase block">{visa.cost}</span>
                      </div>
                  </div>

                  {/* Pill CTA Button */}
                  <a href={`/apply-visa?country=${visa.country}`} class="inline-block">
                      <button className="bg-white hover:bg-slate-100 text-slate-900 font-bold text-sm px-8 py-3.5 rounded-full transition-all duration-300 transform hover:scale-[1.02] shadow-xl tracking-wider active:scale-[0.98] select-none">
                          Start New Application
                      </button>
                  </a>
              </div>
          </div>
      </div>

      {/* ── TAB NAVIGATION MENU ── */}
      <div class="border-b border-gray-150 sticky top-16 bg-white z-40 shadow-sm mb-8">
          <div class="max-w-4xl mx-auto px-4 flex justify-between sm:justify-start gap-4 md:gap-8 overflow-x-auto py-1">
              {[
                  { id: "visa-info", label: "Visa Info" },
                  { id: "documents", label: "Documents" },
                  { id: "visa-process", label: "Visa Process" },
                  { id: "reviews", label: "Reviews" },
                  { id: "faqs", label: "FAQs" }
              ].map((tab, idx) => (
                  <button
                      id={`tab-btn-${tab.id}`}
                      class={`tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap ${
                          idx === 0 ? "border-slate-900 text-slate-900 font-black" : "border-transparent text-gray-400 hover:text-slate-800"
                      }`}
                      onclick={`switchTab('${tab.id}')`}
                  >
                      {tab.label}
                  </button>
              ))}
          </div>
      </div>

      {/* ── DYNAMIC SECTIONS CONTENT CONTAINER ── */}
      <div class="max-w-4xl mx-auto px-4">
          
          {/* TAB 1: Visa Info */}
          <div id="sec-visa-info" class="tab-section space-y-6">
              {Content && (
                  <article class="prose max-w-none bg-white rounded-3xl border border-gray-150 p-8 shadow-sm prose-slate prose-headings:font-sans prose-headings:text-navy prose-h1:text-2xl prose-h2:text-xl prose-p:text-sm prose-p:leading-relaxed">
                      <Content />
                  </article>
              )}

              {/* Requirements Grid */}
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <CheckCircle class="w-5 h-5 text-slate-800" /> Requirements Checklist
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {visa.requirements.map((r: string, i: number) => (
                          <div key={i} class="flex items-start gap-2.5 p-3.5 bg-gray-50/50 border border-gray-100 rounded-2xl">
                              <CheckCircle class="w-4 h-4 text-slate-800 mt-0.5 shrink-0" />
                              <span class="text-xs text-gray-700 font-semibold leading-relaxed">{r}</span>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 2: Documents */}
          <div id="sec-documents" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <FileText class="w-5 h-5 text-slate-850" /> Mandatory Document Scan Checklist
                  </h2>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                      {visa.documents.map((d: string, i: number) => (
                          <div key={i} class="flex items-center gap-3 p-3.5 bg-gray-50/50 border border-gray-100 rounded-2xl">
                              <FileText class="w-4 h-4 text-slate-800 shrink-0" />
                              <span class="text-xs text-gray-700 font-bold leading-normal">{d}</span>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 3: Visa Process */}
          <div id="sec-visa-process" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5 flex items-center gap-2">
                      <Clock class="w-5 h-5 text-slate-850" /> Step-by-Step Application Timeline
                  </h2>
                  <div class="space-y-4">
                      {visa.timeline.map((t: any, i: number) => (
                          <div key={i} class="flex items-start gap-4">
                              <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center text-xs font-black shadow-md shrink-0">
                                  {i + 1}
                              </div>
                              <div class="flex-1 pb-4 border-b border-gray-100 last:border-0">
                                  <h4 class="font-sans font-bold text-navy text-xs sm:text-sm">{t.step}</h4>
                                  <p class="text-[10px] text-gray-400 mt-1 font-bold">{t.time}</p>
                              </div>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 4: Reviews */}
          <div id="sec-reviews" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5">User Experiences & Reviews</h2>
                  <div class="space-y-4">
                      {[
                          { name: "Aarav Mehta", rating: 5, quote: "Extremely fast guide, application took less than 10 minutes as advertised. Highly professional support!" },
                          { name: "Priya Sharma", rating: 5, quote: "Clear checklist, helped me filter out unnecessary documentation files. Recommending to my circles." }
                      ].map((rev, i) => (
                          <div key={i} class="p-4 bg-gray-55/40 border border-gray-100 rounded-2xl">
                              <div class="flex items-center justify-between mb-2">
                                  <span class="text-xs font-bold text-slate-800">{rev.name}</span>
                                  <span class="text-amber-500 text-xs">{"★".repeat(rev.rating)}</span>
                              </div>
                              <p class="text-xs text-gray-500 italic">"{rev.quote}"</p>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* TAB 5: FAQs */}
          <div id="sec-faqs" class="tab-section hidden space-y-6">
              <section class="bg-white rounded-3xl border border-gray-150 p-6 shadow-sm">
                  <h2 class="font-sans text-xl font-bold text-navy mb-5">Frequently Asked Questions</h2>
                  <div class="space-y-4">
                      {[
                          { q: "Is the processing time guaranteed?", a: "Processing windows are average estimations based on real-time historical applications." },
                          { q: "Do I need to visit the embassy physically?", a: "No, this guide details a 100% online process with digital slot booking support." }
                      ].map((faq, i) => (
                          <div key={i} class="pb-3 border-b border-gray-100 last:border-0">
                              <h4 class="font-bold text-xs sm:text-sm text-navy mb-1">{faq.q}</h4>
                              <p class="text-xs text-gray-500">{faq.a}</p>
                          </div>
                      ))}
                  </div>
              </section>
          </div>

          {/* Expert Call CTA */}
          <div class="text-center mt-10 bg-gradient-to-b from-gray-50 to-transparent p-8 rounded-3xl border border-gray-150">
              <span class="bg-slate-900/10 text-slate-800 text-[9px] font-black tracking-widest px-3 py-1 rounded-full mb-3 inline-block">Professional Assistance</span>
              <h3 class="font-sans text-xl font-bold text-navy mb-2">Need Help Filing Your Application?</h3>
              <p class="text-xs text-gray-500 max-w-md mx-auto mb-6">Connect with vetted visa experts, verified migration lawyers, and dedicated case officers.</p>
              <a href={`/apply-visa?country=${visa.country}`} class="inline-block">
                  <button class="bg-black hover:bg-slate-900 text-white px-8 py-3.5 rounded-2xl font-bold text-xs tracking-wider flex items-center gap-2 transition-all">
                      <Users class="w-4 h-4" /> Connect with {visa.title} Experts <ArrowRight class="w-4 h-4" />
                  </button>
              </a>
          </div>

      </div>
  </div>

  <script is:inline>
      function switchTab(tabId) {
          // Hide all sections
          document.querySelectorAll('.tab-section').forEach(sec => {
              sec.classList.add('hidden');
          });
          // Show active section
          const target = document.getElementById('sec-' + tabId);
          if (target) target.classList.remove('hidden');

          // Reset tab button states
          document.querySelectorAll('.tab-link').forEach(btn => {
              btn.className = "tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap border-transparent text-gray-400 hover:text-slate-800";
          });
          // Set active tab button state
          const btn = document.getElementById('tab-btn-' + tabId);
          if (btn) {
              btn.className = "tab-link py-4 px-2 text-xs sm:text-sm font-bold tracking-wide transition-all border-b-2 outline-none whitespace-nowrap border-slate-900 text-slate-900 font-black";
          }
      }
  </script>
</Layout>
