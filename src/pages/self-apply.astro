---
// src/pages/self-apply.astro
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/landing/LandingPage';

const razorpayKeyId = process.env.RAZORPAY_KEY_ID || import.meta.env.NEXT_PUBLIC_RAZORPAY_KEY_ID || 'dummy_razorpay_key';
---

<Layout title="Self Apply — Your Visa, Your Way" description="Fill your application yourself. Get AI-powered suggestions and add our services if you need help." hideHeader={true} hideFooter={true}>
  <script src="https://checkout.razorpay.com/v1/checkout.js" is:inline></script>
  <div id="razorpay-config" data-key={razorpayKeyId} style="display: none;"></div>
  <!-- CSS Styles directly copied from source -->
  <style is:inline>
    :root {
      --white: #FFFFFF;
      --black: #0C1A2E;
      --primary: #00a896;
      --primary-dark: #008f80;
      --primary-light: #e6f7f5;
      --primary-border: #b2e5df;
      --gray-50: #F8FAFC;
      --gray-100: #F1F5F9;
      --gray-200: #E2E8F0;
      --gray-300: #CBD5E1;
      --gray-400: #94A3B8;
      --gray-500: #64748B;
      --gray-600: #475569;
      --gray-700: #334155;
      --gray-800: #1E293B;
      --gray-900: #0F172A;
      --green: #00a896;
      --grlt: #e6f7f5;
      --border: #E2E8F0;
      --radius: 16px;
      --pill: 999px;
      --shadow: 0 4px 20px rgba(0, 168, 150, 0.08);
      --shadow-hover: 0 12px 36px rgba(0, 168, 150, 0.16);
      --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .self-apply-body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--gray-50);
      color: var(--black);
      line-height: 1.6;
      position: relative;
    }

    .self-apply-body h1, .self-apply-body h2, .self-apply-body h3, .self-apply-body h4 {
      font-family: 'Sora', sans-serif;
    }

    @keyframes shake {
      0%   { transform: translateX(0); }
      20%  { transform: translateX(-8px); }
      40%  { transform: translateX(8px); }
      60%  { transform: translateX(-6px); }
      80%  { transform: translateX(6px); }
      100% { transform: translateX(0); }
    }

    /* Back Home Button style */
    .back-home-btn {
      position: absolute;
      top: 24px;
      left: 24px;
      z-index: 100;
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      color: var(--black);
      padding: 8px 16px;
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition);
      box-shadow: var(--shadow);
    }

    .back-home-btn:hover {
      border-color: var(--black);
      transform: translateY(-1px);
      box-shadow: var(--shadow-hover);
    }

    .self-apply-container {
      max-width: 100%;
      margin: 0 auto;
      padding: 24px 28px;
    }

    /* Hero */
    .self-apply-hero {
      text-align: center;
      padding: 44px 24px 36px;
      background: linear-gradient(135deg, #3b0764 0%, #581c87 45%, #6b21a8 75%, #00a896 100%);
      color: #FFFFFF;
      position: relative;
      overflow: hidden;
    }

    .self-apply-hero h1 {
      font-size: 38px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 10px;
      letter-spacing: -0.02em;
    }

    .self-apply-hero h1 span {
      color: #00a896;
      text-decoration: underline;
      text-decoration-color: #00a896;
      text-underline-offset: 6px;
    }

    .self-apply-hero p {
      font-size: 15px;
      color: #94A3B8;
      max-width: 520px;
      margin: 0 auto 20px;
      font-weight: 500;
    }

    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(0, 168, 150, 0.15);
      border: 1px solid rgba(0, 168, 150, 0.35);
      border-radius: var(--pill);
      padding: 6px 18px;
      font-size: 12px;
      font-weight: 700;
      color: #2dd4bf;
      margin-bottom: 18px;
    }

    .trust-badge .dot {
      width: 7px;
      height: 7px;
      background: #00a896;
      border-radius: 50%;
      box-shadow: 0 0 10px #00a896;
      animation: pulse-dot 2s infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .5; transform: scale(.7); }
    }

    .stats-row {
      display: flex;
      justify-content: center;
      gap: 36px;
      flex-wrap: wrap;
      margin-top: 16px;
    }

    .stats-row .item {
      text-align: center;
    }

    .stats-row .item .num {
      font-weight: 800;
      font-size: 22px;
      color: #00a896;
    }

    .stats-row .item .label {
      font-size: 12px;
      color: #94A3B8;
      font-weight: 600;
    }

    /* Step Indicator */
    .step-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 28px 0 32px;
      max-width: 600px;
      margin: 0 auto;
    }

    .step-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .step-dot {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 800;
      z-index: 1;
      transition: all var(--transition);
      cursor: pointer;
      border: 2px solid var(--gray-200);
      color: var(--gray-400);
      background: var(--white);
    }

    .step-dot.active {
      border-color: #00a896;
      color: #00a896;
      box-shadow: 0 0 0 4px rgba(0, 168, 150, 0.18);
    }

    .step-dot.done {
      background: #00a896;
      border-color: #00a896;
      color: var(--white);
    }

    .step-line {
      flex: 1;
      height: 2px;
      margin: 0;
      background: var(--gray-200);
      transition: background var(--transition);
    }

    .step-line.done {
      background: #00a896;
    }

    .step-label {
      font-size: 10px;
      font-weight: 600;
      color: var(--gray-400);
      text-align: center;
      margin-top: 5px;
      line-height: 1.3;
      transition: color var(--transition);
    }

    .step-dot.active + .step-label,
    .step-dot.done + .step-label {
      color: var(--black);
    }

    /* Progress Bar */
    .progress-wrapper {
      margin-bottom: 24px;
    }

    .progress-track {
      background: var(--gray-200);
      border-radius: var(--pill);
      height: 6px;
      overflow: hidden;
    }

    .progress-fill {
      height: 6px;
      border-radius: var(--pill);
      background: #00a896;
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      width: 25%;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--gray-500);
      margin-top: 6px;
    }

    /* Step Content - Smooth Transitions */
    .step-content {
      display: none;
      opacity: 0;
      transform: translateX(30px);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .step-content.active {
      display: block;
      animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .step-content.exit {
      display: block;
      animation: slideOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes slideIn {
      0% { opacity: 0; transform: translateX(30px); }
      100% { opacity: 1; transform: translateX(0); }
    }

    @keyframes slideOut {
      0% { opacity: 1; transform: translateX(0); }
      100% { opacity: 0; transform: translateX(-30px); }
    }

    /* Country Grid */
    .country-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin: 16px 0 24px;
    }

    .country-card {
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 16px 12px;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition);
    }

    .country-card:hover {
      border-color: #00a896;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 168, 150, 0.15);
    }

    .country-card.selected {
      border-color: #00a896;
      background: rgba(0, 168, 150, 0.06);
      box-shadow: 0 0 0 3px rgba(0, 168, 150, 0.15);
    }

    .country-card.selected .name {
      color: #00a896;
    }

    .country-card .flag {
      font-size: 28px;
      margin-bottom: 4px;
    }

    .country-card .name {
      font-weight: 700;
      font-size: 13px;
      color: var(--black);
    }

    .country-card .visa-types {
      font-size: 11px;
      color: var(--gray-400);
      margin-top: 2px;
    }

    .country-card .badge {
      display: inline-block;
      font-size: 9px;
      font-weight: 800;
      color: var(--white);
      background: #00a896;
      padding: 2px 8px;
      border-radius: var(--pill);
      margin-top: 4px;
    }

    /* Visa Type Pills */
    .visa-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 12px 0 20px;
    }

    .visa-pill {
      padding: 8px 18px;
      border: 1.5px solid var(--gray-200);
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 700;
      color: var(--gray-600);
      cursor: pointer;
      background: var(--white);
      transition: all var(--transition);
    }

    .visa-pill:hover {
      border-color: #00a896;
      color: #00a896;
    }

    .visa-pill.selected {
      background: #00a896;
      color: var(--white);
      border-color: #00a896;
      box-shadow: 0 4px 14px rgba(0, 168, 150, 0.25);
    }

    /* Form */
    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 700;
      color: var(--gray-700);
      margin-bottom: 4px;
    }

    .form-group input {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--gray-200);
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--black);
      background: var(--white);
      outline: none;
      transition: all var(--transition);
    }

    .form-group input:focus {
      border-color: #00a896;
      box-shadow: 0 0 0 3px rgba(0, 168, 150, 0.12);
    }

    .form-group input::placeholder {
      color: var(--gray-400);
    }

    /* Custom Dropdown styling */
    .custom-select-container {
      position: relative;
      width: 100%;
    }

    .custom-select-trigger {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--gray-200);
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      color: var(--black);
      background: var(--white);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all var(--transition);
      user-select: none;
    }

    .custom-select-trigger:hover,
    .custom-select-container.open .custom-select-trigger {
      border-color: #00a896;
    }

    .custom-select-options {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      width: 100%;
      background: var(--white);
      border: 1.5px solid #00a896;
      border-radius: 10px;
      box-shadow: var(--shadow-hover);
      z-index: 150;
      display: none;
      max-height: 200px;
      overflow-y: auto;
    }

    .custom-select-container.open .custom-select-options {
      display: block;
    }

    .custom-option {
      padding: 10px 14px;
      font-size: 14px;
      font-weight: 600;
      color: var(--black);
      cursor: pointer;
      transition: all var(--transition);
      user-select: none;
    }

    .custom-option:hover {
      background-color: #00a896 !important;
      color: var(--white) !important;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* Upload Zone */
    .upload-zone {
      border: 2px dashed var(--gray-300);
      border-radius: var(--radius);
      padding: 28px 20px;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition);
      background: var(--gray-50);
      margin-bottom: 16px;
    }

    .upload-zone:hover {
      border-color: #00a896;
      background: rgba(0, 168, 150, 0.03);
    }

    .upload-zone .icon {
      font-size: 32px;
      margin-bottom: 6px;
    }

    .upload-zone .title {
      font-weight: 700;
      font-size: 14px;
      color: var(--black);
    }

    .upload-zone .sub {
      font-size: 12px;
      color: var(--gray-400);
    }

    .upload-zone .extracted {
      margin-top: 10px;
      padding: 10px 14px;
      background: var(--grlt);
      border-radius: 8px;
      font-size: 13px;
      color: #00a896;
      font-weight: 700;
      display: none;
    }

    .upload-zone .extracted.show {
      display: block;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 12px 26px;
      border: none;
      border-radius: 12px;
      font-weight: 800;
      font-size: 14px;
      cursor: pointer;
      transition: all var(--transition);
    }

    .btn-primary {
      background: #00a896;
      color: var(--white);
    }

    .btn-primary:hover {
      background: #008f80;
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(0, 168, 150, 0.3);
    }

    .btn-secondary {
      background: var(--white);
      color: var(--black);
      border: 1.5px solid var(--gray-200);
    }

    .btn-secondary:hover {
      border-color: #00a896;
      color: #00a896;
    }

    .btn-sm {
      padding: 6px 14px;
      font-size: 12px;
    }

    .btn-block {
      width: 100%;
      justify-content: center;
    }

    .btn-group {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      justify-content: space-between;
    }

    /* Service Cards */
    .service-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 16px 0;
    }

    .service-card {
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 18px 16px;
      transition: all var(--transition);
      cursor: pointer;
    }

    .service-card:hover {
      border-color: var(--black);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .service-card.selected {
      border-color: var(--black);
      background: var(--gray-50);
    }

    .service-card .icon {
      font-size: 28px;
      margin-bottom: 6px;
    }

    .service-card .title {
      font-weight: 700;
      font-size: 15px;
      color: var(--black);
    }

    .service-card .desc {
      font-size: 12px;
      color: var(--gray-500);
      margin: 4px 0 8px;
    }

    .service-card .price {
      font-weight: 800;
      font-size: 16px;
      color: var(--black);
    }

    .service-card .price span {
      font-weight: 400;
      font-size: 12px;
      color: var(--gray-400);
    }

    .service-card .add-btn {
      margin-top: 10px;
      padding: 4px 14px;
      font-size: 12px;
      font-weight: 600;
      border: 1.5px solid var(--gray-200);
      border-radius: var(--pill);
      background: var(--white);
      cursor: pointer;
      transition: all var(--transition);
    }

    .service-card .add-btn:hover {
      border-color: var(--black);
    }

    .service-card .add-btn.added {
      background: var(--black);
      color: var(--white);
      border-color: var(--black);
    }

    .service-card.free-card {
      border-color: var(--gray-300);
      background: var(--gray-50);
    }

    /* Order Summary */
    .order-summary {
      background: var(--gray-50);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 20px 24px;
      margin: 16px 0;
    }

    .order-summary .row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 14px;
    }

    .order-summary .row.total {
      font-weight: 700;
      font-size: 16px;
      border-top: 2px solid var(--gray-200);
      padding-top: 10px;
      margin-top: 4px;
    }

    .order-summary .escrow {
      font-size: 12px;
      color: var(--green);
      font-weight: 600;
      text-align: center;
      margin-top: 8px;
    }

    /* Success */
    .success-screen {
      text-align: center;
      padding: 32px 0;
    }

    .success-screen .icon {
      font-size: 56px;
      margin-bottom: 12px;
    }

    .success-screen h2 {
      font-size: 28px;
      font-weight: 800;
      color: var(--black);
      margin-bottom: 4px;
    }

    .success-screen .ref {
      font-size: 14px;
      color: var(--gray-500);
      background: var(--gray-100);
      padding: 8px 16px;
      border-radius: 8px;
      display: inline-block;
      margin: 8px 0 16px;
    }

    .success-screen .next-steps {
      text-align: left;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 20px 24px;
      max-width: 480px;
      margin: 16px auto;
    }

    .success-screen .next-steps li {
      list-style: none;
      padding: 6px 0;
      font-size: 13px;
      color: var(--gray-600);
      border-bottom: 1px solid var(--gray-100);
    }

    .success-screen .next-steps li:last-child {
      border-bottom: none;
    }

    .success-screen .next-steps li::before {
      content: '✅ ';
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--black);
      color: var(--white);
      padding: 11px 22px;
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 600;
      z-index: 999;
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      white-space: nowrap;
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .toast.on {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .self-apply-container { padding: 20px 16px; }
      .self-apply-hero h1 { font-size: 28px; }
      .form-row { grid-template-columns: 1fr; }
      .service-grid { grid-template-columns: 1fr; }
      .country-grid { grid-template-columns: 1fr 1fr; }
      .stats-row { gap: 16px; }
      .step-indicator { padding: 16px 0; }
      .btn-group { flex-direction: column-reverse; gap: 8px; }
      .btn-group .btn { width: 100%; justify-content: center; }
      .order-summary { padding: 16px; }
      .success-screen h2 { font-size: 22px; }
    }

    @media (max-width: 480px) {
      .country-grid { grid-template-columns: 1fr; }
      .visa-pills { gap: 4px; }
      .visa-pill { padding: 6px 12px; font-size: 12px; }
    }
  </style>

  <!-- Main Home Page rendered in the background (blurred) -->
  <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
    <LandingPage client:only="react" />
  </div>

  <!-- Dark Overlay with backdrop blur -->
  <div class="fixed inset-0 z-10 bg-slate-900/50 backdrop-blur-sm pointer-events-none"></div>

  <!-- Toast -->
  <div class="toast" id="toast">Message</div>

  <!-- Self Apply Registration Wizard Modal Box -->
  <div class="fixed inset-0 z-30 overflow-y-auto pointer-events-auto">
    <div class="flex min-h-full items-center justify-center px-3 py-6 sm:px-4 sm:py-12">
      <div class="w-full max-w-4xl bg-white rounded-3xl shadow-2xl border border-slate-200/90 overflow-hidden relative font-plus-jakarta my-auto">

        <!-- ========== HERO HEADER ========== -->
        <section class="self-apply-hero relative">
          <!-- Close / Back to Home Button -->
          <a href="/" class="absolute top-4 right-4 text-white/80 hover:text-white bg-white/15 hover:bg-white/25 p-2 rounded-full transition cursor-pointer z-20" title="Close / Back to Home">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
          </a>

          <div class="trust-badge">
            <div class="dot"></div>
            ✈️ Apply online directly. No expert required.
          </div>
          <h1 className="text-2xl sm:text-3xl font-extrabold text-white">Self Apply — <span class="text-teal-300 underline decoration-teal-300 underline-offset-4">Your Visa, Your Way</span></h1>
          <p class="text-purple-100 text-xs sm:text-sm max-w-md mx-auto mt-2 font-medium">Fill your application yourself. Get AI-powered suggestions and add our services if you need help.</p>
          <div class="stats-row mt-4">
            <div class="item"><div class="num text-teal-300">500+</div><div class="label text-purple-200">Applications Today</div></div>
            <div class="item"><div class="num text-teal-300">98%</div><div class="label text-purple-200">Approval Rate</div></div>
            <div class="item"><div class="num text-teal-300">24hr</div><div class="label text-purple-200">Avg Processing</div></div>
          </div>
        </section>

        <!-- ========== MAIN CONTAINER ========== -->
        <div class="self-apply-container">

      <!-- ===== STEP INDICATOR ===== -->
      <div class="step-indicator" id="stepIndicator">
        <div class="step-item">
          <div class="step-dot active" data-step="1">1</div>
          <div class="step-label">Select Visa</div>
        </div>
