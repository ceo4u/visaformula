---
// src/pages/list-practice.astro
import Layout from '../layouts/Layout.astro';
import { Shield, Globe, Users, Star, ArrowRight, Zap, CheckCircle2, Lock, Calendar, MessageSquare, BarChart3 } from 'lucide-react';

const stats = [
    { value: "50K+", label: "Active Visa Seekers", icon: Users },
    { value: "₹10 Cr+", label: "Consultation volume transacted", icon: BarChart3 },
    { value: "99.2%", label: "Client satisfaction rate", icon: Star },
    { value: "120+", label: "Destinations Supported", icon: Globe },
];

const benefits = [
    {
        title: "Global Client Pipeline",
        description: "Receive consulting requests from applicants globally searching for student, work, PR, and travel visas for USA, Canada, UK, Schengen, and Australia.",
        icon: Globe,
    },
    {
        title: "Escrow-Protected Payments",
        description: "Never worry about invoicing or client collections. Fees are collected in advance and held in secure escrow, released automatically upon service completion.",
        icon: Shield,
    },
    {
        title: "All-in-One Case Panel",
        description: "Schedule consultations, share document checklist indicators, message clients, upload applications, and track earnings using our unified dashboard.",
        icon: Calendar,
    },
];

const steps = [
    {
        num: "01",
        title: "Create Your Profile",
        desc: "Register your consulting firm or solo practice, select your visa specialty tags, and upload your professional credentials."
    },
    {
        num: "02",
        title: "Set Your Rates & Slots",
        desc: "Define your custom consultation prices and sync your calendar availability for client bookings."
    },
    {
        num: "03",
        title: "Conduct Consultations",
        desc: "Accept booking requests with secure escrow deposits, meet clients via video, and assist them with files."
    },
    {
        num: "04",
        title: "Collect Direct Payouts",
        desc: "Once a milestone or consultation session completes, funds are immediately released directly to your bank account."
    }
];

const faqs = [
    {
        q: "Are there any upfront listing fees?",
        a: "No, listing your practice on TravlTik is completely free. We only charge a small performance commission on successful consultation payouts."
    },
    {
        q: "How does the escrow security work?",
        a: "When a seeker books your slot, they pay upfront. The payment is safely locked in our TravlTik Escrow. Once the session or document check completes, the funds are instantly released to you."
    },
    {
        q: "What credentials do I need to supply?",
        a: "We verify active legal bar memberships, RCIC certifications, MARA registrations, or general professional backgrounds to ensure our clients receive top-tier support."
    }
];
---

<Layout 
    title="List Your Practice — Grow Your Immigration Business" 
    description="Join the world's leading immigration marketplace. List your visa practice, connect with pre-screened clients globally, and secure bookings."
>
    <div class="bg-white min-h-screen pb-24 font-sans">
        
        <!-- HERO SECTION -->
        <section class="relative text-white py-36 px-4 overflow-hidden border-b border-slate-950">
            <!-- Full-bleed background -->
            <div class="absolute inset-0 z-0">
                <img
                    src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1800&auto=format&fit=crop&q=80"
                    alt="Professional boardroom setup representing high-end legal consultation"
                    class="w-full h-full object-cover"
                />
                <!-- Deep premium monochrome dark gradient overlay -->
                <div class="absolute inset-0 bg-gradient-to-b from-slate-900/90 via-slate-950/85 to-black/95"></div>
                <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_30%,rgba(239,68,68,0.05),transparent_60%)]"></div>
            </div>

            <!-- Content -->
            <div class="max-w-4xl mx-auto text-center relative z-10">
                <span class="bg-white/10 text-red-400 text-[10px] font-bold tracking-widest px-3.5 py-1.5 rounded-full border border-white/20 mb-5 inline-block backdrop-blur-md">
                    💼 For Immigration & Visa Experts
                </span>
                <h1 class="font-sora text-4xl sm:text-5xl md:text-6xl font-extrabold mb-5 leading-tight tracking-tight text-white">
                    Grow Your Practice.<br /><span class="bg-gradient-to-r from-red-400 to-rose-500 bg-clip-text text-transparent">Reach Clients Globally.</span>
                </h1>
                <p class="text-white/80 text-base sm:text-lg md:text-xl max-w-2xl mx-auto leading-relaxed font-medium mb-8">
                    Connect with thousands of visa seekers searching for verified consultants, immigration lawyers, and documentation experts. 
                </p>
                <div class="flex justify-center">
                    <a href="/signup/expert" class="bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white font-bold text-xs px-8 py-4 rounded-xl transition-all shadow-lg hover:shadow-red-500/20 active:scale-95 flex items-center gap-2">
                        Register Your Practice <ArrowRight class="w-4 h-4" />
                    </a>
                </div>
            </div>
        </section>

        <!-- STATS SECTION -->
        <section class="max-w-5xl mx-auto px-4 -mt-12 relative z-20 mb-20">
            <div class="bg-white border border-slate-100 rounded-3xl p-8 shadow-xl grid grid-cols-2 md:grid-cols-4 gap-8">
                {stats.map(stat => {
                    const IconComponent = stat.icon;
                    return (
                        <div class="text-center space-y-2">
                            <div class="flex justify-center">
                                <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center border border-slate-100">
                                    <IconComponent class="w-5 h-5 text-black" />
                                </div>
                            </div>
                            <div class="font-sora font-extrabold text-navy text-2xl md:text-3xl">{stat.value}</div>
                            <div class="text-[10px] font-bold text-gray-400 tracking-wider">{stat.label}</div>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- KEY BENEFITS -->
        <section class="max-w-5xl mx-auto px-4 py-8 mb-20">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-[10px] font-black text-red-500 tracking-widest block mb-1">TravlTik Benefits</span>
                <h2 class="font-sora font-extrabold text-navy text-3xl">Designed to Scale Your Business</h2>
                <p class="text-xs text-gray-400 mt-1">We provide the technical infrastructure so you can focus on legal consultations.</p>
            </div>
            
            <div class="grid md:grid-cols-3 gap-8">
                {benefits.map(benefit => {
                    const IconComponent = benefit.icon;
                    return (
                        <div class="bg-white rounded-3xl border border-slate-100 p-8 shadow-sm hover:shadow-md transition-all text-center space-y-4">
                            <div class="w-14 h-14 rounded-full bg-slate-50 flex items-center justify-center mx-auto border border-slate-100">
                                <IconComponent class="w-6 h-6 text-black" />
                            </div>
                            <h3 class="font-sora font-bold text-navy text-base">{benefit.title}</h3>
                            <p class="text-xs text-gray-500 leading-relaxed font-medium">{benefit.description}</p>
                        </div>
                    );
                })}
            </div>
        </section>

        <!-- HOW IT WORKS -->
        <section class="bg-slate-50/50 border-y border-slate-100 py-20 px-4 mb-20">
            <div class="max-w-5xl mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <span class="text-[10px] font-black text-red-500 tracking-widest block mb-1">Steps</span>
                    <h2 class="font-sora font-extrabold text-navy text-3xl">How It Works</h2>
                    <p class="text-xs text-gray-400 mt-1">Four simple steps to connect with global clients and start consulting.</p>
                </div>
                
                <div class="grid md:grid-cols-4 gap-6">
                    {steps.map(step => (
                        <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm space-y-3 relative overflow-hidden group">
                            <div class="text-3xl font-black text-slate-100 group-hover:text-red-50 transition-colors absolute top-3 right-3">{step.num}</div>
                            <h3 class="font-sora font-bold text-navy text-sm pt-4">{step.title}</h3>
                            <p class="text-xs text-gray-500 leading-relaxed font-medium">{step.desc}</p>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- FAQs -->
        <section class="max-w-3xl mx-auto px-4 py-8 mb-20">
            <div class="text-center mb-12">
                <span class="text-[10px] font-black text-red-500 tracking-widest block mb-1">FAQ</span>
                <h2 class="font-sora font-extrabold text-navy text-3xl">Frequently Asked Questions</h2>
            </div>
            
            <div class="space-y-6">
                {faqs.map(faq => (
                    <div class="bg-white rounded-2xl border border-slate-100 p-6 shadow-sm">
                        <h3 class="font-sora font-bold text-navy text-sm mb-2">❓ {faq.q}</h3>
                        <p class="text-xs text-gray-500 leading-relaxed font-medium">{faq.a}</p>
                    </div>
                ))}
            </div>
        </section>

        <!-- CLOSING CTA -->
        <section class="max-w-5xl mx-auto px-4">
            <div class="bg-black text-white rounded-3xl p-12 text-center relative overflow-hidden shadow-2xl border border-slate-900">
                <div class="absolute -right-16 -bottom-16 w-48 h-48 bg-white/5 rounded-full blur-3xl"></div>
                <div class="relative z-10 max-w-xl mx-auto space-y-6">
                    <h2 class="font-sora font-extrabold text-2xl md:text-3xl leading-tight">Ready to Grow Your Global Practice?</h2>
                    <p class="text-xs text-white/75 leading-relaxed max-w-md mx-auto font-medium">
                        Join verified immigration experts, consult international applicants, and handle casework securely.
                    </p>
                    <div class="flex justify-center pt-2">
                        <a href="/signup/expert" class="bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white font-bold text-xs px-8 py-3.5 rounded-xl transition-all shadow-md active:scale-95 flex items-center gap-1.5">
                            Register Your Practice Today <ArrowRight class="w-4 h-4" />
                        </a>
                    </div>
                </div>
            </div>
        </section>

    </div>
</Layout>
