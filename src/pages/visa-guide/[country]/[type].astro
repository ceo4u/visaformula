---
// src/pages/visa-guide/[country]/[type].astro
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Globe, FileText, Clock, DollarSign, CheckCircle, ArrowRight, Users, Sparkles } from 'lucide-react';

export async function getStaticPaths() {
  // 1. Static fallback data
  const staticVisas = [
    {
      country: "canada",
      type: "express-entry",
      title: "Canada Express Entry",
      flag: "🇨🇦",
      visaType: "Permanent Residence",
      processing: "6-8 months",
      cost: "CAD 1,365",
      requirements: ["Valid passport", "Language test (IELTS/CELPIP)", "Educational Credential Assessment (ECA)", "Police clearance certificate", "Medical examination", "Proof of funds (CAD 13,757+ for single)"],
      documents: ["Passport copies", "IELTS/CELPIP score report", "ECA certificate", "Employment reference letters", "Bank statements (6 months)", "Police clearance"],
      timeline: [{ step: "Create Express Entry profile", time: "1-2 weeks" }, { step: "Receive ITA (Invitation to Apply)", time: "Varies (CRS-dependent)" }, { step: "Submit full application", time: "60 days after ITA" }, { step: "Biometrics", time: "30 days after request" }, { step: "Decision", time: "6-8 months from submission" }]
    },
    {
      country: "usa",
      type: "f1",
      title: "USA F-1 Student Visa",
      flag: "🇺🇸",
      visaType: "Student Visa",
      processing: "3-5 weeks",
      cost: "USD 185 + SEVIS $350",
      requirements: ["I-20 from SEVP-certified school", "Valid passport", "Proof of financial support", "Ties to home country", "English proficiency", "Academic records"],
      documents: ["I-20 form", "DS-160 confirmation", "Passport", "Financial documents", "Academic transcripts", "TOEFL/IELTS scores"],
      timeline: [{ step: "Get I-20 from university", time: "2-4 weeks" }, { step: "Pay SEVIS fee", time: "1 day" }, { step: "Complete DS-160", time: "1 day" }, { step: "Schedule visa interview", time: "1-3 weeks" }, { step: "Attend interview", time: "1 day" }]
    }
  ];

  const paths = staticVisas.map(visa => ({
    params: { country: visa.country, type: visa.type },
    props: { visa, entry: null }
  }));

  // 2. Load Content Collections
  try {
    const guides = await getCollection('visa-guides');
    guides.forEach(entry => {
      const countryParam = entry.data.country.toLowerCase();
      const typeParam = entry.data.visaType.toLowerCase();
      
      // Map frontmatter schema to visual guide structures
      const mappedVisa = {
        country: countryParam,
        type: typeParam,
        title: entry.data.title,
        flag: countryParam === "canada" ? "🇨🇦" : countryParam === "usa" ? "🇺🇸" : "🌎",
        visaType: entry.data.visaType,
        processing: entry.data.processingTime,
        cost: entry.data.fee,
        requirements: entry.data.requirements,
        documents: [
          "Passport bio-data scan",
          "Digital passport size photo",
          "Completed visa application forms",
          ...entry.data.requirements.slice(0, 3)
        ],
        timeline: [
          { step: "Submit Online Application Form", time: "1-2 days" },
          { step: "Document Verification & Filing", time: "3-5 days" },
          { step: "Embassy Processing Window", time: entry.data.processingTime }
        ]
      };

      // Add to paths (avoiding duplicates)
      const exists = paths.some(p => p.params.country === countryParam && p.params.type === typeParam);
      if (!exists) {
        paths.push({
          params: { country: countryParam, type: typeParam },
          props: { visa: mappedVisa, entry }
        });
      }
    });
  } catch (e) {
    console.error("Error reading visa-guides collection:", e);
  }

  return paths;
}

const { country, type } = Astro.params;
const { visa, entry } = Astro.props;

// Compile Content Collection entry if present
const Content = entry ? (await entry.render()).Content : null;

// JSON-LD structured schema for search engines
const schema = {
  "@context": "https://schema.org",
  "@type": "Guide",
  "name": visa.title,
  "description": visa.title + " requirements, documents checklist, processing time and fee guide.",
  "publisher": {
    "@type": "Organization",
    "name": "VisaFormula Hub"
  },
  "about": {
    "@type": "Thing",
    "name": visa.visaType + " for " + visa.country.toUpperCase()
  }
};
---

<Layout 
  title={`${visa.title} Official Guide`} 
  description={`${visa.title} complete requirements, required documents scan list, application processing fee (${visa.cost}) and step-by-step timeline details.`}
>
  <!-- SEO Structured Data Schema -->
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="bg-[#f0fdf4] min-h-screen pb-24">
      {/* Dynamic Cover Hero */}
      <section class="relative text-white py-24 px-4 overflow-hidden border-b border-green-100">
          <div class="absolute inset-0 z-0">
              <img
                  src="https://images.unsplash.com/photo-1544006659-f0b21f04cb1d?w=1800&h=900&fit=crop&q=90"
                  alt="Premium international map background"
                  class="w-full h-full object-cover brightness-[0.4]"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-[#0c1a2e]/90 via-[#0c1a2e]/70 to-[#f0fdf4]" />
          </div>

          <div class="relative z-10 max-w-4xl mx-auto text-center md:text-left md:flex md:items-center md:justify-between gap-6">
              <div class="flex flex-col md:flex-row items-center gap-4">
                  <span class="text-6xl filter drop-shadow-md select-none">{visa.flag}</span>
                  <div class="text-center md:text-left">
                      <span class="bg-[#16a34a]/10 text-[#86efac] text-[10px] font-bold tracking-wider px-3 py-1 rounded-full border border-green-500/20 mb-2 inline-block">
                          {visa.visaType}
                      </span>
                      <h1 class="font-sora text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight tracking-tight mt-1">
                          {visa.title} Guide
                      </h1>
                  </div>
              </div>
              <div class="flex flex-col sm:flex-row justify-center gap-4 mt-6 md:mt-0 font-bold text-xs shrink-0">
                  <div class="bg-white/5 border border-white/10 rounded-2xl px-5 py-3 backdrop-blur-md">
                      <div class="text-gray-400 text-[10px] tracking-wider mb-0.5">Processing Time</div>
                      <div class="text-white flex items-center gap-1"><Clock class="w-3.5 h-3.5 text-[#86efac]" /> {visa.processing}</div>
                  </div>
                  <div class="bg-white/5 border border-white/10 rounded-2xl px-5 py-3 backdrop-blur-md">
                      <div class="text-gray-400 text-[10px] tracking-wider mb-0.5">Application Fee</div>
                      <div class="text-white flex items-center gap-1"><DollarSign class="w-3.5 h-3.5 text-emerald-400" /> {visa.cost}</div>
                  </div>
              </div>
          </div>
      </section>

      <div class="max-w-4xl mx-auto px-4 py-8 space-y-10">
          
          {/* Render markdown content from Content Collection if present */}
          {Content && (
              <article class="prose max-w-none bg-white rounded-3xl border border-green-100 p-8 shadow-sm prose-slate prose-headings:font-sora prose-headings:text-navy prose-h1:text-2xl prose-h2:text-xl prose-p:text-sm prose-p:leading-relaxed">
                  <Content />
              </article>
          )}

          {/* Requirements Grid */}
          <section class="bg-white rounded-3xl border border-green-100 p-6 shadow-sm">
              <h2 class="font-sora text-xl font-bold text-navy mb-5 flex items-center gap-2">
                  <CheckCircle class="w-5 h-5 text-emerald-500" /> Requirements Checklist
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {visa.requirements.map((r: string, i: number) => (
                      <div key={i} class="flex items-start gap-2.5 p-3.5 bg-green-50/30 border border-green-100/50 rounded-2xl">
                          <CheckCircle class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" />
                          <span class="text-xs text-gray-700 font-medium leading-relaxed">{r}</span>
                      </div>
                  ))}
              </div>
          </section>

          {/* Required Documents List */}
          <section class="bg-white rounded-3xl border border-green-100 p-6 shadow-sm">
              <h2 class="font-sora text-xl font-bold text-navy mb-5 flex items-center gap-2">
                  <FileText class="w-5 h-5 text-[#16a34a]" /> Mandatory Document Scan Checklist
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {visa.documents.map((d: string, i: number) => (
                      <div key={i} class="flex items-center gap-3 p-3.5 bg-green-50/30 border border-green-100/50 rounded-2xl">
                          <FileText class="w-4 h-4 text-[#16a34a] shrink-0" />
                          <span class="text-xs text-gray-700 font-bold leading-normal">{d}</span>
                      </div>
                  ))}
              </div>
          </section>

          {/* Step-by-Step Timeline */}
          <section class="bg-white rounded-3xl border border-green-100 p-6 shadow-sm">
              <h2 class="font-sora text-xl font-bold text-navy mb-5 flex items-center gap-2">
                  <Clock class="w-5 h-5 text-amber-500" /> Step-by-Step Application Timeline
              </h2>
              <div class="space-y-4">
                  {visa.timeline.map((t: any, i: number) => (
                      <div key={i} class="flex items-start gap-4">
                          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#86efac] to-[#16a34a] text-white flex items-center justify-center text-xs font-black shadow-md shrink-0">
                              {i + 1}
                          </div>
                          <div class="flex-1 pb-4 border-b border-green-50 last:border-0">
                              <h4 class="font-sora font-bold text-navy text-xs sm:text-sm">{t.step}</h4>
                              <p class="text-[10px] text-gray-400 mt-1 font-bold">{t.time}</p>
                          </div>
                      </div>
                  ))}
              </div>
          </section>

          {/* Expert Call CTA */}
          <div class="text-center pt-6 bg-gradient-to-b from-green-50/50 to-transparent p-8 rounded-3xl border border-green-100/40">
              <span class="bg-green-500/10 text-[#16a34a] text-[9px] font-black tracking-widest px-3 py-1 rounded-full mb-3 inline-block">Professional Assistance</span>
              <h3 class="font-sora text-xl font-bold text-navy mb-2">Need Help Filing Your Application?</h3>
              <p class="text-xs text-gray-500 max-w-md mx-auto mb-6">Connect with vetted visa experts, verified migration lawyers, and dedicated case officers.</p>
              <a href={`/apply-visa?country=${visa.country}`} class="inline-block">
                  <button class="bg-gradient-to-r from-[#16a34a] to-[#15803d] hover:shadow-lg hover:shadow-green-100 text-white px-8 py-3.5 rounded-2xl font-bold text-xs tracking-wider flex items-center gap-2 transition-all">
                      <Users class="w-4 h-4" /> Connect with {visa.title} Experts <ArrowRight class="w-4 h-4" />
                  </button>
              </a>
          </div>

      </div>
  </div>
</Layout>
