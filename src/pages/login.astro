---
// src/pages/login.astro
// Login Portal rendered in a popup modal over the live LandingPage
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/landing/LandingPage';
import { AuthModalPortal } from '../components/interactive/AuthModalPortal';
---

<Layout 
  title="Sign In to VisaFormula" 
  description="Sign in to your VisaFormula visa consultation account. Complete your application filing, check upcoming session schedules, and upload passport document scans."
  hideHeader={true}
  hideFooter={true}
>
  <div class="relative min-h-screen">
    
    <!-- Live Background Homepage -->
    <div class="pointer-events-none filter blur-[3px] opacity-60 fixed inset-0 z-0 overflow-hidden">
      <LandingPage client:only="react" />
    </div>

    <!-- Modal Pop-up Container on Top -->
    <div class="relative z-[9999] min-h-screen">
      <AuthModalPortal client:only="react" initialTab="login" />
    </div>

  </div>
</Layout>
