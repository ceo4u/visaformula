---
// src/pages/signup/expert.astro
import Layout from '../../layouts/Layout.astro';
import { ExpertSignupPortal } from '../../components/interactive/ExpertSignupPortal';
---

<Layout 
  title="Sign Up as Expert - TravlTik" 
  description="Register as an immigration expert on TravlTik to consult clients and grow your global practice."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Fast Ambient Background -->
  <div class="fixed inset-0 z-0 bg-slate-900">
    <div class="absolute inset-0 bg-radial-[at_top] from-slate-800 via-slate-900 to-slate-950 opacity-90"></div>
  </div>

  <!-- Expert Registration Wizard — perfectly centered on all screens -->
  <div class="relative z-30 min-h-screen overflow-y-auto">
    <div class="flex min-h-full items-center justify-center px-4 py-16 sm:py-20">
      <div class="w-full max-w-4xl">
        <ExpertSignupPortal client:only="react" />
      </div>
    </div>
  </div>
</Layout>
