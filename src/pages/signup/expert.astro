---
// src/pages/signup/expert.astro
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/landing/LandingPage';
import { ExpertSignupPortal } from '../../components/interactive/ExpertSignupPortal';
---

<Layout 
  title="Sign Up as Expert - VisaFormula" 
  description="Register as an immigration expert on VisaFormula to consult clients and grow your global practice."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Main Home Page rendered in the background (blurred) -->
  <div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
    <LandingPage client:only="react" />
  </div>

  <!-- Dark Overlay -->
  <div class="fixed inset-0 z-10 bg-slate-900/50 backdrop-blur-sm pointer-events-none"></div>

  <!-- Back to Home — fixed top-left, never affects layout -->
  <div class="fixed top-4 left-4 z-40 pointer-events-auto">
    <a
      href="/"
      class="flex items-center gap-1.5 text-xs font-bold text-white bg-white/20 hover:bg-white/30 transition-all px-4 py-2 rounded-full border border-white/30 backdrop-blur-md shadow-md"
      style="font-family: 'Plus Jakarta Sans', sans-serif;"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
      <span>Back to Home</span>
    </a>
  </div>

  <!-- Expert Registration Wizard — perfectly centered on all screens -->
  <div class="fixed inset-0 z-30 overflow-y-auto pointer-events-auto">
    <div class="flex min-h-full items-center justify-center px-4 py-16 sm:py-20">
      <div class="w-full max-w-4xl">
        <ExpertSignupPortal client:only="react" />
      </div>
    </div>
  </div>
</Layout>
