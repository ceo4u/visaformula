---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
import { LoginPortal } from '../components/interactive/LoginPortal';
import { AuthProvider } from '../components/providers/auth-provider';
---

<Layout 
  title="Sign In to Visara" 
  description="Sign in to your Visara visa consultation account. Complete your application filing, check upcoming session schedules, and upload passport document scans."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Mount client-only React login portal island -->
  <AuthProvider client:only="react">
    <LoginPortal client:only="react" />
  </AuthProvider>
</Layout>
