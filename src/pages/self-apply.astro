---
// src/pages/self-apply.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Self Apply — Your Visa, Your Way" description="Fill your application yourself. Get AI-powered suggestions and add our services if you need help." hideHeader={true}>
  <!-- CSS Styles directly copied from source -->
  <style is:inline>
    :root {
      --white: #FFFFFF;
      --black: #000000;
      --gray-50: #F8FAFC;
      --gray-100: #F3F4F6;
      --gray-200: #E5E7EB;
      --gray-300: #D1D5DB;
      --gray-400: #9CA3AF;
      --gray-500: #6B7280;
      --gray-600: #4B5563;
      --gray-700: #374151;
      --gray-800: #1F2937;
      --gray-900: #111827;
      --green: #0D9F6E;
      --grlt: #E6FBF3;
      --border: #E5E7EB;
      --radius: 16px;
      --pill: 999px;
      --shadow: 0 2px 12px rgba(0,0,0,0.06);
      --shadow-hover: 0 8px 30px rgba(0,0,0,0.10);
      --transition: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .self-apply-body {
      font-family: 'DM Sans', sans-serif;
      background: var(--white);
      color: var(--black);
      line-height: 1.6;
      position: relative;
    }

    .self-apply-body h1, .self-apply-body h2, .self-apply-body h3, .self-apply-body h4 {
      font-family: 'Sora', sans-serif;
    }

    @keyframes shake {
      0%   { transform: translateX(0); }
      20%  { transform: translateX(-8px); }
      40%  { transform: translateX(8px); }
      60%  { transform: translateX(-6px); }
      80%  { transform: translateX(6px); }
      100% { transform: translateX(0); }
    }

    /* Back Home Button style */
    .back-home-btn {
      position: absolute;
      top: 24px;
      left: 24px;
      z-index: 100;
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      color: var(--black);
      padding: 8px 16px;
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all var(--transition);
      box-shadow: var(--shadow);
    }

    .back-home-btn:hover {
      border-color: var(--black);
      transform: translateY(-1px);
      box-shadow: var(--shadow-hover);
    }

    .self-apply-container {
      max-width: 1140px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    /* Hero */
    .self-apply-hero {
      text-align: center;
      padding: 40px 24px 32px;
      border-bottom: 1px solid var(--gray-200);
    }

    .self-apply-hero h1 {
      font-size: 38px;
      font-weight: 800;
      color: var(--black);
      margin-bottom: 8px;
    }

    .self-apply-hero h1 span {
      color: var(--black);
      text-decoration: underline;
      text-underline-offset: 6px;
    }

    .self-apply-hero p {
      font-size: 16px;
      color: var(--gray-500);
      max-width: 500px;
      margin: 0 auto 16px;
    }

    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--gray-100);
      border: 1px solid var(--gray-200);
      border-radius: var(--pill);
      padding: 5px 16px;
      font-size: 12px;
      font-weight: 700;
      color: var(--black);
      margin-bottom: 16px;
    }

    .trust-badge .dot {
      width: 6px;
      height: 6px;
      background: var(--black);
      border-radius: 50%;
      animation: pulse-dot 2s infinite;
    }

    @keyframes pulse-dot {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: .5; transform: scale(.7); }
    }

    .stats-row {
      display: flex;
      justify-content: center;
      gap: 32px;
      flex-wrap: wrap;
      margin-top: 12px;
    }

    .stats-row .item {
      text-align: center;
    }

    .stats-row .item .num {
      font-weight: 800;
      font-size: 20px;
      color: var(--black);
    }

    .stats-row .item .label {
      font-size: 12px;
      color: var(--gray-500);
    }

    /* Step Indicator */
    .step-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      padding: 24px 0 32px;
      max-width: 600px;
      margin: 0 auto;
    }

    .step-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex: 1;
    }

    .step-dot {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      z-index: 1;
      transition: all var(--transition);
      cursor: pointer;
      border: 2px solid var(--gray-200);
      color: var(--gray-400);
      background: var(--white);
    }

    .step-dot.active {
      border-color: var(--black);
      color: var(--black);
      box-shadow: 0 0 0 4px rgba(0,0,0,0.08);
    }

    .step-dot.done {
      background: var(--black);
      border-color: var(--black);
      color: var(--white);
    }

    .step-line {
      flex: 1;
      height: 2px;
      margin: 0;
      background: var(--gray-200);
      transition: background var(--transition);
    }

    .step-line.done {
      background: var(--black);
    }

    .step-label {
      font-size: 10px;
      font-weight: 600;
      color: var(--gray-400);
      text-align: center;
      margin-top: 5px;
      line-height: 1.3;
      transition: color var(--transition);
    }

    .step-dot.active + .step-label,
    .step-dot.done + .step-label {
      color: var(--black);
    }

    /* Progress Bar */
    .progress-wrapper {
      margin-bottom: 24px;
    }

    .progress-track {
      background: var(--gray-100);
      border-radius: var(--pill);
      height: 6px;
      overflow: hidden;
    }

    .progress-fill {
      height: 6px;
      border-radius: var(--pill);
      background: var(--black);
      transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      width: 25%;
    }

    .progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      color: var(--gray-500);
      margin-top: 4px;
    }

    /* Step Content - Smooth Transitions */
    .step-content {
      display: none;
      opacity: 0;
      transform: translateX(30px);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .step-content.active {
      display: block;
      animation: slideIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .step-content.exit {
      display: block;
      animation: slideOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes slideIn {
      0% { opacity: 0; transform: translateX(30px); }
      100% { opacity: 1; transform: translateX(0); }
    }

    @keyframes slideOut {
      0% { opacity: 1; transform: translateX(0); }
      100% { opacity: 0; transform: translateX(-30px); }
    }

    /* Country Grid */
    .country-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
      margin: 16px 0 24px;
    }

    .country-card {
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 16px 12px;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition);
    }

    .country-card:hover {
      border-color: var(--black);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .country-card.selected {
      border-color: var(--black);
      background: var(--gray-50);
      box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
    }

    .country-card .flag {
      font-size: 28px;
      margin-bottom: 4px;
    }

    .country-card .name {
      font-weight: 600;
      font-size: 13px;
      color: var(--black);
    }

    .country-card .visa-types {
      font-size: 11px;
      color: var(--gray-400);
      margin-top: 2px;
    }

    .country-card .badge {
      display: inline-block;
      font-size: 9px;
      font-weight: 700;
      color: var(--white);
      background: var(--black);
      padding: 1px 8px;
      border-radius: var(--pill);
      margin-top: 4px;
    }

    /* Visa Type Pills */
    .visa-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 12px 0 20px;
    }

    .visa-pill {
      padding: 8px 18px;
      border: 1.5px solid var(--gray-200);
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 600;
      color: var(--gray-500);
      cursor: pointer;
      background: var(--white);
      transition: all var(--transition);
    }

    .visa-pill:hover {
      border-color: var(--black);
      color: var(--black);
    }

    .visa-pill.selected {
      background: var(--black);
      color: var(--white);
      border-color: var(--black);
    }

    /* Form */
    .form-group {
      margin-bottom: 16px;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--gray-700);
      margin-bottom: 4px;
    }

    .form-group input {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--gray-200);
      border-radius: 8px;
      font-size: 14px;
      color: var(--black);
      background: var(--white);
      outline: none;
      transition: all var(--transition);
    }

    /* Force selection styles to override browser default blue selection */
    .form-group input::selection,
    .form-group input *::selection {
      background-color: var(--black) !important;
      color: var(--white) !important;
    }

    .form-group input:focus {
      border-color: var(--black);
      box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
    }

    .form-group input::placeholder {
      color: var(--gray-400);
    }

    /* Custom Dropdown styling */
    .custom-select-container {
      position: relative;
      width: 100%;
    }

    .custom-select-trigger {
      width: 100%;
      padding: 10px 14px;
      border: 1.5px solid var(--gray-200);
      border-radius: 8px;
      font-size: 14px;
      color: var(--black);
      background: var(--white);
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: all var(--transition);
      user-select: none;
    }

    .custom-select-trigger:hover,
    .custom-select-container.open .custom-select-trigger {
      border-color: var(--black);
    }

    .custom-select-options {
      position: absolute;
      top: calc(100% + 4px);
      left: 0;
      width: 100%;
      background: var(--white);
      border: 1.5px solid var(--black);
      border-radius: 8px;
      box-shadow: var(--shadow-hover);
      z-index: 150;
      display: none;
      max-height: 200px;
      overflow-y: auto;
    }

    .custom-select-container.open .custom-select-options {
      display: block;
    }

    .custom-option {
      padding: 10px 14px;
      font-size: 14px;
      color: var(--black);
      cursor: pointer;
      transition: all var(--transition);
      user-select: none;
    }

    .custom-option:hover {
      background-color: var(--black) !important;
      color: var(--white) !important;
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* Upload Zone */
    .upload-zone {
      border: 2px dashed var(--gray-200);
      border-radius: var(--radius);
      padding: 28px 20px;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition);
      background: var(--gray-50);
      margin-bottom: 16px;
    }

    .upload-zone:hover {
      border-color: var(--black);
      background: var(--white);
    }

    .upload-zone .icon {
      font-size: 32px;
      margin-bottom: 6px;
    }

    .upload-zone .title {
      font-weight: 700;
      font-size: 14px;
      color: var(--black);
    }

    .upload-zone .sub {
      font-size: 12px;
      color: var(--gray-400);
    }

    .upload-zone .extracted {
      margin-top: 10px;
      padding: 10px 14px;
      background: var(--grlt);
      border-radius: 8px;
      font-size: 13px;
      color: var(--green);
      font-weight: 600;
      display: none;
    }

    .upload-zone .extracted.show {
      display: block;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 10px 24px;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      transition: all var(--transition);
    }

    .btn-primary {
      background: var(--black);
      color: var(--white);
    }

    .btn-primary:hover {
      background: var(--gray-800);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }

    .btn-secondary {
      background: var(--white);
      color: var(--black);
      border: 1.5px solid var(--gray-200);
    }

    .btn-secondary:hover {
      border-color: var(--black);
    }

    .btn-sm {
      padding: 6px 14px;
      font-size: 12px;
    }

    .btn-block {
      width: 100%;
      justify-content: center;
    }

    .btn-group {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      justify-content: space-between;
    }

    /* Service Cards */
    .service-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin: 16px 0;
    }

    .service-card {
      background: var(--white);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 18px 16px;
      transition: all var(--transition);
      cursor: pointer;
    }

    .service-card:hover {
      border-color: var(--black);
      transform: translateY(-2px);
      box-shadow: var(--shadow-hover);
    }

    .service-card.selected {
      border-color: var(--black);
      background: var(--gray-50);
    }

    .service-card .icon {
      font-size: 28px;
      margin-bottom: 6px;
    }

    .service-card .title {
      font-weight: 700;
      font-size: 15px;
      color: var(--black);
    }

    .service-card .desc {
      font-size: 12px;
      color: var(--gray-500);
      margin: 4px 0 8px;
    }

    .service-card .price {
      font-weight: 800;
      font-size: 16px;
      color: var(--black);
    }

    .service-card .price span {
      font-weight: 400;
      font-size: 12px;
      color: var(--gray-400);
    }

    .service-card .add-btn {
      margin-top: 10px;
      padding: 4px 14px;
      font-size: 12px;
      font-weight: 600;
      border: 1.5px solid var(--gray-200);
      border-radius: var(--pill);
      background: var(--white);
      cursor: pointer;
      transition: all var(--transition);
    }

    .service-card .add-btn:hover {
      border-color: var(--black);
    }

    .service-card .add-btn.added {
      background: var(--black);
      color: var(--white);
      border-color: var(--black);
    }

    .service-card.free-card {
      border-color: var(--gray-300);
      background: var(--gray-50);
    }

    /* Order Summary */
    .order-summary {
      background: var(--gray-50);
      border: 1.5px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 20px 24px;
      margin: 16px 0;
    }

    .order-summary .row {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      font-size: 14px;
    }

    .order-summary .row.total {
      font-weight: 700;
      font-size: 16px;
      border-top: 2px solid var(--gray-200);
      padding-top: 10px;
      margin-top: 4px;
    }

    .order-summary .escrow {
      font-size: 12px;
      color: var(--green);
      font-weight: 600;
      text-align: center;
      margin-top: 8px;
    }

    /* Success */
    .success-screen {
      text-align: center;
      padding: 32px 0;
    }

    .success-screen .icon {
      font-size: 56px;
      margin-bottom: 12px;
    }

    .success-screen h2 {
      font-size: 28px;
      font-weight: 800;
      color: var(--black);
      margin-bottom: 4px;
    }

    .success-screen .ref {
      font-size: 14px;
      color: var(--gray-500);
      background: var(--gray-100);
      padding: 8px 16px;
      border-radius: 8px;
      display: inline-block;
      margin: 8px 0 16px;
    }

    .success-screen .next-steps {
      text-align: left;
      background: var(--gray-50);
      border: 1px solid var(--gray-200);
      border-radius: var(--radius);
      padding: 20px 24px;
      max-width: 480px;
      margin: 16px auto;
    }

    .success-screen .next-steps li {
      list-style: none;
      padding: 6px 0;
      font-size: 13px;
      color: var(--gray-600);
      border-bottom: 1px solid var(--gray-100);
    }

    .success-screen .next-steps li:last-child {
      border-bottom: none;
    }

    .success-screen .next-steps li::before {
      content: '✅ ';
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--black);
      color: var(--white);
      padding: 11px 22px;
      border-radius: var(--pill);
      font-size: 13px;
      font-weight: 600;
      z-index: 999;
      opacity: 0;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      white-space: nowrap;
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
    }

    .toast.on {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .self-apply-container { padding: 20px 16px; }
      .self-apply-hero h1 { font-size: 28px; }
      .form-row { grid-template-columns: 1fr; }
      .service-grid { grid-template-columns: 1fr; }
      .country-grid { grid-template-columns: 1fr 1fr; }
      .stats-row { gap: 16px; }
      .step-indicator { padding: 16px 0; }
      .btn-group { flex-direction: column-reverse; gap: 8px; }
      .btn-group .btn { width: 100%; justify-content: center; }
      .order-summary { padding: 16px; }
      .success-screen h2 { font-size: 22px; }
    }

    @media (max-width: 480px) {
      .country-grid { grid-template-columns: 1fr; }
      .visa-pills { gap: 4px; }
      .visa-pill { padding: 6px 12px; font-size: 12px; }
    }
  </style>

  <div class="self-apply-body">
    <!-- ========== BACK TO HOME BUTTON (Top Left Corner) ========== -->
    <a href="/" class="back-home-btn">
      ← Back to Home
    </a>

    <!-- ========== TOAST ========== -->
    <div class="toast" id="toast">Message</div>

    <!-- ========== HERO ========== -->
    <section class="self-apply-hero">
      <div class="trust-badge">
        <div class="dot"></div>
        ✈️ Apply online in 10 minutes. No expert required.
      </div>
      <h1>Self Apply — <span>Your Visa, Your Way</span></h1>
      <p>Fill your application yourself. Get AI-powered suggestions and add our services if you need help.</p>
      <div class="stats-row">
        <div class="item"><div class="num">500+</div><div class="label">Applications Today</div></div>
        <div class="item"><div class="num">98%</div><div class="label">Approval Rate</div></div>
        <div class="item"><div class="num">24hr</div><div class="label">Avg Processing</div></div>
      </div>
    </section>

    <!-- ========== MAIN CONTAINER ========== -->
    <div class="self-apply-container">

      <!-- ===== STEP INDICATOR ===== -->
      <div class="step-indicator" id="stepIndicator">
        <div class="step-item">
          <div class="step-dot active" data-step="1">1</div>
          <div class="step-label">Select Visa</div>
        </div>
        <div class="step-line" id="line1"></div>
        <div class="step-item">
          <div class="step-dot" data-step="2">2</div>
          <div class="step-label">Fill Details</div>
        </div>
        <div class="step-line" id="line2"></div>
        <div class="step-item">
          <div class="step-dot" data-step="3">3</div>
          <div class="step-label">Services</div>
        </div>
        <div class="step-line" id="line3"></div>
        <div class="step-item">
          <div class="step-dot" data-step="4">4</div>
          <div class="step-label">Review & Pay</div>
        </div>
      </div>

      <!-- ===== PROGRESS BAR ===== -->
      <div class="progress-wrapper">
        <div class="progress-track">
          <div class="progress-fill" id="progressFill" style="width:25%;"></div>
        </div>
        <div class="progress-label">
          <span id="progressText">Step 1 of 4</span>
          <span id="progressPercent">25%</span>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 1: SELECT VISA                       -->
      <!-- ========================================== -->
      <div class="step-content active" data-step="1">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:4px;">🌍 Select Your Destination</h2>
        <p style="color:var(--gray-500);margin-bottom:16px;">Choose the country and visa type you want to apply for.</p>

        <div class="country-grid" id="countryGrid">
          <div class="country-card" data-country="canada" onclick="selectCountry(this)">
            <div class="flag">🇨🇦</div>
            <div class="name">Canada</div>
            <div class="visa-types">Student · Work · Visitor · PR</div>
            <span class="badge">Popular</span>
          </div>
          <div class="country-card" data-country="uk" onclick="selectCountry(this)">
            <div class="flag">🇬🇧</div>
            <div class="name">United Kingdom</div>
            <div class="visa-types">Skilled Worker · Student · Visitor</div>
          </div>
          <div class="country-card" data-country="australia" onclick="selectCountry(this)">
            <div class="flag">🇦🇺</div>
            <div class="name">Australia</div>
            <div class="visa-types">Student · Skilled (189/190) · Visitor</div>
            <span class="badge">Hot</span>
          </div>
          <div class="country-card" data-country="usa" onclick="selectCountry(this)">
            <div class="flag">🇺🇸</div>
            <div class="name">United States</div>
            <div class="visa-types">B1/B2 · F-1 Student · H-1B</div>
          </div>
          <div class="country-card" data-country="germany" onclick="selectCountry(this)">
            <div class="flag">🇩🇪</div>
            <div class="name">Germany</div>
            <div class="visa-types">Student · Work · Job Seeker</div>
          </div>
          <div class="country-card" data-country="schengen" onclick="selectCountry(this)">
            <div class="flag">🇪🇺</div>
            <div class="name">Schengen</div>
            <div class="visa-types">Tourist · Business · Student</div>
          </div>
        </div>

        <h2 style="font-size:16px;font-weight:700;margin:16px 0 8px;">📋 Select Visa Type</h2>
        <div class="visa-pills" id="visaPills">
          <span class="visa-pill" data-visa="student" onclick="selectVisa(this)">🎓 Student Visa</span>
          <span class="visa-pill" data-visa="work" onclick="selectVisa(this)">💼 Work Permit</span>
          <span class="visa-pill" data-visa="visitor" onclick="selectVisa(this)">✈️ Visitor / Tourist</span>
          <span class="visa-pill" data-visa="pr" onclick="selectVisa(this)">🏡 PR / Express Entry</span>
        </div>

        <div class="btn-group">
          <div></div>
          <button class="btn btn-primary" id="step1ContinueBtn" onclick="step1Continue()" disabled style="opacity:0.4;cursor:not-allowed;">Continue →</button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 2: FILL DETAILS                      -->
      <!-- ========================================== -->
      <div class="step-content" data-step="2">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:4px;">📝 Fill Your Application</h2>
        <p style="color:var(--gray-500);margin-bottom:16px;">Upload your passport or fill details manually.</p>

        <!-- Upload Zone -->
        <div class="upload-zone" onclick="document.getElementById('passportFile').click()">
          <input type="file" id="passportFile" accept="image/*,application/pdf" style="display:none" onchange="handlePassportUpload(event)" />
          <div class="icon">📸</div>
          <div class="title">Upload Passport (OCR Scanner)</div>
          <div class="sub">Click to upload or drag & drop JPG/PNG/PDF</div>
          <div class="extracted" id="extractedInfo"></div>
        </div>

        <!-- Form -->
        <div class="form-row">
          <div class="form-group">
            <label>First Name</label>
            <input type="text" id="firstName" placeholder="As on passport" value="" />
          </div>
          <div class="form-group">
            <label>Last Name</label>
            <input type="text" id="lastName" placeholder="As on passport" value="" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Date of Birth</label>
            <input type="text" id="dob" placeholder="YYYY-MM-DD" value="" />
          </div>
          <div class="form-group">
            <label>Nationality</label>
            <div class="custom-select-container">
              <div class="custom-select-trigger" id="nationalityTrigger" onclick="toggleCustomSelect()">
                <span>🇮🇳 Indian</span>
                <span class="arrow">▼</span>
              </div>
              <div class="custom-select-options" id="nationalityOptions">
                <div class="custom-option" data-value="Indian" onclick="selectCustomOption('Indian', '🇮🇳 Indian')">🇮🇳 Indian</div>
                <div class="custom-option" data-value="American" onclick="selectCustomOption('American', '🇺🇸 American')">🇺🇸 American</div>
                <div class="custom-option" data-value="British" onclick="selectCustomOption('British', '🇬🇧 British')">🇬🇧 British</div>
                <div class="custom-option" data-value="Canadian" onclick="selectCustomOption('Canadian', '🇨🇦 Canadian')">🇨🇦 Canadian</div>
              </div>
            </div>
            <input type="hidden" id="nationality" value="Indian" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Passport Number</label>
            <input type="text" id="passportNo" placeholder="Passport Number" value="" />
          </div>
          <div class="form-group">
            <label>Passport Expiry</label>
            <input type="text" id="passportExpiry" placeholder="YYYY-MM-DD" value="" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" id="emailAddress" placeholder="Enter your email" value="" />
          </div>
          <div class="form-group">
            <label>Mobile Number</label>
            <input type="tel" id="mobileNumber" placeholder="Enter mobile number" value="" />
          </div>
        </div>

        <!-- Service Suggestions -->
        <div style="margin-top:20px;background:var(--gray-50);border:1px solid var(--gray-200);border-radius:var(--radius);padding:16px 20px;">
          <div style="font-weight:700;font-size:15px;margin-bottom:8px;">💡 Suggested Services for You</div>
          <p style="font-size:13px;color:var(--gray-500);margin-bottom:12px;">Based on your visa type (Canada Student Visa), we recommend:</p>
          <div class="service-grid" style="grid-template-columns:repeat(auto-fit, minmax(140px, 1fr));">
            <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:10px;padding:12px;text-align:center;">
              <div style="font-size:24px;">📄</div>
              <div style="font-weight:700;font-size:13px;">Documentation</div>
              <div style="font-size:12px;font-weight:700;">₹999</div>
              <button class="btn btn-sm btn-secondary" style="margin-top:6px;" onclick="toast('📄 Documentation added!')">Add</button>
            </div>
            <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:10px;padding:12px;text-align:center;">
              <div style="font-size:24px;">📝</div>
              <div style="font-weight:700;font-size:13px;">Form Filing</div>
              <div style="font-size:12px;font-weight:700;">₹1,499</div>
              <button class="btn btn-sm btn-secondary" style="margin-top:6px;" onclick="toast('📝 Form Filing added!')">Add</button>
            </div>
            <div style="background:var(--white);border:1px solid var(--gray-200);border-radius:10px;padding:12px;text-align:center;">
              <div style="font-size:24px;">🗓️</div>
              <div style="font-weight:700;font-size:13px;">VFS Appointment</div>
              <div style="font-size:12px;font-weight:700;">₹499</div>
              <button class="btn btn-sm btn-secondary" style="margin-top:6px;" onclick="toast('🗓️ VFS Appointment added!')">Add</button>
            </div>
          </div>
          <div style="margin-top:8px;font-size:12px;color:var(--gray-400);text-align:center;">
            👨💼 Expert Consultation — <strong style="color:var(--green);">Free</strong> (Book below)
          </div>
        </div>

        <div class="btn-group">
          <button class="btn btn-secondary" onclick="goToStep(1)">← Back</button>
          <button class="btn btn-primary" onclick="goToStep(3)">Continue →</button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 3: SERVICES                          -->
      <!-- ========================================== -->
      <div class="step-content" data-step="3">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:4px;">🎯 Complete Your Visa Package</h2>
        <p style="color:var(--gray-500);margin-bottom:16px;">Select the services you need. We'll handle the rest.</p>

        <div class="service-grid" id="serviceGrid">
          <div class="service-card" onclick="toggleService(this)">
            <div class="icon">📄</div>
            <div class="title">Documentation Package</div>
            <div class="desc">AI checklist, expert verification, cover letter</div>
            <div class="price">₹999 <span>/ application</span></div>
            <button class="add-btn" onclick="event.stopPropagation();toggleService(this.closest('.service-card'))">+ Add</button>
          </div>
          <div class="service-card" onclick="toggleService(this)">
            <div class="icon">📝</div>
            <div class="title">Visa Form Filing</div>
            <div class="desc">Expert fills your application, double-checked</div>
            <div class="price">₹1,499 <span>/ form</span></div>
            <button class="add-btn" onclick="event.stopPropagation();toggleService(this.closest('.service-card'))">+ Add</button>
          </div>
          <div class="service-card" onclick="toggleService(this)">
            <div class="icon">🗓️</div>
            <div class="title">VFS Appointment Booking</div>
            <div class="desc">Slot monitoring, confirmed in 24hrs</div>
            <div class="price">₹499 <span>/ booking</span></div>
            <button class="add-btn" onclick="event.stopPropagation();toggleService(this.closest('.service-card'))">+ Add</button>
          </div>
          <div class="service-card free-card" onclick="toast('📅 Expert consultation booked!')">
            <div class="icon">👨💼</div>
            <div class="title">1-on-1 Expert Consultation</div>
            <div class="desc">15-min video call, profile evaluation</div>
            <div class="price" style="color:var(--green);">Free</div>
            <button class="btn btn-sm btn-primary" style="margin-top:10px;" onclick="event.stopPropagation();toast('📅 Expert consultation booked!')">Book Now</button>
          </div>
        </div>

        <div class="btn-group">
          <button class="btn btn-secondary" onclick="goToStep(2)">← Back</button>
          <button class="btn btn-primary" onclick="goToStep(4)">Continue to Payment →</button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- STEP 4: REVIEW & PAY                      -->
      <!-- ========================================== -->
      <div class="step-content" data-step="4">
        <h2 style="font-size:20px;font-weight:700;margin-bottom:4px;">📋 Review & Pay</h2>
        <p style="color:var(--gray-500);margin-bottom:16px;">Verify your details and complete payment.</p>

        <!-- Order Summary -->
        <div class="order-summary">
          <div style="font-weight:700;font-size:15px;margin-bottom:8px;">Order Summary</div>
          <div class="row"><span>Visa Type</span><span>Canada Student Visa</span></div>
          <div class="row"><span>Applicant</span><span>Rahul Kumar (P1234567)</span></div>
          <div class="row"><span>📄 Documentation Package</span><span>₹999</span></div>
          <div class="row"><span>📝 Form Filing</span><span>₹1,499</span></div>
          <div class="row"><span>🗓️ VFS Appointment</span><span>₹499</span></div>
          <div class="row"><span>👨💼 Expert Consultation</span><span style="color:var(--green);">Free</span></div>
          <div class="row total"><span>Total</span><span>₹2,997</span></div>
          <div class="escrow">🔒 Escrow Protected — Pay only when services are delivered</div>
        </div>

        <div class="form-group">
          <label>Payment Method</label>
          <div class="custom-select-container">
            <div class="custom-select-trigger" id="paymentTrigger" onclick="togglePaymentSelect()">
              <span>💳 Card (UPI / Credit / Debit)</span>
              <span class="arrow">▼</span>
            </div>
            <div class="custom-select-options" id="paymentOptions">
              <div class="custom-option" data-value="card" onclick="selectPaymentOption('card', '💳 Card (UPI / Credit / Debit)')">💳 Card (UPI / Credit / Debit)</div>
              <div class="custom-option" data-value="netbanking" onclick="selectPaymentOption('netbanking', '🏦 Net Banking')">🏦 Net Banking</div>
              <div class="custom-option" data-value="upi" onclick="selectPaymentOption('upi', '📱 UPI (Google Pay / PhonePe)')">📱 UPI (Google Pay / PhonePe)</div>
            </div>
          </div>
          <input type="hidden" id="paymentMethod" value="card" />
        </div>

        <div class="form-group">
          <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
            <input type="checkbox" checked /> I agree to the <a href="#" style="text-decoration:underline;color:var(--black);">Terms & Conditions</a>
          </label>
        </div>

        <div class="btn-group">
          <button class="btn btn-secondary" onclick="goToStep(3)">← Back</button>
          <button class="btn btn-primary" onclick="submitApplication()">Pay ₹2,997 & Submit →</button>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- SUCCESS SCREEN                            -->
      <!-- ========================================== -->
      <div class="step-content" data-step="5">
        <div class="success-screen">
          <div class="icon">✅</div>
          <h2>Application Submitted Successfully!</h2>
          <div class="ref">Reference Number: VF-2026-08294</div>
          <p style="color:var(--gray-500);">Check your email for confirmation. Estimated processing: 5-7 business days.</p>

          <div class="next-steps">
            <div style="font-weight:700;font-size:14px;margin-bottom:8px;">📋 What's Next?</div>
            <ul>
              <li>Documentation expert will review your files (within 2 hrs)</li>
              <li>Form filling expert will prepare your application (within 12 hrs)</li>
              <li>VFS appointment will be booked (within 24 hrs)</li>
              <li>You'll receive a confirmation call from your expert</li>
            </ul>
          </div>

          <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
            <button class="btn btn-primary" onclick="toast('📱 Dashboard loading...')">Go to Dashboard</button>
            <button class="btn btn-secondary" onclick="resetApplication()">Apply for Another Visa</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script is:inline>
    // ==========================================
    // TOAST
    // ==========================================
    function toast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('on');
      clearTimeout(t._timer);
      t._timer = setTimeout(() => t.classList.remove('on'), 2400);
    }

    // ==========================================
    // STEP NAVIGATION WITH SMOOTH TRANSITION
    // ==========================================
    let currentStep = 1;
    const totalSteps = 4;
    let isTransitioning = false;

    function goToStep(step) {
      if (isTransitioning) return;
      if (step < 1 || step > totalSteps + 1) return;

      isTransitioning = true;
      const currentEl = document.querySelector(`.step-content[data-step="${currentStep}"]`);
      const nextEl = document.querySelector(`.step-content[data-step="${step}"]`);

      // Exit animation for current
      if (currentEl) {
        currentEl.classList.remove('active');
        currentEl.classList.add('exit');
        setTimeout(() => {
          currentEl.classList.remove('exit');
        }, 400);
      }

      // Enter animation for next
      setTimeout(() => {
        if (nextEl) {
          nextEl.classList.add('active');
          nextEl.classList.remove('exit');
        }
        currentStep = step;
        updateUI(step);
        window.scrollTo({ top: 0, behavior: 'smooth' });
        setTimeout(() => {
          isTransitioning = false;
        }, 500);
      }, 300);
    }

    function updateUI(step) {
      // Update dots
      const dots = document.querySelectorAll('.step-dot');
      dots.forEach((dot, index) => {
        const num = index + 1;
        dot.classList.remove('active', 'done');
        if (num === step) dot.classList.add('active');
        else if (num < step) dot.classList.add('done');
      });

      // Update lines
      const lines = document.querySelectorAll('.step-line');
      lines.forEach((line, index) => {
        const num = index + 1;
        line.classList.toggle('done', num < step);
      });

      // Update progress
      const progress = ((step - 1) / totalSteps) * 100;
      document.getElementById('progressFill').style.width = `${Math.min(progress, 100)}%`;
      document.getElementById('progressText').textContent = step <= totalSteps ? `Step ${step} of ${totalSteps}` : 'Complete!';
      document.getElementById('progressPercent').textContent = step <= totalSteps ? `${Math.round(progress)}%` : '100%';
    }

    // ==========================================
    // SELECT COUNTRY
    // ==========================================
    let selectedCountry = null;
    let selectedVisa = null;

    function updateStep1Btn() {
      const btn = document.getElementById('step1ContinueBtn');
      if (selectedCountry && selectedVisa) {
        btn.disabled = false;
        btn.style.opacity = '1';
        btn.style.cursor = 'pointer';
      } else {
        btn.disabled = true;
        btn.style.opacity = '0.4';
        btn.style.cursor = 'not-allowed';
      }
    }

    function step1Continue() {
      if (!selectedCountry) {
        toast('⚠️ Please select a destination country first!');
        // shake the country grid
        const grid = document.getElementById('countryGrid');
        grid.style.animation = 'shake 0.4s ease';
        setTimeout(() => grid.style.animation = '', 500);
        return;
      }
      if (!selectedVisa) {
        toast('⚠️ Please select a visa type!');
        const pills = document.getElementById('visaPills');
        pills.style.animation = 'shake 0.4s ease';
        setTimeout(() => pills.style.animation = '', 500);
        return;
      }
      goToStep(2);
    }

    function selectCountry(el) {
      document.querySelectorAll('.country-card').forEach(c => c.classList.remove('selected'));
      el.classList.add('selected');
      selectedCountry = el.dataset.country;
      toast(`📍 ${el.querySelector('.name').textContent} selected`);
      updateStep1Btn();
    }

    // ==========================================
    // SELECT VISA
    // ==========================================
    function selectVisa(el) {
      document.querySelectorAll('.visa-pill').forEach(p => p.classList.remove('selected'));
      el.classList.add('selected');
      selectedVisa = el.dataset.visa;
      toast(`📋 ${el.textContent.trim()} selected`);
      updateStep1Btn();
    }

    // ==========================================
    // CUSTOM SELECT HANDLERS
    // ==========================================
    function toggleCustomSelect() {
      const container = document.querySelector('#nationalityTrigger').closest('.custom-select-container');
      container.classList.toggle('open');
      
      // Close other dropdowns
      const paymentContainer = document.querySelector('#paymentTrigger').closest('.custom-select-container');
      paymentContainer.classList.remove('open');
    }

    function selectCustomOption(val, text) {
      document.getElementById('nationality').value = val;
      document.querySelector('#nationalityTrigger span').textContent = text;
      document.querySelector('#nationalityTrigger').closest('.custom-select-container').classList.remove('open');
      toast(`📍 Nationality: ${val} selected`);
    }

    function togglePaymentSelect() {
      const container = document.querySelector('#paymentTrigger').closest('.custom-select-container');
      container.classList.toggle('open');
      
      // Close other dropdowns
      const nationalityContainer = document.querySelector('#nationalityTrigger').closest('.custom-select-container');
      nationalityContainer.classList.remove('open');
    }

    function selectPaymentOption(val, text) {
      document.getElementById('paymentMethod').value = val;
      document.querySelector('#paymentTrigger span').textContent = text;
      document.querySelector('#paymentTrigger').closest('.custom-select-container').classList.remove('open');
      toast(`💳 Payment: ${text.split(' ')[1]} selected`);
    }

    // Close dropdowns on outside click
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.custom-select-container')) {
        document.querySelectorAll('.custom-select-container').forEach(c => c.classList.remove('open'));
      }
    });

    // ==========================================
    // PASSPORT UPLOAD & OCR PARSING
    // ==========================================
    function handlePassportUpload(event) {
      const file = event.target.files[0];
      if (!file) return;

      toast('⚙️ Reading passport file...');
      
      // Simulate file reading and parsing delay
      setTimeout(() => {
        // Generate random realistic credentials based on common Indian naming
        const firstNames = ["Arjun", "Karan", "Simran", "Neha", "Vijay", "Aisha", "Aditya", "Rohan", "Pooja", "Vikram"];
        const lastNames = ["Sharma", "Verma", "Patel", "Singh", "Nair", "Reddy", "Gupta", "Joshi", "Das", "Mehta"];
        const randomFirst = firstNames[Math.floor(Math.random() * firstNames.length)];
        const randomLast = lastNames[Math.floor(Math.random() * lastNames.length)];
        const randomPassport = "J" + Math.floor(1000000 + Math.random() * 9000000);
        
        // Random birth dates (between 1985 and 2004)
        const birthYear = Math.floor(1985 + Math.random() * 20);
        const birthMonth = String(Math.floor(1 + Math.random() * 12)).padStart(2, '0');
        const birthDay = String(Math.floor(1 + Math.random() * 28)).padStart(2, '0');
        const dobVal = `${birthYear}-${birthMonth}-${birthDay}`;
        
        // Expiry date (random year between 2030 and 2036)
        const expYear = Math.floor(2030 + Math.random() * 7);
        const expMonth = String(Math.floor(1 + Math.random() * 12)).padStart(2, '0');
        const expDay = String(Math.floor(1 + Math.random() * 28)).padStart(2, '0');
        const expiryVal = `${expYear}-${expMonth}-${expDay}`;

        // Populate fields
        document.getElementById('firstName').value = randomFirst;
        document.getElementById('lastName').value = randomLast;
        document.getElementById('dob').value = dobVal;
        document.getElementById('passportNo').value = randomPassport;
        document.getElementById('passportExpiry').value = expiryVal;
        document.getElementById('nationality').value = "Indian";
        document.getElementById('emailAddress').value = `${randomFirst.toLowerCase()}.${randomLast.toLowerCase()}@email.com`;
        document.getElementById('mobileNumber').value = "+91 " + Math.floor(9000000000 + Math.random() * 1000000000);

        // Show parsing confirmation message
        const info = document.getElementById('extractedInfo');
        info.textContent = `✅ OCR Parsed: ${randomFirst} ${randomLast}, Passport: ${randomPassport}`;
        info.classList.add('show');
        
        toast('📸 Passport parsed! Fields populated successfully.');
      }, 1200);
    }

    // ==========================================
    // TOGGLE SERVICE
    // ==========================================
    function toggleService(card) {
      const btn = card.querySelector('.add-btn');
      if (!btn) return;
      const isAdded = btn.classList.contains('added');
      if (isAdded) {
        btn.classList.remove('added');
        btn.textContent = '+ Add';
        card.classList.remove('selected');
        toast('❌ Service removed');
      } else {
        btn.classList.add('added');
        btn.textContent = '✓ Added';
        card.classList.add('selected');
        toast('✅ Service added to your package');
      }
    }

    // ==========================================
    // SUBMIT APPLICATION
    // ==========================================
    function submitApplication() {
      toast('📤 Submitting your application...');
      setTimeout(() => {
        goToStep(5);
        toast('✅ Application submitted successfully!');
      }, 1500);
    }

    // ==========================================
    // RESET APPLICATION
    // ==========================================
    function resetApplication() {
      document.querySelectorAll('.step-content').forEach(el => el.classList.remove('active', 'exit'));
      document.querySelector(`.step-content[data-step="1"]`).classList.add('active');
      currentStep = 1;
      updateUI(1);
      toast('🔄 Reset complete. Start a new application.');
    }

    // ==========================================
    // INIT
    // ==========================================
    document.addEventListener('DOMContentLoaded', () => {
      updateUI(1);
    });
  </script>
</Layout>
