---
// src/components/layout/Footer.astro
import { Globe } from 'lucide-react';
---

<footer class="bg-[#070b12] text-white pt-16 pb-24 md:pb-8 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10 mb-16">
            <div class="col-span-2 lg:col-span-1">
                <a href="/" class="flex items-center gap-2 mb-5">
                    <Globe class="w-5 h-5 text-[#fca5a5]" />
                    <span class="text-2xl font-extrabold tracking-tight text-white">Visa Formula</span>
                </a>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">
                    The Digital Diplomat for Global Migration. Simplifying the complex for thousands of dreamers daily.
                </p>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">For Seekers</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/find-experts">Find Visa Experts</a></li>
                    <li><a class="hover:text-white transition-colors" href="/training">Study Pathways</a></li>
                    <li><a class="hover:text-white transition-colors" href="/jobs">Overseas Jobs</a></li>
                    <li><a class="hover:text-white transition-colors" href="/emergency">PR & Residency</a></li>
                    <li><a class="hover:text-white transition-colors" href="/success-stories">Success Stories</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">For Consultants</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/signup/expert">List your Practice</a></li>
                    <li><a class="hover:text-white transition-colors" href="/consultant/dashboard">Consultant Dashboard</a></li>
                    <li><a class="hover:text-white transition-colors" href="/escrow">Escrow Protection</a></li>
                    <li><a class="hover:text-white transition-colors" href="/support">Partner Program</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">For Agents</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/agents?page=register">Join Agents Portal</a></li>
                    <li><a class="hover:text-white transition-colors" href="/agents">Review Packages</a></li>
                    <li><a class="hover:text-white transition-colors" href="/agents">Verify Profiles</a></li>
                    <li><a class="hover:text-white transition-colors" href="/agents">Weekly Commissions</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">Resources & Trust</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/visa-documentation">Visa Documentation</a></li>
                    <li><a class="hover:text-white transition-colors" href="/visa-form-filing">Visa Form Filing</a></li>
                    <li><a class="hover:text-white transition-colors" href="/vfs-appointment">VFS Slot Booking</a></li>
                    <li><a class="hover:text-white transition-colors" href="/ai-assistant">AI Assistant</a></li>
                    <li><a class="hover:text-white transition-colors" href="/support">Support Center</a></li>
                </ul>
            </div>
        </div>
        <div class="pt-8 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
            <div class="flex gap-6 font-semibold">
                <a class="hover:text-white transition-colors" href="#">Privacy Policy</a>
                <a class="hover:text-white transition-colors" href="#">Terms of Service</a>
            </div>
            <p class="font-medium">© {new Date().getFullYear()} Visa Formula. All rights reserved.</p>
        </div>
    </div>
</footer>

