---
// src/components/layout/Footer.astro
import { Globe } from 'lucide-react';
---

<footer class="bg-[#070b12] text-white pt-16 pb-24 md:pb-8 px-6">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-10 mb-16">
            <div class="col-span-2 lg:col-span-1">
                <a href="/" class="flex items-center gap-2 mb-5">
                    <Globe class="w-5 h-5 text-[#fca5a5]" />
                    <span class="text-2xl font-extrabold tracking-tight text-white">Visa Formula</span>
                </a>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">
                    The Digital Diplomat for Global Migration. Simplifying the complex for thousands of dreamers daily.
                </p>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">Visa Types</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/find-lawyer">Study Visas</a></li>
                    <li><a class="hover:text-white transition-colors" href="/find-lawyer">Work Permits</a></li>
                    <li><a class="hover:text-white transition-colors" href="/find-lawyer">Family Reunification</a></li>
                    <li><a class="hover:text-white transition-colors" href="/find-lawyer">PR & Citizenship</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">Resources</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/support">Support Center</a></li>
                    <li><a class="hover:text-white transition-colors" href="/about">About Visa Formula</a></li>
                    <li><a class="hover:text-white transition-colors" href="/emergency">Emergency Help</a></li>
                    <li><a class="hover:text-white transition-colors" href="/ai-assistant">AI Assistant</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">Legal</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="#">Privacy Policy</a></li>
                    <li><a class="hover:text-white transition-colors" href="#">Terms of Service</a></li>
                    <li><a class="hover:text-white transition-colors" href="#">Verification Policy</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold mb-5 uppercase text-[11px] tracking-widest text-slate-500">Business</h4>
                <ul class="space-y-3 text-sm text-slate-400">
                    <li><a class="hover:text-white transition-colors" href="/signup/expert">List your Firm</a></li>
                    <li><a class="hover:text-white transition-colors" href="/dashboard">Expert Dashboard</a></li>
                    <li><a class="hover:text-white transition-colors" href="/support">Contact</a></li>
                </ul>
            </div>
        </div>
        <div class="pt-8 border-t border-zinc-900 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500">
            <div class="flex gap-6 font-semibold">
                <a class="hover:text-white transition-colors" href="#">Privacy Policy</a>
                <a class="hover:text-white transition-colors" href="#">Terms of Service</a>
            </div>
            <p class="font-medium">© {new Date().getFullYear()} Visa Formula. All rights reserved.</p>
        </div>
    </div>
</footer>

