---
// src/pages/signup/index.astro
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/landing/LandingPage';
import { SignupFlowPortal } from '../../components/interactive/SignupFlowPortal';
---

<Layout 
  title="Join VisaFormula" 
  description="Select your role to get started with VisaFormula - Register as a Visa Seeker or Visa Expert."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Main Home Page rendered in the background -->
  <LandingPage client:only="react" />

  <!-- Fixed Role Selection Modal Overlay -->
  <SignupFlowPortal client:only="react" initialMode="selection" />
</Layout>
