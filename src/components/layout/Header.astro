---
// src/components/layout/Header.astro
const pathname = Astro.url.pathname;

const isExplorePage = pathname === '/' || pathname?.startsWith('/find-experts') || pathname?.startsWith('/apply-visa');
const isEventsPage = pathname?.startsWith('/events') || pathname?.startsWith('/tours');
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 bg-white border-b border-gray-100 transition-all duration-300">

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- MAIN HEADER ROW                                      -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 h-[72px] flex items-center gap-6">

    <!-- LEFT: Logo -->
    <a href="/" class="flex flex-col shrink-0 group select-none" style="text-decoration:none;">
      <div class="flex items-center gap-0">
        <span class="font-black text-[20px] tracking-[-1px] text-[#0C1A2E] group-hover:text-[#0EA5E9] transition-colors duration-200" style="font-family:'Inter',sans-serif;">VISA</span>
        <!-- Arrow icon like Atlys -->
        <svg class="w-4 h-4 mx-0.5 text-[#0EA5E9]" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
        <span class="font-black text-[20px] tracking-[-1px] text-[#0C1A2E] group-hover:text-[#0EA5E9] transition-colors duration-200" style="font-family:'Inter',sans-serif;">FORMULA</span>
      </div>
      <span class="text-[8px] font-bold tracking-[1.5px] text-[#0EA5E9] uppercase ml-0.5" style="font-family:'Inter',sans-serif;">Global Visa Marketplace</span>
    </a>

    <!-- DIVIDER -->
    <div class="hidden sm:block w-px h-9 bg-gray-200 shrink-0"></div>

    <!-- TRUST BADGE -->
    <div class="hidden sm:flex items-center gap-2 shrink-0">
      <div class="w-8 h-8 rounded-full border border-[#0EA5E9]/30 bg-[#EFF9FF] flex items-center justify-center shrink-0">
        <svg class="w-4 h-4 text-[#0EA5E9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <div class="leading-tight">
        <div class="text-[12px] font-bold text-[#0C1A2E]"><span class="text-[#0EA5E9]">Visas</span> On Time</div>
        <div class="text-[11px] font-semibold text-[#0EA5E9]">Guaranteed</div>
      </div>
    </div>

    <!-- CENTER: Nav Icons -->
    <nav class="hidden md:flex items-end gap-2 xl:gap-6 flex-1 justify-center h-full pt-2">

      <!-- Find Expert / Explore -->
      <a href="/find-experts"
        class={`vf-nav-item flex flex-col items-center gap-1.5 pb-3 px-3 xl:px-5 h-full relative transition-colors duration-200 group ${isExplorePage ? 'active' : ''}`}>
        <div class="text-[34px] leading-none group-hover:scale-110 transition-transform duration-200 select-none">🎓</div>
        <span class="text-[13px] font-semibold text-[#0C1A2E] group-hover:text-[#0EA5E9] whitespace-nowrap transition-colors duration-200" style="font-family:'Inter',sans-serif;">Find Expert</span>
        <span class={`absolute bottom-0 left-1/2 -translate-x-1/2 h-[3px] rounded-full bg-[#0C1A2E] transition-all duration-200 ${isExplorePage ? 'w-full' : 'w-0 group-hover:w-1/2'}`}></span>
      </a>

      <!-- Explore Visa -->
      <a href="/apply-visa"
        class={`vf-nav-item flex flex-col items-center gap-1.5 pb-3 px-3 xl:px-5 h-full relative transition-colors duration-200 group ${pathname === '/apply-visa' ? 'active' : ''}`}>
        <div class="text-[34px] leading-none group-hover:scale-110 transition-transform duration-200 select-none">✈️</div>
        <span class="text-[13px] font-semibold text-[#0C1A2E] group-hover:text-[#0EA5E9] whitespace-nowrap transition-colors duration-200" style="font-family:'Inter',sans-serif;">Explore Visa</span>
        <span class={`absolute bottom-0 left-1/2 -translate-x-1/2 h-[3px] rounded-full bg-[#0C1A2E] transition-all duration-200 ${pathname === '/apply-visa' ? 'w-full' : 'w-0 group-hover:w-1/2'}`}></span>
      </a>

      <!-- Apply Visa -->
      <a href="/visa-documentation"
        class={`vf-nav-item flex flex-col items-center gap-1.5 pb-3 px-3 xl:px-5 h-full relative transition-colors duration-200 group ${pathname?.startsWith('/visa') ? 'active' : ''}`}>
        <div class="text-[34px] leading-none group-hover:scale-110 transition-transform duration-200 select-none">📋</div>
        <span class="text-[13px] font-semibold text-[#0C1A2E] group-hover:text-[#0EA5E9] whitespace-nowrap transition-colors duration-200" style="font-family:'Inter',sans-serif;">Apply Visa</span>
        <span class={`absolute bottom-0 left-1/2 -translate-x-1/2 h-[3px] rounded-full bg-[#0C1A2E] transition-all duration-200 ${pathname?.startsWith('/visa') ? 'w-full' : 'w-0 group-hover:w-1/2'}`}></span>
      </a>

      <!-- Visit Visa -->
      <a href="/tours"
        class={`vf-nav-item flex flex-col items-center gap-1.5 pb-3 px-3 xl:px-5 h-full relative transition-colors duration-200 group ${pathname?.startsWith('/tours') ? 'active' : ''}`}>
        <div class="text-[34px] leading-none group-hover:scale-110 transition-transform duration-200 select-none">✈️</div>
        <span class="text-[13px] font-semibold text-[#0C1A2E] group-hover:text-[#0EA5E9] whitespace-nowrap transition-colors duration-200" style="font-family:'Inter',sans-serif;">Visit Visa</span>
        <span class={`absolute bottom-0 left-1/2 -translate-x-1/2 h-[3px] rounded-full bg-[#0C1A2E] transition-all duration-200 ${pathname?.startsWith('/tours') ? 'w-full' : 'w-0 group-hover:w-1/2'}`}></span>
      </a>

    </nav>

    <!-- RIGHT: Search + User -->
    <div class="hidden sm:flex items-center gap-2.5 ml-auto shrink-0">
      <!-- Search Country -->
      <div id="search-bar" class="flex items-center gap-2 bg-white border border-gray-200 hover:border-gray-300 focus-within:border-[#0EA5E9] focus-within:shadow-[0_0_0_3px_rgba(14,165,233,0.1)] rounded-full px-4 py-2.5 transition-all duration-200 w-[160px] xl:w-[200px] cursor-pointer">
        <svg class="w-4 h-4 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="search-input-query"
          type="text"
          placeholder="Search Country"
          class="bg-transparent border-none outline-none text-[13px] font-medium text-gray-700 placeholder:text-gray-400 w-full"
          style="font-family:'Inter',sans-serif;"
        />
      </div>

      <!-- User Avatar -->
      <a href="/login" id="login-btn" class="w-9 h-9 rounded-full border border-gray-200 hover:border-gray-300 bg-gray-50 hover:bg-gray-100 flex items-center justify-center transition-all duration-200 shrink-0">
        <svg class="w-[18px] h-[18px] text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </a>
    </div>

    <!-- MOBILE: Hamburger -->
    <button id="mobile-menu-btn" class="sm:hidden ml-auto p-2 rounded-xl hover:bg-gray-100 transition-colors">
      <svg id="menu-icon" class="w-6 h-6 text-[#0C1A2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-[#0C1A2E] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- FILTER PILL ROW (Atlys-style)                        -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div id="filter-row" class="hidden md:block border-t border-gray-100 bg-white py-3">
    <div class="max-w-[1200px] mx-auto px-5 sm:px-8">
      <!-- Single pill card with 4 filters -->
      <div class="flex items-center bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm w-full max-w-[800px] mx-auto" style="height:56px;">

        <!-- Filter 1: Expert Type -->
        <button id="filter-expert" class="flex-1 flex items-center gap-2.5 px-5 h-full hover:bg-gray-50 transition-colors duration-150 group border-r border-gray-200 text-left">
          <div class="w-7 h-7 rounded-full bg-[#22C55E] flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] font-semibold text-gray-400 leading-none mb-0.5">Expert type:</div>
            <div class="flex items-center gap-1">
              <span class="text-[13px] font-bold text-[#0C1A2E] leading-none whitespace-nowrap">All Experts</span>
              <svg class="w-3 h-3 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
        </button>

        <!-- Filter 2: Visa Type -->
        <button id="filter-visa" class="flex-1 flex items-center gap-2.5 px-5 h-full hover:bg-gray-50 transition-colors duration-150 group border-r border-gray-200 text-left">
          <div class="w-7 h-7 rounded-full bg-[#0EA5E9] flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] font-semibold text-gray-400 leading-none mb-0.5">Type:</div>
            <div class="flex items-center gap-1">
              <span class="text-[13px] font-bold text-[#0C1A2E] leading-none whitespace-nowrap">All Visa Types</span>
              <svg class="w-3 h-3 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
        </button>

        <!-- Filter 3: Country -->
        <button id="filter-country" class="flex-1 flex items-center gap-2.5 px-5 h-full hover:bg-gray-50 transition-colors duration-150 group border-r border-gray-200 text-left">
          <div class="w-7 h-7 rounded-full bg-[#F97316] flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] font-semibold text-gray-400 leading-none mb-0.5">Country:</div>
            <div class="flex items-center gap-1">
              <span class="text-[13px] font-bold text-[#0C1A2E] leading-none whitespace-nowrap">Any Country</span>
              <svg class="w-3 h-3 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
        </button>

        <!-- Filter 4: Processing Time -->
        <button id="filter-time" class="flex-1 flex items-center gap-2.5 px-5 h-full hover:bg-gray-50 transition-colors duration-150 group text-left">
          <div class="w-7 h-7 rounded-full bg-[#EF4444] flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <div class="min-w-0">
            <div class="text-[10px] font-semibold text-gray-400 leading-none mb-0.5">Processing:</div>
            <div class="flex items-center gap-1">
              <span class="text-[13px] font-bold text-[#0C1A2E] leading-none whitespace-nowrap">Any Time</span>
              <svg class="w-3 h-3 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          </div>
        </button>

      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- MOBILE DRAWER                                        -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div id="mobile-menu-drawer" class="hidden sm:hidden bg-white border-t border-gray-100 shadow-xl">

    <!-- Mobile Search -->
    <div class="p-4 border-b border-gray-100">
      <div class="flex items-center bg-gray-50 rounded-xl px-4 py-3 border border-gray-200 gap-2">
        <svg class="w-4 h-4 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input id="mobile-search-input-query" class="flex-1 bg-transparent outline-none text-sm placeholder:text-gray-400 font-medium" placeholder="Search Country..." type="text" />
      </div>
    </div>

    <!-- Mobile Nav -->
    <div class="flex flex-col divide-y divide-gray-50">
      <a href="/find-experts" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">🎓</span>
        <div>
          <div class="text-[14px] font-bold">Find Expert</div>
          <div class="text-[11px] text-gray-400">Student, Work, Visit, PR</div>
        </div>
      </a>
      <a href="/apply-visa" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">✈️</span>
        <div>
          <div class="text-[14px] font-bold">Explore Visa</div>
          <div class="text-[11px] text-gray-400">All visa types & guides</div>
        </div>
      </a>
      <a href="/visa-documentation" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">📋</span>
        <div>
          <div class="text-[14px] font-bold">Apply Visa</div>
          <div class="text-[11px] text-gray-400">Documentation & form filing</div>
        </div>
      </a>
      <a href="/tours" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">✈️</span>
        <div>
          <div class="text-[14px] font-bold">Visit Visa</div>
          <div class="text-[11px] text-gray-400">Visitor visa & tours</div>
        </div>
      </a>
      <a href="/announcements" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">📢</span>
        <div><div class="text-[14px] font-bold">Announcements</div></div>
      </a>
      <a href="/support" class="flex items-center gap-3 px-5 py-4 text-[#0C1A2E] hover:bg-gray-50 transition-colors">
        <span class="text-2xl">📞</span>
        <div><div class="text-[14px] font-bold">Contact</div></div>
      </a>
    </div>

    <!-- Mobile Auth -->
    <div class="p-4 flex flex-col gap-2.5">
      <a href="/login" id="mobile-login-btn" class="block text-center py-3 border-2 border-[#0C1A2E] text-[#0C1A2E] font-bold text-[14px] rounded-xl hover:bg-[#0C1A2E] hover:text-white transition-all duration-200">
        Log In
      </a>
      <a href="/signup" id="mobile-signup-btn" class="block text-center py-3 bg-[#0EA5E9] hover:bg-[#0284C7] text-white font-bold text-[14px] rounded-xl transition-all duration-200">
        Sign Up Free
      </a>
    </div>
  </div>

</header>

<style is:global>
  /* ─────────────────────────────────── */
  /* Smooth nav underline on active      */
  /* ─────────────────────────────────── */
  .vf-nav-item.active > span:last-child {
    width: 100% !important;
  }
  .vf-nav-item.active span.text-\[\#0C1A2E\] {
    color: #0C1A2E !important;
  }

  /* ─────────────────────────────────── */
  /* Filter dropdown open state          */
  /* ─────────────────────────────────── */
  #filter-expert.active,
  #filter-visa.active,
  #filter-country.active,
  #filter-time.active {
    background-color: #f9fafb;
  }

  /* ─────────────────────────────────── */
  /* Transparent header for hero pages   */
  /* ─────────────────────────────────── */
  #main-header.header-transparent {
    background-color: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
  }
  #main-header.header-transparent #filter-row {
    background-color: transparent !important;
    border-color: transparent !important;
  }
</style>

<script>
  // ── Mobile menu ──
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenuDrawer?.classList.contains('hidden');
    if (isOpen) {
      mobileMenuDrawer?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    } else {
      mobileMenuDrawer?.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }
  });

  // ── Search auth gate ──
  const searchEl = document.getElementById('search-input-query') as HTMLInputElement | null;
  const mobileSearchEl = document.getElementById('mobile-search-input-query') as HTMLInputElement | null;

  [searchEl, mobileSearchEl].forEach(el => {
    if (!el) return;
    ['focus', 'mousedown', 'keydown'].forEach(evt => {
      el.addEventListener(evt, (e) => {
        const user = localStorage.getItem('visaformula_user');
        if (!user || user === 'null') {
          e.preventDefault();
          e.stopPropagation();
          el.blur();
          alert('Please login to use the search feature.');
          window.location.href = '/login';
        }
      });
    });
  });

  // ── Dynamic Auth Buttons ──
  const userStr = localStorage.getItem('visaformula_user');
  if (userStr && userStr !== 'null') {
    const loginBtn = document.getElementById('login-btn');
    if (loginBtn) {
      loginBtn.setAttribute('href', '/dashboard');
      loginBtn.innerHTML = `<svg class="w-[18px] h-[18px] text-[#0EA5E9]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>`;
      (loginBtn as HTMLElement).style.borderColor = '#0EA5E9';
    }
    const mobileLoginBtn = document.getElementById('mobile-login-btn');
    if (mobileLoginBtn) {
      mobileLoginBtn.textContent = 'My Dashboard';
      mobileLoginBtn.setAttribute('href', '/dashboard');
    }
    const mobileSignupBtn = document.getElementById('mobile-signup-btn');
    if (mobileSignupBtn) {
      mobileSignupBtn.textContent = 'Log Out';
      mobileSignupBtn.setAttribute('href', '#');
      mobileSignupBtn.addEventListener('click', (e) => {
        e.preventDefault();
        localStorage.removeItem('visaformula_user');
        window.location.href = '/';
      });
    }
  }

  // ── Transparent header on hero pages ──
  const header = document.getElementById('main-header');
  const transparentPaths = ['/', '/jobs', '/tours'];
  const isTransparentPage = transparentPaths.includes(window.location.pathname) || window.location.pathname.startsWith('/events');

  function updateHeader() {
    const isDrawerOpen = mobileMenuDrawer && !mobileMenuDrawer.classList.contains('hidden');
    if (isTransparentPage && window.scrollY < 60 && !isDrawerOpen) {
      header?.classList.add('header-transparent');
    } else {
      header?.classList.remove('header-transparent');
    }
  }

  if (header && isTransparentPage) {
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
