---
// src/layouts/Layout.astro
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import MobileNav from '../components/layout/MobileNav.astro';

import { TalkToUs } from '../components/shared/talk-to-us.tsx';
import '../styles/globals.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  canonical?: string;
  schema?: Record<string, any>;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { 
  title, 
  description = "Apply visa smarter, faster, safer. Connect with verified experts, top universities, and track your visa journey — all in one place.", 
  keywords = "visa, immigration, experts, lawyer, consultant, migration, work visa, student visa, express entry, work permit, IELTS",
  ogImage = "/og-image.jpg", 
  canonical,
  schema,
  hideHeader = false,
  hideFooter = false
} = Astro.props;

const currentUrl = canonical || Astro.url.href;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isJobs = Astro.url.pathname === '/jobs' || Astro.url.pathname === '/jobs/';
const isTours = Astro.url.pathname === '/tours' || Astro.url.pathname === '/tours/';
const isEvents = Astro.url.pathname.startsWith('/events');
const isTransparentHeaderPage = isJobs || isTours || isEvents;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes" />
  
  <!-- Primary SEO -->
  <title>{title} | VisaFormula — Global Immigration Marketplace</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <link rel="canonical" href={currentUrl} />
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={`${title} | VisaFormula — Global Immigration Marketplace`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="VisaFormula" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={`${title} | VisaFormula — Global Immigration Marketplace`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  
  <!-- Google Fonts Preconnect & Fetch -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&family=Open+Sans:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Sora:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Poppins:wght@300;400;500;600;700;800;900&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet" />
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  
  <!-- Injected SEO Structured Data -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="font-montserrat antialiased bg-white selection:bg-primary/20 selection:text-primary min-h-screen flex flex-col overflow-x-hidden">
  {!hideHeader && <Header />}
  <main class={`flex-grow ${hideHeader ? "" : "pt-16 lg:pt-20"}`}>
    <slot />
  </main>
  {!hideFooter && <Footer />}

  <TalkToUs client:idle />
</body>
</html>
