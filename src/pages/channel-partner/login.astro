---
// src/pages/channel-partner/login.astro
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import PartnerAuthPortal from '../../components/channel-partner/PartnerAuthPortal';

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('cp_sid')?.value;
if (token) {
  return Astro.redirect('/channel-partner/dashboard');
}
---

<Layout 
  title="Partner Sign In | TravlTik Channel Partner Network" 
  description="Sign in to TravlTik Channel Partner Operating System. Manage state partners, referral consultants, and revenue analytics."
  hideHeader={true}
  hideFooter={true}
>
  <PartnerAuthPortal client:only="react" initialMode="login" />
</Layout>
