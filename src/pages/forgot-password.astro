---
// src/pages/forgot-password.astro
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/landing/LandingPage';
import { ForgotPasswordPortal } from '../components/interactive/ForgotPasswordPortal';
---

<Layout 
  title="Reset Your Password" 
  description="Forgot your password? Reset your password safely on TravlTik to access your visa consulting and seeker portal."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Main Home Page rendered in the background -->
  <LandingPage client:only="react" />

  <!-- Fixed Modal Card Overlay -->
  <ForgotPasswordPortal client:only="react" />
</Layout>
