export async function getStaticPaths() {
  return allClassifieds.map(c => ({
    params: { id: c.id },
    props: { classified: c }
  }));
}

const { id } = Astro.params;
const classified = Astro.props.classified || allClassifieds.find(c => c.id === id) || allClassifieds[0];
---
---

<Layout title={`${classified.title} | VisaFormula Classifieds`}>
  <Header />

  <main class="bg-[#f8fafc] min-h-screen py-8 sm:py-12 font-plus-jakarta">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      {/* Top Breadcrumb Nav */}
      <div class="flex items-center justify-between">
        <a href="/" class="inline-flex items-center gap-2 text-xs font-bold text-slate-600 hover:text-[#00a896] bg-white border border-slate-200 px-4 py-2 rounded-xl shadow-xs transition-all">
          <ArrowLeft class="w-4 h-4" /> Back to Home
        </a>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 bg-teal-50 border border-teal-200 text-[#00a896] text-xs font-extrabold px-3 py-1.5 rounded-xl">
            <Tag class="w-3.5 h-3.5" /> {classified.category}
          </span>
          <span class="inline-flex items-center gap-1.5 bg-slate-900 text-white text-xs font-extrabold px-3 py-1.5 rounded-xl">
            {classified.flag} {classified.country}
          </span>
        </div>
      </div>

      {/* Main Detail Header Card */}
      <div class="bg-white rounded-3xl border border-slate-200/90 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12">
        
        {/* Left: Image Container */}
        <div class="lg:col-span-6 relative min-h-[320px] lg:min-h-[420px] bg-slate-900 overflow-hidden group">
          <img 
            src={classified.img} 
            alt={classified.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-95"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-black/30"></div>
          
          <div class="absolute top-4 left-4 z-10">
            <span class="bg-[#00a896] text-white text-xs font-black px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4" /> Verified Offer
            </span>
          </div>

          <div class="absolute bottom-4 left-4 right-4 text-white z-10 flex items-center justify-between">
            <span class="text-xs font-bold text-slate-200 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-xl border border-white/20">
              📍 {classified.location}
            </span>
            <span class="text-xs font-semibold text-slate-300">
              {classified.time}
            </span>
          </div>
        </div>

        {/* Right: Info & Pricing */}
        <div class="lg:col-span-6 p-6 sm:p-8 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-extrabold text-[#00a896] uppercase tracking-wider bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
                {classified.category}
              </span>
              <span class="text-lg font-black text-emerald-600 bg-emerald-50 px-3.5 py-1 rounded-2xl border border-emerald-200">
                {classified.price}
              </span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 leading-tight">
              {classified.title}
            </h1>

            {/* Poster Info Badge */}
            <div class="p-4 bg-slate-50 border border-slate-200/90 rounded-2xl flex items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-[#00a896] text-white flex items-center justify-center font-black text-lg shadow-md shrink-0">
                  {classified.postedBy.charAt(0)}
                </div>
                <div>
                  <div class="flex items-center gap-1.5">
                    <h3 class="text-sm font-extrabold text-slate-900">{classified.postedBy}</h3>
                    <ShieldCheck class="w-4 h-4 text-[#00a896] shrink-0" />
                  </div>
                  <p class="text-[11px] font-semibold text-slate-500">Verified Platform Consultant</p>
                </div>
              </div>
              <span class="text-[11px] font-extrabold text-emerald-700 bg-emerald-100/80 px-2.5 py-1 rounded-lg">
                Active Member
              </span>
            </div>

            <p class="text-sm text-slate-600 font-medium leading-relaxed">
              {classified.description}
            </p>
          </div>

          {/* Quick Action Buttons */}
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a 
                href={`https://wa.me/${classified.whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hi! I am interested in your classified listing: ${classified.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95"
              >
                <MessageSquare class="w-4 h-4" />
                <span>Chat on WhatsApp</span>
              </a>

              <a 
                href={`tel:${classified.contactPhone}`}
                class="py-3.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs rounded-2xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-95"
              >
                <Phone class="w-4 h-4 text-[#00a896]" />
                <span>Call Expert Now</span>
              </a>
            </div>

            <p class="text-[11px] font-bold text-slate-400 text-center flex items-center justify-center gap-1.5">
              <ShieldCheck class="w-3.5 h-3.5 text-[#00a896]" />
              <span>Verified Listing — Powered by VisaFormula Security Guard</span>
            </p>
          </div>
        </div>

      </div>

      {/* Content Details Grid */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        {/* Left 8 cols: Key Highlights & Eligibility */}
        <div class="lg:col-span-8 space-y-6">
          
          {/* Offer Highlights Card */}
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-md space-y-4">
            <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
              <Sparkles class="w-5 h-5 text-[#00a896]" /> Key Features &amp; Offer Benefits
            </h2>
            <ul class="space-y-3">
              {classified.highlights.map((item, idx) => (
                <li key={idx} class="flex items-start gap-3 p-3 bg-teal-50/50 rounded-2xl border border-teal-100 text-xs sm:text-sm font-semibold text-slate-800">
                  <CheckCircle class="w-4 h-4 text-[#00a896] shrink-0 mt-0.5" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Requirements & Document Checklist */}
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-md space-y-4">
            <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
              <FileText class="w-5 h-5 text-[#00a896]" /> Document &amp; Eligibility Criteria
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {classified.requirements.map((req, idx) => (
                <div key={idx} class="p-3.5 bg-slate-50 border border-slate-200 rounded-2xl text-xs font-semibold text-slate-700 flex items-start gap-2.5">
                  <span class="w-5 h-5 rounded-full bg-slate-900 text-white font-bold text-[10px] flex items-center justify-center shrink-0 mt-0.5">
                    {idx + 1}
                  </span>
                  <span>{req}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

        {/* Right 4 cols: Enquiry & Poster Contact Sidebar */}
        <div class="lg:col-span-4 space-y-6">
          
          <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-6 shadow-xl border border-slate-800 space-y-5">
            <div>
              <span class="text-[10px] font-black uppercase tracking-widest text-[#00a896] bg-[#00a896]/20 px-3 py-1 rounded-full border border-[#00a896]/40">
                Direct Contact
              </span>
              <h3 class="text-lg font-extrabold mt-2">Interested in this Offer?</h3>
              <p class="text-xs text-slate-400 font-medium mt-1">Get in touch directly with {classified.postedBy}</p>
            </div>

            <div class="space-y-3 pt-2">
              <a 
                href={`mailto:${classified.contactEmail}?subject=${encodeURIComponent(`Inquiry regarding Classified: ${classified.title}`)}`}
                class="w-full py-3 px-4 bg-white/10 hover:bg-white/20 border border-white/20 rounded-2xl text-xs font-bold text-white flex items-center gap-3 transition-all truncate"
              >
                <Mail class="w-4 h-4 text-[#00a896] shrink-0" />
                <span class="truncate">{classified.contactEmail}</span>
              </a>

              <a 
                href={`tel:${classified.contactPhone}`}
                class="w-full py-3 px-4 bg-white/10 hover:bg-white/20 border border-white/20 rounded-2xl text-xs font-bold text-white flex items-center gap-3 transition-all"
              >
                <Phone class="w-4 h-4 text-[#00a896] shrink-0" />
                <span>{classified.contactPhone}</span>
              </a>
            </div>

            <a 
              href="/signup/expert"
              class="block w-full py-3.5 bg-[#00a896] hover:bg-[#008f80] text-white text-center font-extrabold text-xs rounded-2xl shadow-lg transition-all"
            >
              Post Your Own Classified Ad &rarr;
            </a>
          </div>

        </div>

      </div>

    </div>
  </main>

  <Footer />
</Layout>
