---
// src/components/layout/Header.astro
const pathname = Astro.url.pathname;
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 bg-white shadow-sm border-b border-gray-100 transition-all duration-300">

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- TOP UTILITY BAR                                      -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="border-b border-gray-100 bg-gray-50/60">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-8 flex items-center justify-end gap-5">
      <a href="/announcements" class="text-[11px] font-semibold text-gray-500 hover:text-[#0EA5E9] transition-colors duration-200">Announcements</a>
      <span class="text-gray-300 text-xs">|</span>
      <a href="/support" class="text-[11px] font-semibold text-gray-500 hover:text-[#0EA5E9] transition-colors duration-200">Contact</a>
      <span class="text-gray-300 text-xs">|</span>
      <a href="/login" id="login-btn" class="text-[11px] font-semibold text-gray-600 hover:text-[#0C1A2E] transition-colors duration-200">Log In</a>
      <a href="/signup" id="signup-btn" class="text-[11px] font-bold bg-[#0EA5E9] hover:bg-[#0284C7] text-white px-3 py-1 rounded-full transition-colors duration-200">Sign Up</a>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- MAIN HEADER ROW                                      -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-[68px] flex items-center gap-4 xl:gap-6">

    <!-- ─── LOGO ─── -->
    <a href="/" class="flex flex-col shrink-0 group select-none" style="text-decoration:none;">
      <div class="flex items-end gap-0 leading-none">
        <!-- Airplane SVG inline -->
        <div class="relative">
          <span class="font-black text-[22px] xl:text-[26px] tracking-[-0.5px] text-[#0C1A2E] group-hover:text-[#0EA5E9] transition-colors duration-300" style="font-family:'Inter',sans-serif; letter-spacing:-1px;">VISA</span>
          <!-- Small airplane above O in FORMULA -->
          <svg class="absolute -top-4 -right-1 w-8 h-8 opacity-90" viewBox="0 0 80 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M10 30 Q30 10 70 5" stroke="url(#airGrad)" stroke-width="2" stroke-dasharray="3 3" fill="none"/>
            <g transform="translate(58,3) rotate(-30)">
              <path d="M0 4 L16 0 L16 3 L8 5 L16 8 L16 11 L0 7 Z" fill="url(#airGrad)"/>
              <path d="M4 5 L-2 2 L-2 4 L4 6 Z" fill="url(#airGrad)" opacity="0.7"/>
              <path d="M4 6 L-2 8 L-2 6 L4 5 Z" fill="url(#airGrad)" opacity="0.7"/>
            </g>
            <defs>
              <linearGradient id="airGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#0EA5E9"/>
                <stop offset="100%" stop-color="#06B6D4"/>
              </linearGradient>
            </defs>
          </svg>
        </div>
        <span class="font-black text-[22px] xl:text-[26px] tracking-[-0.5px] text-[#0C1A2E] group-hover:text-[#0EA5E9] transition-colors duration-300" style="font-family:'Inter',sans-serif; letter-spacing:-1px;">FORMULA</span>
      </div>
      <div class="flex items-center gap-1 mt-0.5 ml-0.5">
        <!-- Teal checkmark -->
        <svg class="w-3 h-2" viewBox="0 0 14 9" fill="none"><path d="M1 4L5 8L13 1" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span class="text-[9px] xl:text-[10px] font-bold tracking-[1.5px] text-[#0EA5E9] uppercase">Global Visa Marketplace</span>
      </div>
    </a>

    <!-- ─── DIVIDER ─── -->
    <div class="hidden md:block w-px h-10 bg-gray-200 shrink-0"></div>

    <!-- ─── TRUST BADGE ─── -->
    <div class="hidden md:flex items-center gap-2.5 shrink-0">
      <!-- Shield icon -->
      <div class="w-10 h-10 rounded-full border-2 border-[#0EA5E9]/30 bg-[#EFF9FF] flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <div class="flex flex-col leading-tight">
        <span class="text-[12px] xl:text-[13px] font-bold text-[#0C1A2E]">Trusted Visa Support</span>
        <span class="text-[11px] xl:text-[12px] font-semibold text-[#0EA5E9]">Guaranteed</span>
      </div>
    </div>

    <!-- ─── DIVIDER ─── -->
    <div class="hidden lg:block w-px h-10 bg-gray-200 shrink-0"></div>

    <!-- ─── MAIN NAV WITH ICONS (Desktop) ─── -->
    <nav class="hidden lg:flex items-center gap-1 xl:gap-2 flex-1 justify-center">

      <!-- Find Expert -->
      <div class="relative group">
        <a href="/find-experts" class={`flex flex-col items-center gap-1 px-3 xl:px-4 py-1.5 rounded-xl hover:bg-gray-50 transition-all duration-200 group ${pathname?.startsWith('/find-experts') ? 'text-[#0EA5E9]' : 'text-[#0C1A2E] hover:text-[#0EA5E9]'}`}>
          <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            <path d="M18 12l2 2 4-4" stroke="#0EA5E9" stroke-width="2"/>
          </svg>
          <span class="text-[12px] xl:text-[13px] font-bold whitespace-nowrap">Find Expert</span>
          {pathname?.startsWith('/find-experts') && <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-[#0EA5E9] rounded-full"></span>}
        </a>
        <!-- Dropdown -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 w-[520px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top z-50">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-3 px-1">Expert Categories</p>
            <div class="grid grid-cols-2 gap-1.5">
              <a href="/find-experts?category=student" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-base shrink-0">🎓</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Student Visa Experts</div><div class="text-[11px] text-gray-400">University admissions guides</div></div>
              </a>
              <a href="/find-experts?category=work" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-8 h-8 rounded-lg bg-green-50 flex items-center justify-center text-base shrink-0">💼</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Job Visa Experts</div><div class="text-[11px] text-gray-400">Work permit & job offers</div></div>
              </a>
              <a href="/find-experts?category=tourist" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-8 h-8 rounded-lg bg-orange-50 flex items-center justify-center text-base shrink-0">✈️</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Visit Visa Experts</div><div class="text-[11px] text-gray-400">Visitor visa & holidays</div></div>
              </a>
              <a href="/find-experts?category=pr" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-8 h-8 rounded-lg bg-purple-50 flex items-center justify-center text-base shrink-0">⚖️</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Immigration Lawyers</div><div class="text-[11px] text-gray-400">PR & permanent residency</div></div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Explore Visa -->
      <div class="relative group">
        <a href="/apply-visa" class={`flex flex-col items-center gap-1 px-3 xl:px-4 py-1.5 rounded-xl hover:bg-gray-50 transition-all duration-200 ${pathname === '/apply-visa' ? 'text-[#0EA5E9]' : 'text-[#0C1A2E] hover:text-[#0EA5E9]'}`}>
          <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="text-[12px] xl:text-[13px] font-bold whitespace-nowrap">Explore Visa</span>
          {pathname === '/apply-visa' && <span class="absolute -bottom-0.5 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-[#0EA5E9] rounded-full"></span>}
        </a>
        <!-- Dropdown -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 w-[400px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top z-50">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-3 px-1">Visa Types</p>
            <div class="flex flex-col gap-1">
              <a href="/apply-visa?type=student" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">🎓</span><span class="text-[13px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Student Visa</span>
              </a>
              <a href="/apply-visa?type=work" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">💼</span><span class="text-[13px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Work Visa</span>
              </a>
              <a href="/apply-visa?type=visit" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">✈️</span><span class="text-[13px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Visit Visa</span>
              </a>
              <a href="/apply-visa?type=pr" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">⚖️</span><span class="text-[13px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">PR / Immigration</span>
              </a>
              <a href="/apply-visa?type=evisa" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">⚡</span><span class="text-[13px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">E-Visa / Visa Free</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Apply Visa -->
      <div class="relative group">
        <a href="/visa-documentation" class={`flex flex-col items-center gap-1 px-3 xl:px-4 py-1.5 rounded-xl hover:bg-gray-50 transition-all duration-200 ${pathname?.startsWith('/visa-documentation') || pathname?.startsWith('/visa-form-filing') ? 'text-[#0EA5E9]' : 'text-[#0C1A2E] hover:text-[#0EA5E9]'}`}>
          <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
            <path d="M9 12l1.5 1.5L13 10" stroke="#0EA5E9" stroke-width="2"/>
          </svg>
          <span class="text-[12px] xl:text-[13px] font-bold whitespace-nowrap">Apply Visa</span>
        </a>
        <!-- Dropdown -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 w-[380px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top z-50">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-3 px-1">Application Services</p>
            <div class="flex flex-col gap-1">
              <a href="/visa-documentation" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center text-sm shrink-0">📋</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Visa Documentation Filing</div><div class="text-[11px] text-gray-400">Expert check & filing of files</div></div>
              </a>
              <a href="/visa-form-filing" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-7 h-7 rounded-lg bg-green-50 flex items-center justify-center text-sm shrink-0">✍️</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Visa Form Filing</div><div class="text-[11px] text-gray-400">Complete application form support</div></div>
              </a>
              <a href="/vfs-appointment" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <div class="w-7 h-7 rounded-lg bg-orange-50 flex items-center justify-center text-sm shrink-0">📅</div>
                <div><div class="text-[13px] font-bold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">VFS Appointment</div><div class="text-[11px] text-gray-400">Schedule & slot booking support</div></div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Our Services -->
      <div class="relative group">
        <a href="/services" class={`flex flex-col items-center gap-1 px-3 xl:px-4 py-1.5 rounded-xl hover:bg-gray-50 transition-all duration-200 ${pathname?.startsWith('/services') ? 'text-[#0EA5E9]' : 'text-[#0C1A2E] hover:text-[#0EA5E9]'}`}>
          <svg class="w-6 h-6 transition-colors duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 19.07a10 10 0 0 1 0-14.14"/>
            <path d="M21 12a9 9 0 0 1-9 9M3 12a9 9 0 0 1 9-9"/>
            <circle cx="12" cy="12" r="1" fill="currentColor"/>
          </svg>
          <span class="text-[12px] xl:text-[13px] font-bold whitespace-nowrap">Our Services</span>
        </a>
        <!-- Dropdown -->
        <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 w-[420px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top z-50">
          <div class="bg-white rounded-2xl border border-gray-100 shadow-xl p-4">
            <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-3 px-1">All Services</p>
            <div class="grid grid-cols-2 gap-1.5">
              <a href="/services/form-fillers" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">📝</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Visa Form Fillers</span>
              </a>
              <a href="/services/travel-insurance" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">🛡️</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Travel Insurance</span>
              </a>
              <a href="/services/airfares" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">✈️</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Airfares Booking</span>
              </a>
              <a href="/training" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">🎓</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Language Training</span>
              </a>
              <a href="/jobs" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">💼</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Job Search</span>
              </a>
              <a href="/emergency" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-[#EFF9FF] transition-all duration-150 group/i">
                <span class="text-base">⚖️</span><span class="text-[12px] font-semibold text-[#0C1A2E] group-hover/i:text-[#0EA5E9]">Legal Help</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- ─── SEARCH + USER (Desktop) ─── -->
    <div class="hidden md:flex items-center gap-2.5 ml-auto shrink-0">
      <!-- Search Country Bar -->
      <div id="search-bar" class="flex items-center gap-2 bg-gray-50 border border-gray-200 hover:border-[#0EA5E9] focus-within:border-[#0EA5E9] focus-within:shadow-[0_0_0_3px_rgba(14,165,233,0.1)] rounded-full px-4 py-2 transition-all duration-200 w-[180px] xl:w-[220px]">
        <svg class="w-4 h-4 text-gray-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input
          id="search-input-query"
          type="text"
          placeholder="Search Country"
          class="bg-transparent border-none outline-none text-[13px] font-semibold text-gray-700 placeholder:text-gray-400 w-full h-full"
        />
      </div>
      <!-- User Avatar Icon -->
      <a href="/login" class="w-9 h-9 rounded-full border-2 border-gray-200 hover:border-[#0EA5E9] bg-gray-50 hover:bg-[#EFF9FF] flex items-center justify-center transition-all duration-200">
        <svg class="w-5 h-5 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </a>
    </div>

    <!-- ─── MOBILE MENU BUTTON ─── -->
    <button id="mobile-menu-btn" class="md:hidden ml-auto p-2 hover:bg-gray-100 rounded-xl transition-colors">
      <svg id="menu-icon" class="w-6 h-6 text-[#0C1A2E]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg id="close-icon" class="w-6 h-6 text-[#0C1A2E] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════ -->
  <!-- CATEGORY CARDS ROW                                   -->
  <!-- ═══════════════════════════════════════════════════ -->
  <div id="category-cards-row" class="hidden lg:block border-t border-gray-100 bg-white">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-3">
      <div class="grid grid-cols-4 gap-3">

        <!-- Card 1: Student Visa Expert -->
        <a href="/find-experts?category=student" class="category-card flex items-center gap-3 bg-white border border-gray-200 rounded-2xl px-4 py-3 hover:border-[#0EA5E9] hover:shadow-md hover:shadow-[#0EA5E9]/10 transition-all duration-250 group">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-50 to-sky-100 flex items-center justify-center text-xl shrink-0 group-hover:scale-110 transition-transform duration-200">🎓</div>
          <div class="flex-1 min-w-0">
            <div class="text-[13px] font-bold text-[#0C1A2E] group-hover:text-[#0EA5E9] transition-colors duration-200 leading-tight">Student Visa Expert</div>
            <div class="text-[11px] text-gray-400 mt-0.5 leading-tight">For Study Abroad</div>
          </div>
          <svg class="w-4 h-4 text-gray-300 group-hover:text-[#0EA5E9] group-hover:translate-x-0.5 transition-all duration-200 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </a>

        <!-- Card 2: Job Visa Expert -->
