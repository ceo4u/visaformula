---
// src/components/Logo.astro

interface Props {
  variant?: 'navbar-light' | 'navbar-dark' | 'footer' | 'icon';
  className?: string;
}

const { variant = 'navbar-light', className = '' } = Astro.props;
---

{variant === 'icon' && (
  <img
    src="/logo/visaformula-navbar.png"
    alt="TravlTik Logo"
    class={`h-10 w-auto ${className}`}
  />
)}

{variant === 'navbar-light' && (
  <img
    src="/logo.png?v=6"
    alt="TravlTik - Global Visa Marketplace"
    class={`h-12 sm:h-14 lg:h-[64px] max-h-[66px] w-auto object-contain navbar-logo ${className}`}
  />
)}

{variant === 'navbar-dark' && (
  <img
    src="/logo.png?v=6"
    alt="TravlTik - Global Visa Marketplace"
    class={`h-12 sm:h-14 lg:h-[64px] max-h-[66px] w-auto object-contain navbar-logo navbar-logo-dark ${className}`}
  />
)}

{variant === 'footer' && (
  <img
    src="/logo/visaformula-brand.png"
    alt="TravlTik - Global Visa Marketplace"
    class={`h-32 w-auto object-contain footer-logo ${className}`}
  />
)}

<style is:global>
  /* Invert logo to white for dark backgrounds */
  .navbar-logo-dark,
  .footer-logo,
  #main-header.header-transparent .navbar-logo {
    filter: brightness(0) invert(1);
  }
  
  /* Smooth transition for logo color changes */
  .navbar-logo {
    transition: filter 0.3s ease;
  }
</style>
