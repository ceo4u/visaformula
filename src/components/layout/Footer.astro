---
// src/components/layout/Footer.astro
import { Shield, Lock, Phone, Mail, MapPin, ChevronRight, Facebook, Twitter, Instagram, Linkedin } from 'lucide-react';
import Logo from '../Logo.astro';

const consultantLinks = [
  { label: "Register as a Consultant", href: "/register-provider" },
  { label: "Consultant Dashboard Login", href: "/consultant/dashboard" },
  { label: "Verification Guidelines", href: "/verification-guidelines" },
  { label: "Find Opportunities", href: "/jobs" },
];

const securityLinks = [
  { label: "How Escrow Keeps You Safe", href: "/escrow" },
  { label: "Anti-Fraud Policy", href: "/anti-fraud-policy" },
  { label: "Terms of Marketplace Service", href: "/terms" },
  { label: "Customer Support Helpdesk", href: "/support" },
];

const seekerLinks = [
  { label: "Find Verified Experts", href: "/find-experts" },
  { label: "AI Visa Eligibility", href: "/readiness" },
  { label: "Visa Guides", href: "/visa-guide" },
  { label: "VFS Global Appointment", href: "/vfs-booking" },
];

const companyLinks = [
  { label: "Find Experts", href: "/find-experts" },
  { label: "Careers", href: "/careers" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6 py-10 sm:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <div>
        <h4 class="font-sans text-[13px] font-bold tracking-wider text-white mb-4">
          For Consultants
        </h4>
        <ul class="space-y-3">
          {consultantLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-sans text-[13px] font-bold tracking-wider text-white mb-4">
          Security & Trust
        </h4>
        <ul class="space-y-3">
          {securityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex items-center gap-2 text-xs text-gray-500">
          <Lock class="w-4 h-4 text-green-400" />
          <span class="text-xs text-gray-400">100% Escrow Protected</span>
        </div>
      </div>

      <div>
        <h4 class="font-sans text-[13px] font-bold tracking-wider text-white mb-4">
          For Seekers
        </h4>
        <ul class="space-y-3">
          {seekerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-sans text-[13px] font-bold tracking-wider text-white mb-4">
          Company
        </h4>
        <ul class="space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-[#1E293B]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-4">
            <Phone class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">+91 766 1989 366</span>
          </div>
          <div class="flex items-center gap-4">
            <Mail class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">support@travltik.com</span>
          </div>
          <div class="flex items-center gap-4">
            <MapPin class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">Hyderabad, India (Global HQ)</span>
          </div>
        </div>
        
        <div class="flex flex-wrap items-center gap-6 md:justify-end">
          <div class="flex items-center gap-2">
            <Lock class="w-4 h-4 text-green-400" />
            <span class="text-xs text-gray-400 font-sans">Escrow Protected</span>
          </div>
          <div class="flex items-center gap-2">
            <Shield class="w-4 h-4 text-green-400" />
            <span class="text-xs text-gray-400 font-sans">KYC Verified</span>
          </div>
          <a href="/find-experts" class="flex items-center gap-2 hover:text-white transition-colors group">
            <span class="text-amber-400 text-xs">⭐</span>
            <span class="text-xs text-gray-400 group-hover:text-white font-sans underline decoration-slate-700 underline-offset-4">4.9/5 Verified Reviews</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Statutory Legal & Consular Discretion Disclaimer -->
  <div class="border-t border-[#1E293B] bg-slate-950/90 py-8 px-6">
    <div class="max-w-5xl mx-auto text-center space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-[11px] font-bold text-amber-400">
        <span>⚖️</span> Statutory Regulatory Disclosure
      </div>
      <p class="text-[12px] sm:text-[13px] text-gray-400 font-sans leading-relaxed max-w-4xl mx-auto">
        <strong class="text-white font-semibold">Important Disclaimer:</strong> TravlTik is an independent private mobility marketplace and digital document preparation technology platform, not an embassy, consular post, or government agency. Final visa adjudication, entry visas, and border authorizations rest exclusively with the sovereign immigration authorities of the destination country.
      </p>
      <div class="flex flex-wrap justify-center items-center gap-4 text-[11px] text-gray-500 pt-2 font-sans">
        <span class="inline-flex items-center gap-1 text-slate-400"><Lock class="w-3.5 h-3.5 text-emerald-400" /> Logiqall Escrow Protected</span>
        <span>•</span>
        <span class="inline-flex items-center gap-1 text-slate-400"><Shield class="w-3.5 h-3.5 text-emerald-400" /> Bank-Grade 256-Bit SSL Encryption</span>
        <span>•</span>
        <span class="text-slate-400">Registered Corporate Entity: Logiqall Technologies Ltd.</span>
      </div>
    </div>
  </div>

  <div class="border-t border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500 font-sans">
        © 2026 Logiqall Technologies. All rights reserved.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 items-center">
        <div class="flex gap-6 text-xs font-sans">
          <a href="/privacy" class="text-gray-500 hover:text-gray-300 transition-colors">
            Privacy Policy
          </a>
          <a href="/terms" class="text-gray-500 hover:text-gray-300 transition-colors">
            Terms of Service
          </a>
          <a href="/cookie" class="text-gray-500 hover:text-gray-300 transition-colors">
            Cookie Policy
          </a>
        </div>
        <div class="flex gap-4 items-center">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors" aria-label="Facebook">
            <Facebook class="w-4 h-4" />
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors" aria-label="Twitter">
            <Twitter class="w-4 h-4" />
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors" aria-label="Instagram">
            <Instagram class="w-4 h-4" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="text-gray-500 hover:text-white transition-colors" aria-label="LinkedIn">
            <Linkedin class="w-4 h-4" />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
