<style is:global>
  /* ──────────────────────────────────────────────────────── */
  /* HEADER HEIGHT OFFSET FOR BODY CONTENT                    */
  /* ──────────────────────────────────────────────────────── */
  body {
    padding-top: 0;
  }

  /* Category card hover underline indicator */
  .category-card {
    position: relative;
    overflow: hidden;
  }
  .category-card::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: #0EA5E9;
    border-radius: 99px;
    transition: width 0.25s ease;
  }
  .category-card:hover::before {
    width: 80%;
  }

  /* Transparent header mode (for hero pages) */
  #main-header.header-transparent {
    background-color: transparent !important;
    border-color: transparent !important;
    box-shadow: none !important;
  }
  #main-header.header-transparent #category-cards-row {
    background-color: transparent !important;
    border-color: transparent !important;
  }
  #main-header.header-transparent .category-card {
    background: rgba(255,255,255,0.08) !important;
    border-color: rgba(255,255,255,0.2) !important;
    backdrop-filter: blur(8px);
  }
  #main-header.header-transparent .category-card .text-\[\#0C1A2E\] {
    color: white !important;
  }
  #main-header.header-transparent .category-card .text-gray-400 {
    color: rgba(255,255,255,0.6) !important;
  }
</style>

<script>
  // ── Mobile menu toggle ──
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  if (mobileMenuBtn && mobileMenuDrawer && menuIcon && closeIcon) {
    mobileMenuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenuDrawer.classList.contains('hidden');
      if (isOpen) {
        mobileMenuDrawer.classList.add('hidden');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        mobileMenuDrawer.classList.remove('hidden');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }

  // ── Auth gate for search ──
  const searchInputs = [
    document.getElementById('search-input-query'),
    document.getElementById('mobile-search-input-query'),
  ];
  searchInputs.forEach(el => {
    if (el) {
      ['focus', 'mousedown', 'keydown'].forEach(evt => {
        el.addEventListener(evt, (e) => {
          const user = localStorage.getItem("visaformula_user");
          if (!user || user === "null") {
            e.preventDefault();
            e.stopPropagation();
            if (el instanceof HTMLInputElement) el.blur();
            alert("Please login to use the search feature.");
            window.location.href = "/login";
          }
        });
      });
    }
  });

  // ── Dynamic Auth Buttons ──
  const userStr = localStorage.getItem("visaformula_user");
  if (userStr && userStr !== "null") {
    // Desktop
    const loginBtn = document.getElementById("login-btn");
    const signupBtn = document.getElementById("signup-btn");
    if (loginBtn) {
      loginBtn.textContent = "Dashboard";
      loginBtn.setAttribute("href", "/dashboard");
    }
    if (signupBtn) {
      signupBtn.textContent = "Log Out";
      signupBtn.setAttribute("href", "#");
      signupBtn.addEventListener("click", (e) => {
        e.preventDefault();
        localStorage.removeItem("visaformula_user");
        window.location.href = "/";
      });
    }
    // Mobile
    const mobileLoginBtn = document.getElementById("mobile-login-btn");
    const mobileSignupBtn = document.getElementById("mobile-signup-btn");
    if (mobileLoginBtn) {
      mobileLoginBtn.textContent = "Dashboard";
      mobileLoginBtn.setAttribute("href", "/dashboard");
    }
    if (mobileSignupBtn) {
      mobileSignupBtn.textContent = "Log Out";
      mobileSignupBtn.setAttribute("href", "#");
      mobileSignupBtn.addEventListener("click", (e) => {
        e.preventDefault();
        localStorage.removeItem("visaformula_user");
        window.location.href = "/";
      });
    }
  }

  // ── Transparent header on hero pages ──
  const header = document.getElementById('main-header');
  const isTransparentPage = ['/', '/jobs', '/tours'].includes(window.location.pathname) || window.location.pathname.startsWith('/events');

  function updateHeader() {
    const isDrawerOpen = mobileMenuDrawer && !mobileMenuDrawer.classList.contains('hidden');
    if (isTransparentPage && window.scrollY < 50 && !isDrawerOpen) {
      header?.classList.add('header-transparent');
    } else {
      header?.classList.remove('header-transparent');
    }
  }

  if (header && isTransparentPage) {
    updateHeader();
    window.addEventListener('scroll', updateHeader, { passive: true });
  }
</script>
