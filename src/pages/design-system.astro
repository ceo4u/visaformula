---
// src/pages/design-system.astro
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Design System — Typography & Interactions"
  description="Premium typography system and micro-interactions showcase for VisaFormula."
>
  <div class="bg-white min-h-screen pb-32">

    <!-- ═══════════════════════════════════════════
         HERO HEADER
    ══════════════════════════════════════════════ -->
    <section class="bg-[#111111] text-white px-6 py-24 text-center">
      <span class="inline-block text-xs font-semibold tracking-widest uppercase text-white/50 mb-4 border border-white/20 rounded-full px-4 py-1.5">
        VisaFormula · Design System v2.0
      </span>
      <h1 class="text-white font-extrabold mb-5" style="font-family: 'Montserrat', sans-serif; letter-spacing: -0.02em;">
        Premium Typography<br />& Micro-Interactions
      </h1>
      <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
        A complete Montserrat-based design language with Yelp-inspired hierarchy, hardware-accelerated hover effects, and production-ready interaction patterns.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-10">
        <button class="btn-invert">Explore Components</button>
        <button class="btn-invert-outline" style="border-color: white; color: white;">View on GitHub</button>
      </div>
    </section>

    <div class="max-w-6xl mx-auto px-6">

      <!-- ═══════════════════════════════════════════
           SECTION 1: TYPOGRAPHY HIERARCHY
      ══════════════════════════════════════════════ -->
      <section class="py-20 border-b border-gray-100">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 01</span>
          <h2 style="font-family: 'Montserrat', sans-serif;">Typography Hierarchy</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">Montserrat applied across all heading levels with precise weight, tracking, and color tokens.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-16">
          <!-- Left: Headings scale -->
          <div class="space-y-6">
            <div class="p-8 rounded-2xl bg-gray-50 border border-gray-100 space-y-5">
              <h1 class="leading-none m-0">H1 — Hero Title</h1>
              <h2 class="m-0">H2 — Section Heading</h2>
              <h3 class="m-0">H3 — Card Title</h3>
              <h4 class="m-0">H4 — Sub-heading</h4>
              <h5 class="m-0">H5 — Label Heading</h5>
              <h6 class="m-0">H6 — Micro Label</h6>
            </div>
          </div>

          <!-- Right: Text styles -->
          <div class="space-y-6">
            <div class="p-8 rounded-2xl bg-gray-50 border border-gray-100 space-y-5">
              <!-- Body -->
              <div>
                <div class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Body — Regular 400</div>
                <p class="text-base leading-relaxed text-[#333333] m-0">
                  Discover visa opportunities, connect with verified immigration experts, and track your journey from application to approval — all in one trusted platform.
                </p>
              </div>
              <!-- Semibold nav -->
              <div>
                <div class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Navigation — Semibold 600, 15px</div>
                <p class="m-0" style="font-family: 'Montserrat', sans-serif; font-weight: 600; font-size: 15px; color: #2b2b2b;">
                  Find Experts &nbsp;·&nbsp; Apply Visa &nbsp;·&nbsp; Tours &nbsp;·&nbsp; Jobs &nbsp;·&nbsp; About
                </p>
              </div>
              <!-- Muted footer -->
              <div>
                <div class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">Footer / Meta — Regular 400, 14px</div>
                <p class="text-meta m-0">
                  Last updated: June 20, 2026 &nbsp;·&nbsp; © 2026 VisaFormula Inc. &nbsp;·&nbsp; All rights reserved
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           SECTION 2: PREMIUM CARD ELEVATION
      ══════════════════════════════════════════════ -->
      <section class="py-20 border-b border-gray-100">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 02</span>
          <h2>Premium Card Lift</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">Yelp-inspired box-shadow expansion with <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">translateY(-6px)</code> on hover. Hardware-accelerated with <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">will-change</code>.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <!-- Card 1: Feature Card -->
          <div class="premium-card p-7 cursor-pointer">
            <div class="w-12 h-12 rounded-xl bg-[#111111] flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-base mb-2">Verified Experts</h3>
            <p class="text-[#666666] text-sm leading-relaxed">Connect with licensed immigration attorneys in 40+ countries. Every consultant is background-checked and rating-verified.</p>
            <a href="/find-experts" class="link-underline mt-4 inline-block">Read More →</a>
          </div>

          <!-- Card 2: Feature Card -->
          <div class="premium-card p-7 cursor-pointer">
            <div class="w-12 h-12 rounded-xl bg-[#111111] flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-base mb-2">Global Opportunities</h3>
            <p class="text-[#666666] text-sm leading-relaxed">Browse 4,200+ job listings across Canada, UK, Australia, and 40 countries — all with work permit guidance included.</p>
            <a href="/jobs" class="link-underline mt-4 inline-block">Explore Jobs →</a>
          </div>

          <!-- Card 3: Feature Card -->
          <div class="premium-card p-7 cursor-pointer">
            <div class="w-12 h-12 rounded-xl bg-[#111111] flex items-center justify-center mb-5">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="text-base mb-2">Secure Escrow</h3>
            <p class="text-[#666666] text-sm leading-relaxed">Pay safely with milestone-based releases. Your funds are held securely until visa milestones are successfully completed.</p>
            <a href="/escrow" class="link-underline mt-4 inline-block">Learn More →</a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           SECTION 3: BUTTON INVERSION
      ══════════════════════════════════════════════ -->
      <section class="py-20 border-b border-gray-100">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 03</span>
          <h2>Button Inversion Fill</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">Smooth color inversion on hover — solid fills invert to outline, and vice versa. 300ms ease-in-out transitions.</p>
        </div>

        <div class="flex flex-wrap items-center gap-5">
          <button class="btn-invert" id="btn-primary">Get Started</button>
          <button class="btn-invert-outline" id="btn-outline">Learn More</button>
          <button class="btn-cta bg-[#111111] text-white px-6 py-3 rounded-xl border-2 border-[#111111] hover:bg-white hover:text-[#111111] transition-all duration-300 cursor-pointer" id="btn-rounded">Apply Visa →</button>
          <button class="btn-cta bg-white text-[#111111] px-6 py-3 rounded-xl border-2 border-gray-200 hover:border-[#111111] hover:bg-[#111111] hover:text-white transition-all duration-300 cursor-pointer" id="btn-ghost">Find Experts</button>
        </div>

        <!-- Badge showcase -->
        <div class="flex flex-wrap items-center gap-3 mt-8">
          <span class="badge-cta bg-[#111111] text-white px-4 py-1.5 rounded-full text-sm">All-Inclusive</span>
          <span class="badge-cta bg-gray-100 text-[#111111] px-4 py-1.5 rounded-full text-sm">Business Delegation</span>
          <span class="badge-cta border border-[#111111] text-[#111111] px-4 py-1.5 rounded-full text-sm">Verified Expert</span>
          <span class="badge-cta bg-emerald-50 text-emerald-700 border border-emerald-200 px-4 py-1.5 rounded-full text-sm">✓ Approved</span>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           SECTION 4: IMAGE ZOOM
      ══════════════════════════════════════════════ -->
      <section class="py-20 border-b border-gray-100">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 04</span>
          <h2>Image Zoom on Hover</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">Overflow-hidden container reveals a smooth <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">scale(1.06)</code> transform over 0.5s on hover. Combine with premium-card for full effect.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="premium-card overflow-hidden group cursor-pointer">
            <div class="img-zoom-container h-52">
              <img 
                src="https://images.unsplash.com/photo-1530521954074-e64f6810b32d?w=800&h=500&fit=crop&q=85"
                alt="International travel"
                class="img-zoom-image"
              />
            </div>
            <div class="p-5">
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Tourist Visa</span>
              <h3 class="text-sm mt-1 mb-1">Explore the World</h3>
              <p class="text-gray-500 text-xs leading-relaxed">Plan your dream vacation with full visa support from verified travel experts.</p>
            </div>
          </div>

          <div class="premium-card overflow-hidden group cursor-pointer">
            <div class="img-zoom-container h-52">
              <img 
                src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=800&h=500&fit=crop&q=85"
                alt="Professional team"
                class="img-zoom-image"
              />
            </div>
            <div class="p-5">
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Work Visa</span>
              <h3 class="text-sm mt-1 mb-1">Build Your Career Abroad</h3>
              <p class="text-gray-500 text-xs leading-relaxed">Access thousands of verified employer-sponsored job listings across the globe.</p>
            </div>
          </div>

          <div class="premium-card overflow-hidden group cursor-pointer">
            <div class="img-zoom-container h-52">
              <img 
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800&h=500&fit=crop&q=85"
                alt="University campus"
                class="img-zoom-image"
              />
            </div>
            <div class="p-5">
              <span class="text-[10px] font-black uppercase tracking-widest text-gray-400">Student Visa</span>
              <h3 class="text-sm mt-1 mb-1">Study at Top Universities</h3>
              <p class="text-gray-500 text-xs leading-relaxed">Get admission guidance and student visa processing from certified consultants.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           SECTION 5: LINK EXPANDING UNDERLINE
      ══════════════════════════════════════════════ -->
      <section class="py-20 border-b border-gray-100">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 05</span>
          <h2>Expanding Underline Links</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">CSS <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">::after</code> pseudo-element expands symmetrically from center on hover using <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">left/right</code> transitions.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-12">
          <div class="space-y-6">
            <div class="premium-card p-8 space-y-5">
              <h3 class="text-sm mb-3">Navigation Style Links</h3>
              <div class="space-y-4">
                <div><a href="/find-experts" class="link-underline">Find Immigration Experts</a></div>
                <div><a href="/apply-visa" class="link-underline">Apply for Visa Online</a></div>
                <div><a href="/vfs-booking" class="link-underline">Book VFS Appointment</a></div>
                <div><a href="/jobs" class="link-underline">Explore Overseas Jobs</a></div>
                <div><a href="/tours" class="link-underline">Browse Tour Packages</a></div>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="premium-card p-8">
              <h3 class="text-sm mb-4">Article / Blog Style</h3>
              <p class="text-[#333333] text-sm leading-relaxed mb-4">
                VisaFormula's platform connects you with over 500 verified immigration attorneys and consultants worldwide. Every expert is background-checked, credentialed, and available for real-time consultations.
              </p>
              <a href="/about" class="link-underline text-sm">Read Our Full Story →</a>

              <div class="mt-6 pt-5 border-t border-gray-100">
                <p class="text-[#333333] text-sm leading-relaxed mb-4">
                  From tourist visas to permanent residency programs, our step-by-step process ensures your application is error-free and approved on the first attempt.
                </p>
                <a href="/services" class="link-underline text-sm">Explore All Services →</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════
           SECTION 6: TEAM SOCIAL OVERLAY
      ══════════════════════════════════════════════ -->
      <section class="py-20">
        <div class="mb-12">
          <span class="text-[11px] font-black uppercase tracking-widest text-gray-400 block mb-2">Section 06</span>
          <h2>Team Profile Cards</h2>
          <p class="text-gray-500 text-sm mt-2 max-w-lg">Social overlay slides up from <code class="bg-gray-100 px-1.5 py-0.5 rounded text-xs">translateY(20px) opacity-0</code> to fully visible on hover — perfect for team or expert profile grids.</p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">

          <!-- Team Member 1 -->
          <div class="premium-card overflow-hidden cursor-pointer">
            <div class="team-card h-64">
              <img 
                src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=400&h=400&fit=crop&q=85"
                alt="Rahul Sharma"
                class="w-full h-full object-cover"
              />
              <div class="team-social-overlay">
                <div class="flex gap-3">
                  <a href="#" aria-label="LinkedIn" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 hover:border-white transition-all duration-200">
                    <svg class="w-4 h-4 text-white hover:text-[#111111]" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                  <a href="#" aria-label="Twitter" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 hover:border-white transition-all duration-200">
                    <svg class="w-4 h-4 text-white hover:text-[#111111]" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                  </a>
                  <a href="#" aria-label="Email" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 hover:border-white transition-all duration-200">
                    <svg class="w-4 h-4 text-white hover:text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  </a>
                </div>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-sm mb-0.5">Rahul Sharma</h3>
              <p class="text-meta">Immigration Attorney · Canada</p>
            </div>
          </div>

          <!-- Team Member 2 -->
          <div class="premium-card overflow-hidden cursor-pointer">
            <div class="team-card h-64">
              <img 
                src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&h=400&fit=crop&q=85"
                alt="Sarah Mitchell"
                class="w-full h-full object-cover"
              />
              <div class="team-social-overlay">
                <div class="flex gap-3">
                  <a href="#" aria-label="LinkedIn" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 transition-all duration-200">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                  <a href="#" aria-label="Twitter" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 transition-all duration-200">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                  </a>
                </div>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-sm mb-0.5">Sarah Mitchell</h3>
              <p class="text-meta">Visa Consultant · UK</p>
            </div>
          </div>

          <!-- Team Member 3 -->
          <div class="premium-card overflow-hidden cursor-pointer">
            <div class="team-card h-64">
              <img 
                src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&q=85"
                alt="David Chen"
                class="w-full h-full object-cover"
              />
              <div class="team-social-overlay">
                <div class="flex gap-3">
                  <a href="#" aria-label="LinkedIn" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 transition-all duration-200">
                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                  </a>
                  <a href="#" aria-label="Email" class="w-9 h-9 bg-white/20 hover:bg-white rounded-full flex items-center justify-center backdrop-blur-sm border border-white/30 transition-all duration-200">
                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                  </a>
                </div>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-sm mb-0.5">David Chen</h3>
