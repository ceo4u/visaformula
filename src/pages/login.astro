---
// src/pages/login.astro
import Layout from '../layouts/Layout.astro';
import { AuthModalPortal } from '../components/interactive/AuthModalPortal';
---

<Layout 
  title="Sign In to VisaFormula" 
  description="Sign in to your VisaFormula visa consultation account. Complete your application filing, check upcoming session schedules, and upload passport document scans."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Mount client-only React auth modal portal island matching reference design -->
  <AuthModalPortal client:only="react" initialTab="login" />
</Layout>
