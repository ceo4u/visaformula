---
// src/components/layout/Header.astro
import { Search, MapPin, Menu, X, Globe, ChevronDown, GraduationCap, Briefcase, Compass, Scale, FileText, Calendar, PenLine, HeartHandshake, Plane, DollarSign, LogOut, LayoutDashboard, MessageSquare } from 'lucide-react';
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-white border-b border-slate-200/80 shadow-2xs">
    <div class="max-w-[1440px] mx-auto px-4 lg:px-8 relative flex items-center justify-between h-16 lg:h-20">
        
        <!-- Logo - Left corner -->
        <div class="flex items-center shrink-0 py-2">
            <a href="/" class="flex items-center focus:outline-none -ml-2 lg:-ml-4">
                <img id="header-logo-img" src="/logo.png" class="h-16 lg:h-20 w-auto object-contain transition-all duration-200" alt="VisaFormula Logo" />
            </a>
        </div>

        <!-- Desktop Navigation Links (Centered) -->
        <nav class="hidden lg:flex items-center gap-3.5 xl:gap-7 font-plus-jakarta">
            <!-- 1. Find Consultants -->
            <div class="relative py-3 group">
                <button class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-[#0c1a2e] group-hover:text-[#2563eb] transition-all duration-200 flex items-center gap-1 focus:outline-none">
                    Find Consultants
                    <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#2563eb] transition-all duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[260px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-left z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3 flex flex-col gap-1">
                        <a href="/find-experts?category=student" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <GraduationCap class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Student Visa Experts</span>
                        </a>
                        <a href="/find-experts?category=work" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Briefcase class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Work & Job Visa Experts</span>
                        </a>
                        <a href="/find-experts?category=pr" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Compass class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">PR Agencies</span>
                        </a>
                        <a href="/emergency" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Scale class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Migration Agents & Lawyers</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 2. Self Apply (Direct link, no dropdown, between Find Consultants and Visa Services) -->
            <a href="/self-apply" class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-[#0c1a2e] hover:text-[#2563eb] transition-colors whitespace-nowrap">
                Self Apply
            </a>

            <!-- 3. Visa Services -->
            <div class="relative py-3 group">
                <button class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-[#0c1a2e] group-hover:text-[#2563eb] transition-all duration-200 flex items-center gap-1 focus:outline-none">
                    Visa Services
                    <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#2563eb] transition-all duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[270px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-left z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3 flex flex-col gap-1 text-slate-800">
                        <a href="/visa-documentation" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <FileText class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Visa Documentation Filing</span>
                        </a>
                        <a href="/visa-form-filing" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <FileText class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Visa Form Filing</span>
                        </a>
                        <a href="/vfs-appointment" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Calendar class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">VFS Appointment Support</span>
                        </a>
                        <a href="/services/form-fillers" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <PenLine class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Visa Form Fillers</span>
                        </a>
                        <a href="/services/travel-insurance" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <HeartHandshake class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Travel Insurance</span>
                        </a>
                        <a href="/services/airfares" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Plane class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Airfares Booking</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 4. Latest News & offers -->
            <div class="relative py-3 group">
                <button class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-[#0c1a2e] group-hover:text-[#2563eb] transition-all duration-200 flex items-center gap-1 focus:outline-none">
                    Latest News & offers
                    <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#2563eb] transition-all duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[250px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-left z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3 flex flex-col gap-1 text-slate-800">
                        <a href="/visa-guide" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <FileText class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Immigration News & Updates</span>
                        </a>
                        <a href="/visa-guide" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Compass class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Policy Changes 2026</span>
                        </a>
                        <a href="/success-stories" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <FileText class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Success Stories</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- 5. AI Tools -->
            <div class="relative py-3 group">
                <button class="font-plus-jakarta text-[14px] xl:text-[15px] font-semibold text-[#0c1a2e] group-hover:text-[#2563eb] transition-all duration-200 flex items-center gap-1 focus:outline-none">
                    AI Tools
                    <ChevronDown class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#2563eb] transition-all duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[260px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-left z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3 flex flex-col gap-1 text-slate-800">
                        <a href="/tools" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <FileText class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Migration Tools Portal</span>
                        </a>
                        <a href="/tools" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Compass class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">CRS Points Calculator</span>
                        </a>
                        <a href="/tools" class="flex items-center gap-2.5 py-2 px-3 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-[#2563eb] transition-all duration-150 group/item">
                            <Scale class="w-4 h-4 text-slate-400 group-hover/item:text-[#2563eb] transition-colors" />
                            <span class="text-[14px] font-semibold">Eligibility Checker</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Right Side Actions (Globe selector, Auth Buttons / Profile Block) -->
        <div class="hidden lg:flex items-center gap-3.5 xl:gap-5 shrink-0 z-50 font-plus-jakarta">
            <!-- Contact Link (Replaces Globe selector) -->
            <a href="/support" id="contact-btn" class="flex items-center gap-1.5 text-[14px] xl:text-[15px] font-bold text-[#0c1a2e] hover:text-[#2563eb] transition-colors focus:outline-none">
                <MessageSquare class="w-4.5 h-4.5 text-slate-500" />
                <span>Contact</span>
            </a>

            <!-- Subtle Divider (shown only when logged in) -->
            <div id="nav-logged-in-divider" class="w-px h-5 shrink-0 mx-1.5 hidden bg-slate-200"></div>

            <!-- Auth Buttons Wrapper -->
            <div class="flex items-center gap-3" id="nav-auth-buttons-wrapper">
                <a href="/login" id="login-btn" class="text-[#2563eb] border border-[#2563eb] hover:bg-blue-50/40 px-4 py-1.5 rounded-lg text-[14px] font-bold transition-all duration-200">
                    Log in
                </a>
                <a href="/signup" id="signup-btn" class="bg-[#2563eb] hover:bg-[#1d4ed8] text-white px-5 py-1.5 rounded-lg text-[14px] font-bold transition-all duration-200 shadow-md">
                    Sign Up
                </a>
            </div>

            <!-- Desktop Profile Dropdown (visible when logged in) -->
            <div id="nav-profile-block" class="relative hidden py-2 group font-plus-jakarta">
                <button id="nav-profile-trigger" class="flex items-center gap-2.5 pl-1.5 pr-3.5 py-1.5 border rounded-full transition-all focus:outline-none shadow-2xs bg-slate-50 hover:bg-slate-100 text-slate-900 border-slate-200">
                    <div class="w-8 h-8 rounded-full overflow-hidden flex items-center justify-center bg-slate-900 text-white shadow-2xs shrink-0" id="nav-profile-avatar-container">
                        <img id="nav-profile-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                        <span class="font-bold text-xs" id="nav-profile-avatar-letters">U</span>
                    </div>
                    <span id="nav-profile-pill-name" class="font-bold text-xs max-w-[110px] truncate">My Account</span>
                    <ChevronDown class="w-3.5 h-3.5 shrink-0 text-slate-400" />
                </button>
                
                <!-- Dropdown Menu -->
                <div class="absolute right-0 top-[90%] pt-4 w-[220px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 transform origin-top-right z-50">
                    <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-2.5 flex flex-col gap-1.5">
                        <div class="px-3.5 py-2 border-b border-slate-100">
                            <div class="text-[10px] text-slate-400 font-bold tracking-wider">Signed in as</div>
                            <div class="text-sm font-bold text-black truncate mt-0.5" id="nav-profile-name">User Profile</div>
                        </div>
                        <a id="nav-profile-dashboard-link" href="/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50/70 transition-all group/item">
                            <LayoutDashboard class="w-4 h-4 text-slate-400 group-hover/item:text-blue-600 transition-colors" />
                            <span>My Dashboard</span>
                        </a>
                        <button id="nav-profile-logout-btn" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50/70 transition-all w-full text-left cursor-pointer border-none bg-transparent group/item">
                            <LogOut class="w-4 h-4 text-slate-400 group-hover/item:text-blue-600 transition-colors" />
                            <span>Log Out</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Toggler (Hamburger + Mobile Sign Up Button / Logged In Profile Icon) -->
        <div class="flex items-center gap-2 lg:hidden z-50">
            <a href="/signup" id="mobile-top-signup-btn" class="bg-[#2563eb] hover:bg-blue-700 text-white px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all duration-200 shadow-sm">
                Sign Up
            </a>
            <a href="/dashboard" id="mobile-top-profile-btn" class="hidden items-center justify-center w-9 h-9 rounded-full border border-slate-300 bg-black text-white hover:scale-105 transition-all overflow-hidden shrink-0 shadow-sm">
                <img id="mobile-top-profile-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                <span class="font-black text-xs text-white bg-black w-full h-full flex items-center justify-center" id="mobile-top-profile-avatar-letters">D</span>
            </a>
            <button id="mobile-menu-btn" class={`p-2 rounded-xl transition-colors flex items-center justify-center focus:outline-none ${isHome ? 'text-white' : 'text-slate-800'}`}>
                <span id="menu-icon" class="block">
                    <Menu class="w-6.5 h-6.5 stroke-[2.2]" />
                </span>
                <span id="close-icon" class="hidden">
                    <X class="w-6.5 h-6.5 stroke-[2.2]" />
                </span>
            </button>
        </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu-drawer" class="hidden lg:hidden w-full bg-white border-t border-gray-100 shadow-lg max-h-[calc(100vh-64px)] overflow-y-auto z-40 transition-all duration-300">
        <div class="flex flex-col py-4 px-4 gap-1">
            
            <!-- Mobile Find Consultants Accordion -->
            <div class="border-b border-gray-50 py-1.5">
                <button id="mobile-find-expert-btn" class="w-full flex items-center justify-between py-2 text-sm font-semibold text-navy hover:bg-gray-50 rounded-lg">
                    <span>Find Consultants</span>
                    <ChevronDown id="mobile-find-expert-arrow" class="w-4 h-4 text-gray-400 transition-transform duration-300" />
                </button>
                <div id="mobile-find-expert-drawer" class="hidden pl-4 py-1 flex flex-col gap-1.5 bg-slate-50/50 rounded-lg">
                    <a href="/find-experts?category=student" class="block py-1.5 text-xs text-slate-600 font-medium">Student Visa Experts</a>
                    <a href="/find-experts?category=work" class="block py-1.5 text-xs text-slate-600 font-medium">Work & Job Visa Experts</a>
                    <a href="/find-experts?category=pr" class="block py-1.5 text-xs text-slate-600 font-medium">PR Agencies</a>
                    <a href="/emergency" class="block py-1.5 text-xs text-slate-600 font-medium">Migration Agents & Lawyers</a>
                </div>
            </div>

            <!-- Mobile Self Apply Link -->
            <div class="border-b border-gray-50 py-2.5">
                <a href="/self-apply" class="block py-1 text-sm font-semibold text-navy hover:text-[#2563eb] transition-colors">
                    Self Apply
                </a>
            </div>

            <!-- Mobile Our Services Accordion -->
            <div class="border-b border-gray-50 py-1.5">
                <button id="mobile-visa-services-btn" class="w-full flex items-center justify-between py-2 text-sm font-semibold text-navy hover:bg-gray-50 rounded-lg">
                    <span>Our Services</span>
                    <ChevronDown id="mobile-visa-services-arrow" class="w-4 h-4 text-gray-400 transition-transform duration-300" />
                </button>
                <div id="mobile-visa-services-drawer" class="hidden pl-4 py-1 flex flex-col gap-1.5 bg-slate-50/50 rounded-lg">
                    <a href="/visa-documentation" class="block py-1.5 text-xs text-slate-600 font-medium">Visa Documentation Filing</a>
                    <a href="/visa-form-filing" class="block py-1.5 text-xs text-slate-600 font-medium">Visa Form Filing</a>
                    <a href="/vfs-appointment" class="block py-1.5 text-xs text-slate-600 font-medium">VFS Appointment Support</a>
                    <a href="/services/form-fillers" class="block py-1.5 text-xs text-slate-600 font-medium">Visa Form Fillers</a>
                    <a href="/services/travel-insurance" class="block py-1.5 text-xs text-slate-600 font-medium">Travel Insurance</a>
                    <a href="/services/airfares" class="block py-1.5 text-xs text-slate-600 font-medium">Airfares Booking</a>
                </div>
            </div>



            <!-- Mobile Latest offers Accordion -->
            <div class="border-b border-gray-50 py-1.5">
                <button id="mobile-latest-news-btn" class="w-full flex items-center justify-between py-2 text-sm font-semibold text-navy hover:bg-gray-50 rounded-lg">
                    <span>Latest offers</span>
                    <ChevronDown id="mobile-latest-news-arrow" class="w-4 h-4 text-gray-400 transition-transform duration-300" />
                </button>
                <div id="mobile-latest-news-drawer" class="hidden pl-4 py-1 flex flex-col gap-1.5 bg-slate-50/50 rounded-lg">
                    <a href="/visa-guide" class="block py-1.5 text-xs text-slate-600 font-medium">Immigration News & Updates</a>
                    <a href="/visa-guide" class="block py-1.5 text-xs text-slate-600 font-medium">Policy Changes 2026</a>
                    <a href="/success-stories" class="block py-1.5 text-xs text-slate-600 font-medium">Success Stories</a>
                </div>
            </div>

            <!-- Mobile Tools Accordion -->
            <div class="border-b border-gray-50 py-1.5">
                <button id="mobile-tools-btn" class="w-full flex items-center justify-between py-2 text-sm font-semibold text-navy hover:bg-gray-50 rounded-lg">
                    <span>AI Tools</span>
                    <ChevronDown id="mobile-tools-arrow" class="w-4 h-4 text-gray-400 transition-transform duration-300" />
                </button>
                <div id="mobile-tools-drawer" class="hidden pl-4 py-1 flex flex-col gap-1.5 bg-slate-50/50 rounded-lg">
                    <a href="/tools" class="block py-1.5 text-xs text-slate-600 font-medium">Migration Tools Portal</a>
                    <a href="/tools" class="block py-1.5 text-xs text-slate-600 font-medium">CRS Points Calculator</a>
                    <a href="/tools" class="block py-1.5 text-xs text-slate-600 font-medium">Eligibility Checker</a>
                </div>
            </div>

            <!-- Mobile Contact Link (Replaces Globe Lang Selector) -->
            <div class="border-b border-gray-50 py-2.5">
                <a href="/support" class="flex items-center gap-2 text-sm font-semibold text-navy hover:text-[#2563eb] transition-colors">
                    <MessageSquare class="w-4.5 h-4.5 text-slate-500" />
                    <span>Contact</span>
                </a>
            </div>

            <!-- Mobile Portal Auth Actions -->
            <div id="mobile-nav-auth-buttons" class="py-4 flex flex-col gap-2">
                <a href="/login" class="block text-center py-2.5 border border-blue-600 text-blue-600 font-semibold text-sm rounded-xl hover:bg-blue-50/50 transition-colors">
                    Log in
                </a>
                <a href="/signup" class="block text-center py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-sm shadow-md">
                    Sign Up
                </a>
            </div>

            <!-- Mobile Profile Actions (Visible when logged in) -->
            <div id="mobile-nav-profile-block" class="hidden py-4 border-t border-slate-200/60 flex flex-col gap-2 font-sans">
                <div class="px-2 py-1">
                    <div class="text-[10px] text-slate-400 font-bold tracking-wider">Signed in as</div>
                    <div class="text-sm font-extrabold text-black truncate mt-0.5" id="mobile-nav-profile-name">User Profile</div>
                </div>
                <a id="mobile-nav-profile-dashboard-link" href="/dashboard" class="block text-center py-2.5 bg-black text-white font-bold text-sm rounded-xl shadow-md">
                    My Dashboard
                </a>
                <button id="mobile-nav-profile-logout-btn" class="block text-center py-2.5 border border-slate-250 text-red-650 font-bold text-sm rounded-xl hover:bg-red-50 transition-colors w-full cursor-pointer bg-white">
                    Log Out
                </button>
            </div>
        </div>
    </div>
</header>



<script>
    // Toggle Mobile Drawer Menu & Sync Header Background
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
    const menuIcon = document.getElementById('menu-icon');
    const closeIcon = document.getElementById('close-icon');
    const headerElement = document.getElementById("main-header");
    const logoImgElement = document.getElementById("header-logo-img");

    if (mobileMenuBtn && mobileMenuDrawer && menuIcon && closeIcon) {
        mobileMenuBtn.addEventListener('click', () => {
            const isOpen = !mobileMenuDrawer.classList.contains('hidden');
            if (isOpen) {
                // Closing Drawer
                mobileMenuDrawer.classList.add('hidden');
                menuIcon.classList.remove('hidden');
                menuIcon.classList.add('block');
                closeIcon.classList.add('hidden');
                closeIcon.classList.remove('block');
                if (window.scrollY <= 10 && (window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname.endsWith('/'))) {
                    headerElement.className = "fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-gradient-to-b from-black/85 via-black/40 to-transparent border-none text-white";
                    if (logoImgElement) logoImgElement.setAttribute("src", "/logo-white.png");
                    mobileMenuBtn.style.color = "white";
                }
            } else {
                // Opening Drawer — Enforce 100% Solid Pure White Header
                mobileMenuDrawer.classList.remove('hidden');
                menuIcon.classList.add('hidden');
                menuIcon.classList.remove('block');
                closeIcon.classList.remove('hidden');
                closeIcon.classList.add('block');
                if (headerElement) {
                    headerElement.className = "fixed top-0 left-0 w-full z-50 transition-all duration-300 scrolled-header bg-white shadow-sm border-b border-slate-200/80 text-slate-800";
                }
                if (logoImgElement) logoImgElement.setAttribute("src", "/logo.png");
                mobileMenuBtn.style.color = "#0c1a2e";
            }
        });
    }

    // Toggle Mobile Accordions
    const accordions = [
        { btn: 'mobile-find-expert-btn', drawer: 'mobile-find-expert-drawer', arrow: 'mobile-find-expert-arrow' },
        { btn: 'mobile-visa-services-btn', drawer: 'mobile-visa-services-drawer', arrow: 'mobile-visa-services-arrow' },
        { btn: 'mobile-latest-news-btn', drawer: 'mobile-latest-news-drawer', arrow: 'mobile-latest-news-arrow' },
        { btn: 'mobile-tools-btn', drawer: 'mobile-tools-drawer', arrow: 'mobile-tools-arrow' },
    ];

    accordions.forEach(({ btn, drawer, arrow }) => {
        const btnEl = document.getElementById(btn);
        const drawerEl = document.getElementById(drawer);
        const arrowEl = document.getElementById(arrow);
        if (btnEl && drawerEl && arrowEl) {
            btnEl.addEventListener('click', () => {
                const isHidden = drawerEl.classList.contains('hidden');
                if (isHidden) {
                    drawerEl.classList.remove('hidden');
                    arrowEl.classList.add('rotate-180');
                } else {
                    drawerEl.classList.add('hidden');
                    arrowEl.classList.remove('rotate-180');
                }
            });
        }
    });

    // Dynamic Scroll Header Background Transition on Homepage
    const isHomePage = window.location.pathname === '/' || window.location.pathname === '' || window.location.pathname.endsWith('/');
    const headerEl = document.getElementById("main-header");
    const logoImgEl = document.getElementById("header-logo-img");
    const loginBtnEl = document.getElementById("login-btn");
    const contactBtnEl = document.getElementById("contact-btn");
    const navContainer = document.querySelector("#main-header nav");

    if (isHomePage && headerEl) {
        const updateHeaderStyle = () => {
            const scrolled = window.scrollY > 10;
            const drawerIsOpen = mobileMenuDrawer && !mobileMenuDrawer.classList.contains('hidden');
            if (scrolled || drawerIsOpen) {
                // 100% Solid Pure White Header on scroll or open drawer
                headerEl.className = "fixed top-0 left-0 w-full z-50 transition-all duration-300 scrolled-header bg-white shadow-sm border-b border-slate-200/80 text-slate-800";
                if (logoImgEl) logoImgEl.setAttribute("src", "/logo.png");
                if (loginBtnEl) loginBtnEl.className = "text-[#2563eb] border-[#2563eb] hover:bg-blue-50/50 border px-4 py-1.5 rounded-lg text-[14px] font-bold transition-all duration-200";
                if (contactBtnEl) contactBtnEl.className = "flex items-center gap-1.5 text-[14px] xl:text-[15px] font-bold text-[#0c1a2e] hover:text-[#2563eb] transition-colors focus:outline-none";
                if (mobileMenuBtn) mobileMenuBtn.style.color = "#0c1a2e";
                if (navContainer) {
                    navContainer.querySelectorAll("button, a").forEach((el) => {
                        if (!el.closest(".absolute")) {
                            el.style.color = "#0c1a2e";
                        }
                    });
                    navContainer.querySelectorAll("svg").forEach((svg) => {
                        svg.style.color = "#0c1a2e";
                    });
                }
            } else {
                // Completely transparent header over top of hero skyline
                headerEl.className = "fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-gradient-to-b from-black/85 via-black/40 to-transparent border-none text-white";
                if (logoImgEl) logoImgEl.setAttribute("src", "/logo-white.png");
                if (loginBtnEl) loginBtnEl.className = "text-white border-white/80 hover:bg-white/10 border px-4 py-1.5 rounded-lg text-[14px] font-bold transition-all duration-200";
                if (contactBtnEl) contactBtnEl.className = "flex items-center gap-1.5 text-[14px] xl:text-[15px] font-bold text-white hover:text-cyan-300 transition-colors focus:outline-none";
                if (mobileMenuBtn) mobileMenuBtn.style.color = "white";
                if (navContainer) {
                    navContainer.querySelectorAll("button, a").forEach((el) => {
                        if (!el.closest(".absolute")) {
                            el.style.color = "";
                        }
                    });
                    navContainer.querySelectorAll("svg").forEach((svg) => {
                        svg.style.color = "";
                    });
                }
            }
        };

        window.addEventListener("scroll", updateHeaderStyle, { passive: true });
        window.addEventListener("resize", updateHeaderStyle, { passive: true });
        document.addEventListener("DOMContentLoaded", updateHeaderStyle);
        updateHeaderStyle();
    }
    // Dynamic Auth Header Button & Profile Dropdown Updates
    const seekerFirst = localStorage.getItem("seeker_firstName");
    const expertBusiness = localStorage.getItem("expert_businessName");
    const userStr = localStorage.getItem("visaformula_user");

    const isLoggedIn = seekerFirst || expertBusiness || (userStr && userStr !== "null");

    if (isLoggedIn) {
        // Hide standard Auth buttons
        const desktopAuthButtons = document.getElementById("nav-auth-buttons-wrapper");
        const mobileAuthButtons = document.getElementById("mobile-nav-auth-buttons");
        const loggedInDivider = document.getElementById("nav-logged-in-divider");
        const mobileTopSignupBtn = document.getElementById("mobile-top-signup-btn");
        
        if (desktopAuthButtons) desktopAuthButtons.classList.add("hidden");
        if (mobileAuthButtons) mobileAuthButtons.classList.add("hidden");
        if (loggedInDivider) loggedInDivider.classList.remove("hidden");
        if (mobileTopSignupBtn) mobileTopSignupBtn.classList.add("hidden");

        // Prepare info
        let displayName = "User Profile";
        let displayLetters = "U";
        let dashboardHref = "/dashboard";
        let displayPhoto = "";

        if (expertBusiness) {
            displayName = expertBusiness;
            displayLetters = expertBusiness.charAt(0).toUpperCase();
            dashboardHref = "/consultant/dashboard";
            displayPhoto = localStorage.getItem("expert_profilePhoto") || "";
        } else if (seekerFirst) {
            displayName = seekerFirst + " " + (localStorage.getItem("seeker_lastName") || "");
            displayLetters = seekerFirst.charAt(0).toUpperCase();
            dashboardHref = "/dashboard";
            displayPhoto = localStorage.getItem("seeker_profilePhoto") || "";
        } else if (userStr) {
            try {
                const u = JSON.parse(userStr);
                if (u && u.displayName) {
                    displayName = u.displayName;
                    displayLetters = u.displayName.charAt(0).toUpperCase();
                } else if (u && u.email) {
                    displayName = u.email;
                    displayLetters = u.email.charAt(0).toUpperCase();
                }
                if (u && u.photoURL) {
                    displayPhoto = u.photoURL;
                }
                if (u && u.type === "expert") {
                    dashboardHref = "/consultant/dashboard";
                } else {
                    dashboardHref = "/dashboard";
                }
            } catch(e) {}
        }

        // Show Desktop Profile Block
        const desktopProfileBlock = document.getElementById("nav-profile-block");
        if (desktopProfileBlock) {
            desktopProfileBlock.classList.remove("hidden");
            const avatarLetters = document.getElementById("nav-profile-avatar-letters");
            const avatarImg = document.getElementById("nav-profile-avatar-img");
            const profileName = document.getElementById("nav-profile-name");
            const pillName = document.getElementById("nav-profile-pill-name");
            const dashboardLink = document.getElementById("nav-profile-dashboard-link");

            if (profileName) profileName.textContent = displayName;
            if (pillName) pillName.textContent = displayName.split(" ")[0];
            if (dashboardLink) dashboardLink.setAttribute("href", dashboardHref);
            
            if (displayPhoto && avatarImg) {
                avatarImg.setAttribute("src", displayPhoto);
                avatarImg.classList.remove("hidden");
                if (avatarLetters) avatarLetters.classList.add("hidden");
            } else {
                if (avatarLetters) avatarLetters.textContent = displayLetters;
                if (avatarLetters) avatarLetters.classList.remove("hidden");
                if (avatarImg) avatarImg.classList.add("hidden");
            }
        }

        // Show Mobile Top Header Profile Icon Button (Next to Hamburger)
        const mobileTopProfileBtn = document.getElementById("mobile-top-profile-btn");
        if (mobileTopProfileBtn) {
            mobileTopProfileBtn.classList.remove("hidden");
            mobileTopProfileBtn.classList.add("flex");
            mobileTopProfileBtn.setAttribute("href", dashboardHref);
            
            const mobileTopAvatarLetters = document.getElementById("mobile-top-profile-avatar-letters");
            const mobileTopAvatarImg = document.getElementById("mobile-top-profile-avatar-img");

            if (displayPhoto && mobileTopAvatarImg) {
                mobileTopAvatarImg.setAttribute("src", displayPhoto);
                mobileTopAvatarImg.classList.remove("hidden");
                if (mobileTopAvatarLetters) mobileTopAvatarLetters.classList.add("hidden");
            } else {
                if (mobileTopAvatarLetters) mobileTopAvatarLetters.textContent = displayLetters;
                if (mobileTopAvatarLetters) mobileTopAvatarLetters.classList.remove("hidden");
                if (mobileTopAvatarImg) mobileTopAvatarImg.classList.add("hidden");
            }
        }

        // Show Mobile Profile Block in Drawer
        const mobileProfileBlock = document.getElementById("mobile-nav-profile-block");
        if (mobileProfileBlock) {
            mobileProfileBlock.classList.remove("hidden");
            mobileProfileBlock.style.display = "flex";
            const mobileProfileName = document.getElementById("mobile-nav-profile-name");
            const mobileDashboardLink = document.getElementById("mobile-nav-profile-dashboard-link");

            if (mobileProfileName) mobileProfileName.textContent = displayName;
            if (mobileDashboardLink) mobileDashboardLink.setAttribute("href", dashboardHref);
        }

        // Handle Logout triggers
        const handleLogout = (e) => {
            e.preventDefault();
            localStorage.removeItem("visaformula_user");
            localStorage.removeItem("seeker_firstName");
            localStorage.removeItem("seeker_lastName");
            localStorage.removeItem("seeker_email");
            localStorage.removeItem("seeker_phone");
            localStorage.removeItem("seeker_passportCountry");
            localStorage.removeItem("seeker_goals");
            localStorage.removeItem("seeker_destinations");
            localStorage.removeItem("seeker_profilePhoto");
            
            localStorage.removeItem("expert_businessName");
            localStorage.removeItem("expert_email");
            localStorage.removeItem("expert_contactNumber");
            localStorage.removeItem("expert_advisorType");
            localStorage.removeItem("expert_aboutMe");
            localStorage.removeItem("expert_portfolioLink");
            localStorage.removeItem("expert_officeAddress");
            localStorage.removeItem("expert_govRegNumber");
            localStorage.removeItem("expert_expertiseTags");
            localStorage.removeItem("expert_countriesExpertise");
            localStorage.removeItem("expert_profilePhoto");
            localStorage.removeItem("expert_isLoggedIn");
            
            window.location.href = "/";
        };

        const desktopLogoutBtn = document.getElementById("nav-profile-logout-btn");
        const mobileLogoutBtn = document.getElementById("mobile-nav-profile-logout-btn");

        if (desktopLogoutBtn) desktopLogoutBtn.addEventListener("click", handleLogout);
        if (mobileLogoutBtn) mobileLogoutBtn.addEventListener("click", handleLogout);
    }
</script>

<style is:global>
    #main-header.scrolled-header {
        background-color: #ffffff !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        background-image: none !important;
        box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.06) !important;
        border-bottom: 1px solid rgba(226, 232, 240, 0.8) !important;
    }
</style>
