---
// src/components/layout/Header.astro
import { Search, MapPin, Menu, X, Globe, ChevronDown, Umbrella, Trophy, Ship, Music, GraduationCap, FileText, Calendar, Briefcase, Compass, Scale, Map, Plane, PenLine, HeartHandshake, Clock, FileCheck, Users } from 'lucide-react';

const pathname = Astro.url.pathname;

// Dropdown Items (keeping your existing data)
const tourDropdownItems = [
    { title: "Holiday Packages", desc: "Visa + hotel + itinerary", href: "/tours?category=holiday", icon: Umbrella, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Sport Tours", desc: "Live events + stadium visits", href: "/tours?category=sports", icon: Trophy, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Cruises", desc: "Ocean & river voyages", href: "/tours?category=cruises", icon: Ship, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Entertainment Events", desc: "Concerts, shows & festivals", href: "/tours?category=events", icon: Music, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "E-visas / Visa Free Travel", desc: "Fast-track electronic visas", href: "/apply-visa?type=evisa", icon: Plane, iconColor: "text-blue-500", bg: "bg-blue-50" },
    { title: "Custom Tour Packages", desc: "Tailored international itineraries", href: "/tours?category=custom", icon: Compass, iconColor: "text-sky-500", bg: "bg-sky-50" }
];

const eventDropdownItems = [
    { title: "Exhibitions", desc: "Trade shows & expos worldwide", href: "/events/exhibitions", icon: Globe, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Universities Fairs", desc: "Meet top universities directly", href: "/events/university-fairs", icon: GraduationCap, iconColor: "text-sky-500", bg: "bg-sky-50" }
];

const servicesDropdownItems = [
    { title: "Visa Documentation Filing", desc: "Expert check & filing", href: "/visa-documentation", icon: FileText, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Visa Form Filing", desc: "Complete support for forms", href: "/visa-form-filing", icon: FileText, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "VFS Appointment", desc: "Schedule and slot booking", href: "/vfs-appointment", icon: Calendar, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Visa Form Fillers", desc: "Error-free application drafting", href: "/services/form-fillers", icon: PenLine, iconColor: "text-indigo-500", bg: "bg-indigo-50" },
    { title: "Travel Insurance Providers", desc: "International travel health cover", href: "/services/travel-insurance", icon: HeartHandshake, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Airfares Booking", desc: "Flight itinerary reservations", href: "/services/airfares", icon: Plane, iconColor: "text-purple-500", bg: "bg-purple-50" }
];

const expertDropdownItems = [
    { title: "Student Visa Experts", desc: "Top university admission guides", href: "/find-experts?category=student", icon: GraduationCap, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Work & Job Visa Experts", desc: "Work permit & job offer", href: "/find-experts?category=work", icon: Briefcase, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "PR Agencies", desc: "Express Entry & PR", href: "/find-experts?category=pr", icon: Compass, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Tourist Visa Agents", desc: "Visitor visa & packages", href: "/find-experts?category=tourist", icon: Umbrella, iconColor: "text-sky-500", bg: "bg-sky-50" },
    { title: "Canada Specialists", desc: "Express Entry, PNP & study", href: "/find-experts?country=Canada", icon: MapPin, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "US Immigration Lawyers", desc: "H-1B, L-1 & green card", href: "/find-experts?country=USA", icon: Scale, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "UK Consultants", desc: "UK student & work visas", href: "/find-experts?country=UK", icon: Map, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Schengen / Europe Experts", desc: "Schengen & blue cards", href: "/find-experts?country=Schengen", icon: Globe, iconColor: "text-rose-500", bg: "bg-rose-50" }
];
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 bg-white border-b border-gray-100 shadow-sm transition-all duration-300">
    
    <!-- ============================================ -->
    <!-- TOP ROW: Logo + Search + User Actions        -->
    <!-- ============================================ -->
    <div class="max-w-7xl mx-auto flex items-center justify-between px-4 md:px-6 h-16 gap-4">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group shrink-0">
            <div class="w-9 h-9 bg-black text-white rounded-xl flex items-center justify-center group-hover:rotate-12 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/>
                    <path d="M2 12h20"/>
                </svg>
            </div>
            <span class="font-bold text-2xl tracking-tight text-slate-900">Visa<span class="text-sky-500">Formula</span></span>
        </a>

        <!-- ============================================ -->
        <!-- SEARCH BAR (Atlys.com Style)                 -->
        <!-- ============================================ -->
        <div class="hidden lg:flex flex-1 max-w-2xl mx-6">
            <div class="relative w-full">
                <!-- Main Search Input -->
                <div class="flex items-center bg-gray-50 border border-gray-200 rounded-full px-5 py-2.5 focus-within:border-sky-400 focus-within:bg-white focus-within:shadow-md transition-all duration-200">
                    <Search class="w-4 h-4 text-gray-400 mr-3 shrink-0" />
                    <input 
                        id="search-input"
                        class="flex-1 bg-transparent border-0 focus:ring-0 text-sm text-gray-800 placeholder:text-gray-400 outline-none"
                        placeholder="Search country, visa type, or destination..."
                        type="text"
                    />
                    <button id="search-btn" class="bg-sky-500 hover:bg-sky-600 text-white text-sm font-semibold px-4 py-1.5 rounded-full ml-2 transition-all">
                        Search
                    </button>
                </div>

                <!-- Filter Pills (Below Search — Atlys.com Style) -->
                <div class="flex items-center gap-2 mt-2.5 flex-wrap">
                    <span class="text-xs font-semibold text-gray-400 mr-1">Visa delivery:</span>
                    <button class="text-xs font-medium text-gray-700 bg-white border border-gray-200 px-3 py-1 rounded-full hover:border-sky-300 transition-all flex items-center gap-1">
                        Any Time <ChevronDown class="w-3 h-3" />
                    </button>
                    
                    <span class="text-xs font-semibold text-gray-400 ml-2 mr-1">Type:</span>
                    <button class="text-xs font-medium text-gray-700 bg-white border border-gray-200 px-3 py-1 rounded-full hover:border-sky-300 transition-all flex items-center gap-1">
                        All Visa Types <ChevronDown class="w-3 h-3" />
                    </button>
                    
                    <span class="text-xs font-semibold text-gray-400 ml-2 mr-1">Documents:</span>
                    <button class="text-xs font-medium text-gray-700 bg-white border border-gray-200 px-3 py-1 rounded-full hover:border-sky-300 transition-all flex items-center gap-1">
                        Any Documents <ChevronDown class="w-3 h-3" />
                    </button>
                    
                    <span class="text-xs font-semibold text-gray-400 ml-2 mr-1">Holidays:</span>
                    <button class="text-xs font-medium text-gray-700 bg-white border border-gray-200 px-3 py-1 rounded-full hover:border-sky-300 transition-all flex items-center gap-1">
                        Select Dates <ChevronDown class="w-3 h-3" />
                    </button>
                </div>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- RIGHT: User Actions                          -->
        <!-- ============================================ -->
        <div class="hidden lg:flex items-center gap-4 shrink-0">
            <a href="/announcements" class="text-sm font-medium text-gray-600 hover:text-sky-500 transition-all flex items-center gap-1">
                <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                Announcements
            </a>
            <a href="/support" class="text-sm font-medium text-gray-600 hover:text-sky-500 transition-all">
                Contact
            </a>
            
            <div class="w-px h-5 bg-gray-200"></div>
            
            <a href="/login" class="text-sm font-medium text-gray-600 hover:text-sky-500 transition-all">
                Log In
            </a>
            <a href="/signup" class="bg-sky-500 hover:bg-sky-600 text-white font-semibold text-sm px-5 py-2 rounded-full shadow-sm hover:shadow-md transition-all">
                Sign Up
            </a>
        </div>

        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 hover:bg-gray-100 rounded-xl transition-colors">
            <Menu class="w-6 h-6 text-slate-900" />
        </button>
    </div>

    <!-- ============================================ -->
    <!-- BOTTOM ROW: Category Navigation (Desktop)    -->
    <!-- ============================================ -->
    <div class="hidden lg:block border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-6 flex items-center gap-1 h-11">
            
            <!-- Find Experts Dropdown -->
            <div class="relative group">
                <button class="flex items-center gap-1 px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all group-hover:text-sky-500">
                    Find Experts
                    <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[520px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                    <div class="bg-white rounded-xl border border-gray-100 shadow-xl p-3">
                        <div class="grid grid-cols-2 gap-1">
                            {expertDropdownItems.map((item) => {
                                const IconComponent = item.icon;
                                return (
                                    <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 transition-all">
                                        <IconComponent class={`w-4 h-4 ${item.iconColor}`} />
                                        <span class="text-sm font-medium text-gray-700 hover:text-sky-500">{item.title}</span>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Apply Visa -->
            <a href="/apply-visa" class="px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all">
                Apply Visa
            </a>

            <!-- Visit Visa Dropdown -->
            <div class="relative group">
                <button class="flex items-center gap-1 px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all group-hover:text-sky-500">
                    Visit Visa
                    <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[480px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                    <div class="bg-white rounded-xl border border-gray-100 shadow-xl p-3">
                        <div class="grid grid-cols-2 gap-1">
                            {tourDropdownItems.map((item) => {
                                const IconComponent = item.icon;
                                return (
                                    <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 transition-all">
                                        <IconComponent class={`w-4 h-4 ${item.iconColor}`} />
                                        <span class="text-sm font-medium text-gray-700 hover:text-sky-500">{item.title}</span>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student Visa -->
            <a href="/student-visa" class="px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all">
                Student Visa
            </a>

            <!-- Our Services Dropdown -->
            <div class="relative group">
                <button class="flex items-center gap-1 px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all group-hover:text-sky-500">
                    Our Services
                    <ChevronDown class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" />
                </button>
                <div class="absolute top-full left-0 pt-2 w-[480px] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                    <div class="bg-white rounded-xl border border-gray-100 shadow-xl p-3">
                        <div class="grid grid-cols-2 gap-1">
                            {servicesDropdownItems.map((item) => {
                                const IconComponent = item.icon;
                                return (
                                    <a href={item.href} class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-50 transition-all">
                                        <IconComponent class={`w-4 h-4 ${item.iconColor}`} />
                                        <span class="text-sm font-medium text-gray-700 hover:text-sky-500">{item.title}</span>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Job Seeker Visas -->
            <a href="/jobs" class="px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all">
                Job Seeker Visas
            </a>

            <!-- Legal Assistance -->
            <a href="/emergency" class="px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all">
                Legal Assistance
            </a>

            <!-- Migration Visas -->
            <a href="/find-experts?category=pr" class="px-3 py-2 text-sm font-semibold text-gray-700 hover:text-sky-500 transition-all">
                Migration Visas
            </a>

            <!-- List Your Practice (High Contrast CTA) -->
            <a href="/register-provider" class="ml-auto px-4 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-full transition-all shadow-sm hover:shadow-md">
                List Your Practice
            </a>

        </div>
    </div>

    <!-- ============================================ -->
    <!-- MOBILE DRAWER                                  -->
    <!-- ============================================ -->
    <div id="mobile-menu-drawer" class="hidden lg:hidden bg-white border-t border-gray-100 shadow-xl max-h-[85vh] overflow-y-auto">
        
        <!-- Mobile Search -->
        <div class="p-4 border-b border-gray-100 bg-gray-50/30 space-y-2">
            <div class="flex items-center bg-white rounded-xl px-3 py-2 border border-gray-200">
                <Search class="w-4 h-4 text-gray-400 mr-2 shrink-0" />
                <input class="flex-1 bg-transparent outline-none text-sm placeholder:text-gray-400" placeholder="Search..." type="text" />
            </div>
            <button class="w-full py-2.5 bg-sky-500 text-white rounded-xl font-semibold text-sm">
                Search
            </button>
        </div>
        
        <!-- Mobile Links -->
        <a href="/find-experts" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Find Experts</a>
        <a href="/apply-visa" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Apply Visa</a>
        <a href="/visit-visa" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Visit Visa</a>
        <a href="/student-visa" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Student Visa</a>
        <a href="/services" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Our Services</a>
        <a href="/jobs" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Job Seeker Visas</a>
        <a href="/emergency" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Legal Assistance</a>
        <a href="/find-experts?category=pr" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Migration Visas</a>
        
        <a href="/announcements" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50 flex items-center gap-2">
            <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span> Announcements
        </a>
        <a href="/support" class="block px-4 py-3 border-b border-gray-50 font-semibold text-sm text-gray-700 hover:bg-gray-50">Contact</a>
        
        <!-- Mobile Actions -->
        <div class="p-4 flex flex-col gap-2">
            <a href="/login" class="block text-center py-2.5 border border-gray-200 text-gray-700 font-semibold text-sm rounded-xl hover:bg-gray-50">Log In</a>
            <a href="/signup" class="block text-center py-2.5 bg-sky-500 text-white rounded-xl font-semibold text-sm shadow-sm">Sign Up</a>
            <a href="/register-provider" class="block text-center py-2.5 bg-black text-white rounded-xl font-semibold text-sm">List Your Practice</a>
        </div>
    </div>

</header>

<style is:global>
    /* Header transitions for transparent mode on home/hero pages */
    #main-header.header-transparent {
        background-color: transparent !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }
    #main-header.header-transparent .logo-text {
        color: white !important;
    }
    #main-header.header-transparent .top-link {
        color: rgba(255,255,255,0.8) !important;
    }
    #main-header.header-transparent .top-link:hover {
        color: white !important;
    }
    #main-header.header-transparent #login-btn {
        color: white !important;
        border-color: rgba(255,255,255,0.3) !important;
    }
    #main-header.header-transparent .nav-link {
        color: rgba(255,255,255,0.8) !important;
    }
    #main-header.header-transparent .nav-link:hover {
        color: white !important;
    }
    #main-header.header-transparent .search-container {
        background: rgba(255,255,255,0.15) !important;
        border-color: rgba(255,255,255,0.2) !important;
        backdrop-filter: blur(8px) !important;
    }
    #main-header.header-transparent .search-container input {
        color: white !important;
    }
    #main-header.header-transparent .search-container input::placeholder {
        color: rgba(255,255,255,0.6) !important;
    }
    #main-header.header-transparent .filter-pill {
        background: rgba(255,255,255,0.1) !important;
        border-color: rgba(255,255,255,0.2) !important;
        color: rgba(255,255,255,0.8) !important;
    }
    #main-header.header-transparent .filter-pill:hover {
        background: rgba(255,255,255,0.2) !important;
    }
    #main-header.header-transparent .filter-label {
        color: rgba(255,255,255,0.5) !important;
    }
</style>

<script>
    // Mobile Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    if (mobileBtn && mobileDrawer) {
        mobileBtn.addEventListener('click', () => {
            mobileDrawer.classList.toggle('hidden');
        });
    }

    // Header Transparency on Scroll (for home/hero pages)
    const header = document.getElementById('main-header');
    const isTransparentPage = window.location.pathname === '/' || window.location.pathname === '';

    function updateHeader() {
        if (isTransparentPage && window.scrollY < 80) {
            header.classList.add('header-transparent');
        } else {
            header.classList.remove('header-transparent');
        }
    }

    if (isTransparentPage) {
        updateHeader();
        window.addEventListener('scroll', updateHeader);
    }

    // Auth Check for Search
    const searchInput = document.getElementById('search-input');
    const searchBtn = document.getElementById('search-btn');
    
    function checkAuth(e) {
        const user = localStorage.getItem("visaformula_user");
        if (!user || user === "null") {
            e.preventDefault();
            alert("Please login to search");
            window.location.href = "/login";
        }
    }
    
    if (searchInput) searchInput.addEventListener('focus', checkAuth);
    if (searchBtn) searchBtn.addEventListener('click', checkAuth);
</script>
