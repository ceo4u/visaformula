---
// src/pages/reset-password.astro
import Layout from '../layouts/Layout.astro';
import LandingPage from '../components/landing/LandingPage';
import { ResetPasswordPortal } from '../components/interactive/ResetPasswordPortal';
---

<Layout 
  title="Create New Password" 
  description="Reset your TravlTik account password securely to log back into your Immigration and Expert workspace."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Main Home Page rendered in the background -->
  <LandingPage client:only="react" />

  <!-- Fixed Modal Card Overlay -->
  <ResetPasswordPortal client:only="react" />
</Layout>
