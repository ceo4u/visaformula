---
// src/pages/signup/expert.astro
// Detailed Expert Signup Portal rendered in a popup modal over the live LandingPage
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/landing/LandingPage';
import { ExpertSignupPortal } from '../../components/interactive/ExpertSignupPortal';
---

<Layout 
  title="Sign Up as Expert - VisaFormula" 
  description="Register as an immigration expert on VisaFormula to consult clients and grow your global practice."
  hideHeader={true}
  hideFooter={true}
>
  <div class="relative min-h-screen">
    
    <!-- Live Background Homepage -->
    <div class="pointer-events-none filter blur-[3px] opacity-60 fixed inset-0 z-0 overflow-hidden">
      <LandingPage client:only="react" />
    </div>

    <!-- Modal Pop-up Container on Top -->
    <div class="relative z-[9999] min-h-screen bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
      <ExpertSignupPortal client:only="react" />
    </div>

  </div>
</Layout>
