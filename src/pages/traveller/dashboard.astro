---
// src/pages/traveller/dashboard.astro
import Layout from '../../layouts/Layout.astro';
import { UserDashboard } from '../../components/interactive/UserDashboard';
---

<Layout 
  title="Traveller Dashboard | TravlTik" 
  description="Manage your travel and visa journey. Check your upcoming sessions, view files in your Document Vault, and track your applications online."
  hideHeader={true}
  hideFooter={true}
>
  <!-- Mount client-only React user dashboard island with instant zero-latency skeleton fallback -->
  <UserDashboard client:only="react">
    <div slot="fallback" class="min-h-screen bg-[#F8FAFC] flex flex-col items-center justify-center p-6 text-center">
      <div class="flex flex-col items-center max-w-sm w-full space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-slate-900 flex items-center justify-center text-white text-xl font-black shadow-md animate-bounce">
          ✈️
        </div>
        <div class="space-y-1.5 w-full">
          <div class="h-4 bg-slate-200 rounded-md w-48 mx-auto animate-pulse"></div>
          <p class="text-xs text-slate-400 font-medium">Loading your visa portal & dashboard...</p>
        </div>
      </div>
    </div>
  </UserDashboard>
</Layout>
