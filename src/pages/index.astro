  { name: "Ananya Patel", visa: "UK Student", quote: "UCL admission + visa in 3 weeks. Incredible support!", image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=200&h=200&fit=crop&crop=face", helpful: 201 },
