---
// src/components/layout/Header.astro
import { Search, MapPin, Menu, X, Globe, ChevronDown, Umbrella, Trophy, Ship, Music, GraduationCap, FileText, Calendar, Briefcase, Compass, Scale, Map, Plane, PenLine, HeartHandshake, Layers, LogOut, LayoutDashboard, DollarSign } from 'lucide-react';
import Logo from '../Logo.astro';


const pathname = Astro.url.pathname;

const tourDropdownItems = [
    { title: "Holiday Packages", desc: "Visa + hotel + itinerary", href: "/tours?category=holiday", icon: Umbrella, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Sport Tours", desc: "Live events + stadium visits", href: "/tours?category=sports", icon: Trophy, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Cruises", desc: "Ocean & river voyages", href: "/tours?category=cruises", icon: Ship, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Entertainment Events", desc: "Concerts, shows & festivals", href: "/tours?category=events", icon: Music, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "E-visas / Visa Free Travel", desc: "Fast-track electronic visas & visa-on-arrival guide templates.", href: "/apply-visa?type=evisa", icon: Plane, iconColor: "text-blue-500", bg: "bg-blue-50" },
    { title: "Custom Tour Packages", desc: "Tailored international itineraries, sports tours & vacation deals.", href: "/tours?category=custom", icon: Compass, iconColor: "text-sky-500", bg: "bg-sky-50" }
];

const eventDropdownItems = [
    { title: "Exhibitions", desc: "Trade shows & expos worldwide", href: "/events/exhibitions", icon: Globe, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Universities Fairs", desc: "Meet top universities directly", href: "/events/university-fairs", icon: GraduationCap, iconColor: "text-red-500", bg: "bg-red-50" }
];

const servicesDropdownItems = [
    { title: "Visa Documentation Filing", desc: "Expert check & filing of files", href: "/visa-documentation", icon: FileText, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Visa Form Filing", desc: "Complete support for application forms", href: "/visa-form-filing", icon: FileText, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "VFS Appointment", desc: "Schedule and slot booking support", href: "/vfs-appointment", icon: Calendar, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Visa Form Fillers", desc: "Error-free application drafting and bio-data sheet execution.", href: "/services/form-fillers", icon: PenLine, iconColor: "text-indigo-500", bg: "bg-indigo-50" },
    { title: "Travel Insurance Providers", desc: "Mandatory international travel health cover and trip insurance.", href: "/services/travel-insurance", icon: HeartHandshake, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Airfares Booking", desc: "Flight itinerary reservations for immigration documentation.", href: "/services/airfares", icon: Plane, iconColor: "text-purple-500", bg: "bg-purple-50" }
];

const expertDropdownItems = [
    { title: "Student Visa Experts", desc: "Top university admission guides", href: "/find-experts?category=student", icon: GraduationCap, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Work & Job Visa Experts", desc: "Work permit & job offer assistance", href: "/find-experts?category=work", icon: Briefcase, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "PR Agencies", desc: "Express Entry & permanent residency", href: "/find-experts?category=pr", icon: Compass, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Tourist Visa Agents", desc: "Visitor visa & holiday packages", href: "/find-experts?category=tourist", icon: Umbrella, iconColor: "text-red-500", bg: "bg-red-50" },
    { title: "Canada Specialists", desc: "Express Entry, PNP & study visas", href: "/find-experts?country=Canada", icon: MapPin, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "US Immigration Lawyers", desc: "H-1B, L-1 & green card advisors", href: "/find-experts?country=USA", icon: Scale, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "UK Consultants", desc: "UK student & work sponsorship visas", href: "/find-experts?country=UK", icon: Map, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Schengen / Europe Experts", desc: "Schengen visitor & European blue cards", href: "/find-experts?country=Schengen", icon: Globe, iconColor: "text-rose-500", bg: "bg-rose-50" }
];

const supportiveServicesItems = [
    { title: "Travel Insurance", desc: "Mandatory international medical & trip cover.", href: "/services/travel-insurance", icon: HeartHandshake, iconColor: "text-rose-500", bg: "bg-rose-50" },
    { title: "Ticket Booking", desc: "Flight itinerary reservations for visa files.", href: "/services/airfares", icon: Plane, iconColor: "text-purple-500", bg: "bg-purple-50" },
    { title: "Language Training", desc: "IELTS coaching & language training classes.", href: "/training", icon: GraduationCap, iconColor: "text-indigo-500", bg: "bg-indigo-50" },
    { title: "Financial Assistance", desc: "Education loan & forex guidance.", href: "/services/financial-assistance", icon: DollarSign, iconColor: "text-emerald-500", bg: "bg-emerald-50" }
];
---

<header id="main-header" class="fixed top-0 left-0 w-full z-50 bg-white shadow-sm transition-all duration-300">
    <div class="max-w-[1440px] mx-auto pl-2 md:pl-4 pr-4 md:pr-6">
        <div class="flex items-center gap-4">
            
            <!-- Logo - left corner, spans full header height -->
            <div class="logo-container flex items-center justify-start shrink-0 py-2">
                <a href="/" class="flex items-center group">
                    <Logo variant="navbar-light" />
                </a>
            </div>

            <!-- Right side: stacks both rows vertically -->
            <div class="flex-1 min-w-0 lg:pl-2">
                <!-- Top Row: Search Bar + Portal Links -->
                <div class="flex items-center justify-between h-16 gap-6 lg:pr-16">
                    


                    <!-- Left-aligned Portal Links (next to search bar) -->
                    <div class="hidden lg:flex items-center gap-8 shrink-0 pl-8 font-opensans">
                        <a href="/self-apply" class="font-opensans top-menu-link text-[15px] font-semibold text-navy hover:text-[#ef4444] transition-all duration-300">
                            Self Apply
                        </a>

                        <!-- Supporting Businesses Dropdown on Top Line -->
                        <div class="relative py-3 group">
                            <button class="font-opensans top-menu-link text-[15px] font-semibold text-navy hover:text-[#ef4444] transition-all duration-300 flex items-center gap-1 focus:outline-none">
                                Supporting Businesses
                                <ChevronDown class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" />
                            </button>

                            <!-- Dropdown Card -->
                            <div class="absolute top-full left-0 pt-2 w-[480px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-left z-50">
                                <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3">
                                    <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                                        {supportiveServicesItems.map((item) => {
                                            const IconComponent = item.icon;
                                            return (
                                                <a 
                                                    href={item.href}
                                                    class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item"
                                                >
                                                    <IconComponent class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" className="w-5 h-5" color="currentColor" />
                                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">{item.title}</span>
                                                </a>
                                            );
                                        })}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Portal Auth Buttons & Profile Block (aligned right) -->
                    <div class="hidden lg:flex items-center gap-4 xl:gap-6 shrink-0">
                        <a href="/support" class="font-opensans top-menu-link text-[15px] font-semibold text-navy hover:text-[#ef4444] transition-all duration-300 animate-fade-in mr-3">
                            Contact
                        </a>

                        <div class="w-[1.5px] h-4 bg-red-500 mr-3"></div>

                        <div class="flex items-center gap-1.5 xl:gap-2" id="nav-auth-buttons-wrapper">
                            <a href="/login" id="login-btn" class="font-opensans text-[14px] font-bold text-navy hover:text-black border border-gray-200 hover:border-black px-4 py-2.5 rounded-xl transition-all duration-300">
                                Log In
                            </a>
                            <a href="/signup" class="font-opensans bg-black hover:bg-slate-900 text-white font-bold text-[14px] px-4 py-2.5 rounded-xl hover:shadow-lg hover:shadow-gray-200 transition-all active:scale-[0.97]">
                                Sign Up
                            </a>
                        </div>

                        <!-- Desktop Profile dropdown -->
                        <div id="nav-profile-block" class="relative hidden py-2 group font-opensans">
                            <button id="nav-profile-trigger" class="flex items-center gap-7 pl-1.5 pr-7 py-1.5 border border-slate-200 hover:border-black rounded-full transition-all focus:outline-none bg-white font-opensans">
                                <div class="w-11 h-11 rounded-full overflow-hidden flex items-center justify-center bg-black text-white shadow-sm" id="nav-profile-avatar-container">
                                    <img id="nav-profile-avatar-img" class="w-full h-full object-cover hidden" src="" alt="avatar" />
                                    <span class="font-bold text-sm" id="nav-profile-avatar-letters">U</span>
                                </div>
                                <ChevronDown class="w-4 h-4 text-slate-500 pr-1.5 shrink-0" />
                            </button>
                            
                            <!-- Dropdown Menu -->
                            <div class="absolute right-0 top-[90%] pt-4 w-[220px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-right z-50">
                                <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-2.5 flex flex-col gap-1.5 font-opensans">
                                    <div class="px-3.5 py-2 border-b border-slate-100">
                                        <div class="text-[10px] text-slate-400 font-bold tracking-wider font-opensans">Signed in as</div>
                                        <div class="text-sm font-bold text-black truncate mt-0.5 font-opensans" id="nav-profile-name">User Profile</div>
                                    </div>
                                    <a id="nav-profile-dashboard-link" href="/dashboard" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-slate-700 hover:text-black hover:bg-slate-50 transition-all font-opensans">
                                        <LayoutDashboard class="w-4 h-4 text-slate-400" />
                                        <span>My Dashboard</span>
                                    </a>
                                    <button id="nav-profile-logout-btn" class="flex items-center gap-2 px-3 py-2 rounded-lg text-[14px] font-semibold text-red-650 hover:bg-red-50 transition-all w-full text-left cursor-pointer border-none bg-transparent font-opensans">
                                        <LogOut class="w-4 h-4 text-slate-450" />
                                        <span>Log Out</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

        <!-- Mobile Menu Toggler -->
        <button id="mobile-menu-btn" class="lg:hidden ml-auto p-2 hover:bg-gray-100 rounded-xl transition-colors">
            <Menu id="menu-icon" class="w-6 h-6 text-navy" />
            <X id="close-icon" class="w-6 h-6 text-navy hidden" />
        </button>
                </div><!-- end top row -->

                <!-- Bottom Row: Category Navigation (Desktop Only) -->
                <div id="category-bar" class="hidden lg:flex items-center justify-start h-12">
                    <div class="flex items-center gap-3.5 xl:gap-8 h-full">
                <!-- Student Visa Dropdown -->
                <div class="relative py-3.5 group">
                    <button
                        class={`font-opensans category-menu-link text-[13px] xl:text-[15px] font-semibold transition-all flex items-center gap-1 whitespace-nowrap group-hover:text-[#ef4444] ${
                            pathname?.startsWith("/training") || pathname?.startsWith("/student") ? "text-[#ef4444]" : "text-navy"
                        }`}
                    >
                        Student Visa
                        <ChevronDown class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" />
                    </button>

                    <!-- Dropdown Card -->
                    <div class="absolute top-full left-0 pt-2 w-[460px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-left z-50">
                        <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-4">
                            <div class="grid grid-cols-2 gap-x-4 gap-y-2">

                                <!-- Find Consultants -->
                                <a href="/find-experts?category=student" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                        <circle cx="12" cy="7" r="4"/>
                                        <polyline points="16 11 18 13 22 9"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Find Consultants</span>
                                </a>

                                 <!-- Find Universities -->
                                <a href="/universities" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                                        <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Find Universities</span>
                                </a>

                                <!-- Admissions by Country -->
                                <a href="/admissions" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <circle cx="12" cy="12" r="10"/>
                                        <line x1="2" y1="12" x2="22" y2="12"/>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Admissions by Country</span>
                                </a>

                                <!-- Funding Assistance -->
                                <a href="/funding" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <rect x="2" y="5" width="20" height="14" rx="2"/>
                                        <line x1="2" y1="10" x2="22" y2="10"/>
                                        <path d="M12 15v-2m0 0V11m0 2h2m-2 0H10"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Funding Assistance</span>
                                </a>

                                <!-- Language Coaching & Training -->
                                <a href="/training" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                                        <line x1="9" y1="9" x2="15" y2="9"/>
                                        <line x1="9" y1="13" x2="13" y2="13"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Language Coaching & Training</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Job Seeker Visas Dropdown -->
                <div class="relative py-3.5 group">
                    <button
                        class={`font-opensans category-menu-link text-[13px] xl:text-[15px] font-semibold transition-all flex items-center gap-1 whitespace-nowrap group-hover:text-[#ef4444] ${
                            pathname?.startsWith("/jobs") ? "text-[#ef4444]" : "text-navy"
                        }`}
                    >
                        Job Visas
                        <ChevronDown class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" />
                    </button>

                    <!-- Dropdown Card -->
                    <div class="absolute top-full right-0 pt-2 w-[260px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-right z-50">
                        <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-4">
                            <div class="flex flex-col gap-2">

                                <!-- Work Permit Consultants -->
                                <a href="/find-experts?category=work" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                                        <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                                        <line x1="12" y1="12" x2="12" y2="12"/>
                                        <path d="M12 12h.01"/>
                                        <path d="M2 12h20"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Work Permit Consultants</span>
                                </a>

                                <!-- Search for Jobs -->
                                <a href="/jobs" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-550" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <circle cx="11" cy="11" r="8"/>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                        <path d="M11 8v6M8 11h6"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Find Jobs</span>
                                </a>

                                <!-- Digital Nomad -->
                                <a href="/digital-nomad" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                                        <line x1="8" y1="21" x2="16" y2="21"/>
                                        <line x1="12" y1="17" x2="12" y2="21"/>
                                        <path d="M2 8h20"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Digital Nomad</span>
                                </a>

                            </div>
                        </div>
                    </div>
                </div>

                <!-- Tourist Visa Dropdown -->
                <div class="relative py-3.5 group">
                    <button
                        class={`font-opensans category-menu-link text-[13px] xl:text-[15px] font-semibold transition-all flex items-center gap-1 whitespace-nowrap group-hover:text-[#ef4444] ${
                            pathname?.startsWith("/tours") ? "text-[#ef4444]" : "text-navy"
                        }`}
                    >
                        Visit Visas
                        <ChevronDown class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" />
                    </button>

                    <!-- Dropdown Menu Card -->
                    <div class="absolute top-full left-0 pt-2 w-[450px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-left z-50">
                        <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-3">
                            <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                                {tourDropdownItems.map((item) => {
                                    const IconComponent = item.icon;
                                    return (
                                        <a 
                                            href={item.href}
                                            class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item"
                                        >
                                            <IconComponent class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" className="w-5 h-5" color="currentColor" />
                                            <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">{item.title}</span>
                                        </a>
                                    );
                                })}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Migration Visas Dropdown -->
                <div class="relative py-3.5 group">
                    <button
                        class={`font-opensans category-menu-link text-[13px] xl:text-[15px] font-semibold transition-all flex items-center gap-1 whitespace-nowrap group-hover:text-[#ef4444] ${
                            pathname?.startsWith("/find-experts?category=pr") || pathname?.startsWith("/find-experts?category=migration") ? "text-[#ef4444]" : "text-navy"
                        }`}
                    >
                        Migration Visas
                        <ChevronDown class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180" />
                    </button>

                    <!-- Dropdown Card -->
                    <div class="absolute top-full right-0 pt-2 w-[260px] opacity-0 scale-95 -translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:scale-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-300 transform origin-top-right z-50">
                        <div class="bg-white rounded-xl border border-slate-100 shadow-xl p-4">
                            <div class="flex flex-col gap-2">

                                 <!-- Skilled Migration -->
                                <a href="/find-experts?category=pr" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
                                    <svg class="w-5 h-5 text-slate-500 shrink-0 transition-colors group-hover/item:text-red-500" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                                        <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                                        <polyline points="17 6 23 6 23 12"/>
                                    </svg>
                                    <span class="text-[14px] font-semibold text-slate-700 transition-colors group-hover/item:text-red-500">Skilled Migration</span>
                                </a>

                                <!-- Residency Visa -->
                                <a href="/find-experts?category=residency" class="flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-slate-50 transition-all duration-150 group/item">
