---
// src/pages/signup/index.astro
import Layout from '../../layouts/Layout.astro';
import LandingPage from '../../components/landing/LandingPage';
import { SignupFlowPortal } from '../../components/interactive/SignupFlowPortal';
---

<Layout 
  title="Join TravlTik" 
  description="Select your role to get started with TravlTik - Register as a Traveller or Service Provider."
  hideHeader={true}
  hideFooter={true}
  hideWidgets={true}
>
  <!-- Live Background Homepage (Blurred & Semi-Transparent) -->
  <div class="pointer-events-none filter blur-[3px] opacity-75 fixed inset-0 z-0 overflow-hidden" aria-hidden="true">
    <LandingPage client:only="react" />
  </div>

  <!-- Fixed Role Selection Modal Overlay -->
  <SignupFlowPortal client:only="react" initialMode="selection" />
</Layout>
