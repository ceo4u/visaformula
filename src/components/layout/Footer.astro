---
// src/components/layout/Footer.astro
import { Shield, Lock, Phone, Mail, MapPin, ChevronRight } from 'lucide-react';

const consultantLinks = [
  { label: "Register as a Consultant", href: "/register-provider" },
  { label: "Consultant Dashboard Login", href: "/consultant/dashboard" },
  { label: "Verification Guidelines", href: "/verification-guidelines" },
  { label: "Success Stories", href: "/success-stories" },
];

const securityLinks = [
  { label: "How Escrow Keeps You Safe", href: "/escrow" },
  { label: "Anti-Fraud Policy", href: "/anti-fraud-policy" },
  { label: "Terms of Marketplace Service", href: "/terms" },
  { label: "Customer Support Helpdesk", href: "/support" },
];

const seekerLinks = [
  { label: "Find Verified Experts", href: "/find-experts" },
  { label: "Apply Visa Online", href: "/apply-visa" },
  { label: "Visa Guides", href: "/visa-guide" },
  { label: "Success Stories", href: "/success-stories" },
];

const companyLinks = [
  { label: "About Us", href: "/about" },
  { label: "Careers", href: "/careers" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="bg-black text-white">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      
      <div>
        <h4 class="font-sora text-[13px] font-bold uppercase tracking-wider text-white mb-4">
          For Consultants
        </h4>
        <ul class="space-y-3">
          {consultantLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-sora text-[13px] font-bold uppercase tracking-wider text-white mb-4">
          Security & Trust
        </h4>
        <ul class="space-y-3">
          {securityLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="mt-4 flex items-center gap-2 text-xs text-gray-500">
          <Lock class="w-4 h-4 text-green-400" />
          <span class="text-xs text-gray-400">100% Escrow Protected</span>
        </div>
      </div>

      <div>
        <h4 class="font-sora text-[13px] font-bold uppercase tracking-wider text-white mb-4">
          For Seekers
        </h4>
        <ul class="space-y-3">
          {seekerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-sora text-[13px] font-bold uppercase tracking-wider text-white mb-4">
          Company
        </h4>
        <ul class="space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="font-sans text-[#94A3B8] hover:text-white text-[14px] transition-colors duration-200 flex items-center gap-2 group"
              >
                <ChevronRight class="w-3 h-3 text-white opacity-0 group-hover:opacity-100 transition-all shrink-0" />
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-[#1E293B]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="flex flex-col gap-2">
          <div class="flex items-center gap-4">
            <Phone class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">+91 98765 43210</span>
          </div>
          <div class="flex items-center gap-4">
            <Mail class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">support@visaformula.com</span>
          </div>
          <div class="flex items-center gap-4">
            <MapPin class="w-4 h-4 text-white shrink-0" />
            <span class="text-gray-300 text-sm font-sans">Hyderabad, India (Global HQ)</span>
          </div>
        </div>
        
        <div class="flex flex-wrap items-center gap-6 md:justify-end">
          <div class="flex items-center gap-2">
            <Lock class="w-4 h-4 text-green-400" />
            <span class="text-xs text-gray-400 font-sans">Escrow Protected</span>
          </div>
          <div class="flex items-center gap-2">
            <Shield class="w-4 h-4 text-green-400" />
            <span class="text-xs text-gray-400 font-sans">KYC Verified</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 text-xs">⭐</span>
            <span class="text-xs text-gray-400 font-sans">4.8/5 TrustScore</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-[#1E293B]">
    <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500 font-sans">
        © 2025 VisaFormula. All rights reserved.
      </p>
      <div class="flex gap-6 text-xs font-sans">
        <a href="/privacy" class="text-gray-500 hover:text-gray-300 transition-colors">
          Privacy Policy
        </a>
        <a href="/terms" class="text-gray-500 hover:text-gray-300 transition-colors">
          Terms of Service
        </a>
        <a href="/cookie" class="text-gray-500 hover:text-gray-300 transition-colors">
          Cookie Policy
        </a>
      </div>
    </div>
  </div>
</footer>
